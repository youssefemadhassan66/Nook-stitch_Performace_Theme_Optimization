      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section style=\"background:#fff; color:#111; padding:60px 20px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial;\">\n  <div style=\"max-width:1100px; margin:0 auto;\">\n    <h2 style=\"color:#000; text-align:center; font-size:30px; font-weight:700; letter-spacing:0.5px; margin-bottom:40px;\">Customer Reviews</h2>\n\n    <div style=\"display:grid; gap:20px; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); justify-items:center;\">\n      \n      <div style=\"background:#f9f9f9; border:1px solid rgba(0,0,0,0.1); border-radius:14px; padding:26px; box-shadow:0 4px 18px rgba(0,0,0,0.05); max-width:320px; width:100%; transition:transform 0.2s;\">\n        <div style=\"color:#000; font-size:20px; letter-spacing:2px;\">★★★★★</div>\n        <p style=\"margin:14px 0; color:#333; line-height:1.6; font-size:15px;\">“Socks arrived on time and in great condition. Will definitely order again.”</p>\n        <div style=\"color:#000; font-weight:600; font-size:14px; text-transform:uppercase; letter-spacing:0.5px;\">Sofia W.</div>\n      </div>\n\n      <div style=\"background:#f9f9f9; border:1px solid rgba(0,0,0,0.1); border-radius:14px; padding:26px; box-shadow:0 4px 18px rgba(0,0,0,0.05); max-width:320px; width:100%; transition:transform 0.2s;\">\n        <div style=\"color:#000; font-size:20px; letter-spacing:2px;\">★★★★★</div>\n        <p style=\"margin:14px 0; color:#333; line-height:1.6; font-size:15px;\">“I’ve loved everything about these socks. Great quality and fast delivery.”</p>\n        <div style=\"color:#000; font-weight:600; font-size:14px; text-transform:uppercase; letter-spacing:0.5px;\">Marta K.</div>\n      </div>\n\n      <div style=\"background:#f9f9f9; border:1px solid rgba(0,0,0,0.1); border-radius:14px; padding:26px; box-shadow:0 4px 18px rgba(0,0,0,0.05); max-width:320px; width:100%; transition:transform 0.2s;\">\n        <div style=\"color:#000; font-size:20px; letter-spacing:2px;\">★★★★★</div>\n        <p style=\"margin:14px 0; color:#333; line-height:1.6; font-size:15px;\">“Support was amazing when I had a small issue. So happy with my experience.”</p>\n        <div style=\"color:#000; font-weight:600; font-size:14px; text-transform:uppercase; letter-spacing:0.5px;\">Sara J.</div>\n      </div>\n\n    </div>\n\n    <div style=\"text-align:center; margin-top:50px;\">\n      <a href=\"https://nookandstitch.com/pages/customer-reviews\" style=\"display:inline-block; color:#fff; background:#000; border:none; padding:14px 36px; border-radius:50px; text-decoration:none; font-weight:600; font-size:15px; letter-spacing:0.5px; transition:0.3s;\">\n        Read More Reviews\n      </a>\n    </div>\n  </div>\n</section>",
