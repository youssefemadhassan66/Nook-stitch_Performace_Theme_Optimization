-icon\" style=\"margin-bottom:12px; transition:all 0.3s ease;\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" />\n      </svg>\n      <p style=\"font-size:15px; font-weight:500; margin:0;\">12-Month Warranty</p>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .guarantee-card:hover {\n    transform: translateY(-6px);\n  }\n\n  .guarantee-card:hover .guarantee-icon {\n    stroke: #c69d2f;\n    transform: scale(1.15);\n    filter: drop-shadow(0 0 6px rgba(198,157,47,0.6));\n  }\n</style>",
