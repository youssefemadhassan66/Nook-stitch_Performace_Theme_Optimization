{% doc %}
  @prompt
    section to add 4-5 images and scrollable horizontally
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scroll-gallery-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-scroll-gallery-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.side_padding }}px;
  }

  .ai-scroll-gallery-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-scroll-gallery-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-scroll-gallery-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: {{ block.settings.scrollbar_style }};
    -webkit-overflow-scrolling: touch;
    padding-bottom: {{ block.settings.scrollbar_padding }}px;
  }

  .ai-scroll-gallery-track-{{ ai_gen_id }}::-webkit-scrollbar {
    height: {{ block.settings.scrollbar_height }}px;
  }

  .ai-scroll-gallery-track-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: {{ block.settings.scrollbar_track_color }};
    border-radius: {{ block.settings.scrollbar_radius }}px;
  }

  .ai-scroll-gallery-track-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: {{ block.settings.scrollbar_thumb_color }};
    border-radius: {{ block.settings.scrollbar_radius }}px;
  }

  .ai-scroll-gallery-track-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
    background: {{ block.settings.scrollbar_thumb_hover_color }};
  }

  .ai-scroll-gallery-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.image_width }}px;
  }

  .ai-scroll-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-scroll-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-scroll-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-scroll-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-scroll-gallery-item-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_mobile }}px;
    }

    .ai-scroll-gallery-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-scroll-gallery-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-scroll-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-scroll-gallery-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-scroll-gallery-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-scroll-gallery-wrapper-{{ ai_gen_id }}">
      <div class="ai-scroll-gallery-track-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'image_' | append: i
            assign image = block.settings[image_key]
          %}

          <div class="ai-scroll-gallery-item-{{ ai_gen_id }}">
            <div class="ai-scroll-gallery-image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image_width }}"
                  height="{{ block.settings.image_height }}"
                  class="ai-scroll-gallery-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-scroll-gallery-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrollable image gallery",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Spacing below heading",
      "default": 24
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Image width (desktop)",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Image height (desktop)",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Image width (mobile)",
      "default": 280
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Image height (mobile)",
      "default": 280
    },
    {
      "type": "range",
      "id": "image_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between images",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Scrollbar"
    },
    {
      "type": "select",
      "id": "scrollbar_style",
      "label": "Scrollbar style",
      "options": [
        {
          "value": "auto",
          "label": "Visible"
        },
        {
          "value": "thin",
          "label": "Thin"
        },
        {
          "value": "none",
          "label": "Hidden"
        }
      ],
      "default": "thin"
    },
    {
      "type": "range",
      "id": "scrollbar_height",
      "min": 4,
      "max": 12,
      "step": 2,
      "unit": "px",
      "label": "Scrollbar height",
      "default": 6
    },
    {
      "type": "range",
      "id": "scrollbar_padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Scrollbar padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "scrollbar_radius",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Scrollbar corner radius",
      "default": 4
    },
    {
      "type": "color",
      "id": "scrollbar_track_color",
      "label": "Scrollbar track color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "scrollbar_thumb_color",
      "label": "Scrollbar thumb color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "scrollbar_thumb_hover_color",
      "label": "Scrollbar thumb hover color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Side padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Scrollable image gallery"
    }
  ]
}
{% endschema %}
