{% if section.blocks.size > 0 %}
  <section class="nook-product-features color-{{ section.settings.color_scheme }} gradient">
    <style>
      #shopify-section-{{ section.id }} .nook-product-features {
        --feature-accent: {{ section.settings.accent_color }};
        --feature-rule: rgba(var(--color-foreground), 0.12);
        --feature-muted: rgba(var(--color-foreground), 0.72);
        background: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      #shopify-section-{{ section.id }} .nook-product-features__inner {
        width: min({{ section.settings.container_width }}px, calc(100% - 40px));
        margin: 0 auto;
      }

      #shopify-section-{{ section.id }} .nook-product-features__heading {
        margin: 0 0 clamp(32px, 4vw, 54px);
        font-family: var(--font-heading-family);
        font-size: clamp(30px, 2.5vw, {{ section.settings.heading_size }}px);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: 0;
        text-align: center;
      }

      #shopify-section-{{ section.id }} .nook-product-features__grid {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
        border-top: 1px solid var(--feature-rule);
        border-bottom: 1px solid var(--feature-rule);
      }

      #shopify-section-{{ section.id }} .nook-product-features__item {
        padding: clamp(28px, 3vw, 48px) clamp(16px, 2.5vw, 38px);
      }

      #shopify-section-{{ section.id }} .nook-product-features__item + .nook-product-features__item {
        border-left: 1px solid var(--feature-rule);
      }

      #shopify-section-{{ section.id }} .nook-product-features__icon {
        width: {{ section.settings.icon_size }}px;
        height: {{ section.settings.icon_size }}px;
        margin: 0 0 28px;
        color: rgb(var(--color-foreground));
      }

      #shopify-section-{{ section.id }} .nook-product-features__icon img,
      #shopify-section-{{ section.id }} .nook-product-features__icon svg {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      #shopify-section-{{ section.id }} .nook-product-features__icon svg path {
        fill: currentColor;
      }

      #shopify-section-{{ section.id }} .nook-product-features__title {
        margin: 0 0 12px;
        font-family: var(--font-heading-family);
        font-size: clamp(20px, 1.55vw, {{ section.settings.title_size }}px);
        font-weight: 600;
        line-height: 1.18;
        letter-spacing: 0;
      }

      #shopify-section-{{ section.id }} .nook-product-features__text {
        max-width: 31ch;
        margin: 0;
        color: var(--feature-muted);
        font-family: var(--font-body-family);
        font-size: {{ section.settings.text_size }}px;
        line-height: 1.55;
      }

      @media screen and (max-width: 989px) {
        #shopify-section-{{ section.id }} .nook-product-features__grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        #shopify-section-{{ section.id }} .nook-product-features__item + .nook-product-features__item {
          border-left: 0;
        }

        #shopify-section-{{ section.id }} .nook-product-features__item:nth-child(even) {
          border-left: 1px solid var(--feature-rule);
        }

        #shopify-section-{{ section.id }} .nook-product-features__item:nth-child(n + 3) {
          border-top: 1px solid var(--feature-rule);
        }
      }

      @media screen and (max-width: 640px) {
        #shopify-section-{{ section.id }} .nook-product-features {
          padding-top: {{ section.settings.padding_top_mobile }}px;
          padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        }

        #shopify-section-{{ section.id }} .nook-product-features__inner {
          width: min(100% - 32px, {{ section.settings.container_width }}px);
        }

        #shopify-section-{{ section.id }} .nook-product-features__heading {
          margin-bottom: 28px;
          text-align: left;
        }

        #shopify-section-{{ section.id }} .nook-product-features__grid {
          grid-template-columns: 1fr;
        }

        #shopify-section-{{ section.id }} .nook-product-features__item,
        #shopify-section-{{ section.id }} .nook-product-features__item:nth-child(even) {
          border-left: 0;
        }

        #shopify-section-{{ section.id }} .nook-product-features__item + .nook-product-features__item,
        #shopify-section-{{ section.id }} .nook-product-features__item:nth-child(n + 3) {
          border-top: 1px solid var(--feature-rule);
        }

        #shopify-section-{{ section.id }} .nook-product-features__item {
          display: grid;
          grid-template-columns: 54px 1fr;
          column-gap: 20px;
          padding: 24px 0;
        }

        #shopify-section-{{ section.id }} .nook-product-features__icon {
          width: 48px;
          height: 48px;
          margin: 0;
          grid-row: span 2;
        }

        #shopify-section-{{ section.id }} .nook-product-features__title {
          margin-bottom: 8px;
        }
      }
    </style>

    <div class="nook-product-features__inner">
      {% if section.settings.heading != blank %}
        <h2 class="nook-product-features__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="nook-product-features__grid">
        {% for block in section.blocks %}
          <article class="nook-product-features__item" {{ block.shopify_attributes }}>
            <div class="nook-product-features__icon" aria-hidden="true">
              {% if block.settings.custom_icon != blank %}
                {{
                  block.settings.custom_icon
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', alt: '', class: 'nook-product-features__custom-icon'
                }}
              {% else %}
                {% case block.settings.icon %}
                  {% when 'drynamix' %}
                    <img src="{{ 'product-feature-drynamix.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy">
                  {% when 'seamless_toe' %}
                    <img src="{{ 'product-feature-seamless-toe.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy">
                  {% when 'ventilation_panels' %}
                    <img src="{{ 'product-feature-ventilation-panels.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy">
                  {% when 'heel_pocket' %}
                    {% render 'icon-accordion', icon: 'shoe' %}
                {% endcase %}
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3 class="nook-product-features__title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="nook-product-features__text">{{ block.settings.text }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product feature icons",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Features"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#157A5B"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 960,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "label": "Container width",
      "default": 1340
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 52,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 18,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Feature title size",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Feature text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 44,
      "max": 76,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "drynamix",
              "label": "Drynamix"
            },
            {
              "value": "seamless_toe",
              "label": "Seamless toe"
            },
            {
              "value": "ventilation_panels",
              "label": "Ventilation panels"
            },
            {
              "value": "heel_pocket",
              "label": "Heel pocket"
            }
          ],
          "default": "drynamix"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Short feature detail."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product feature icons",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "drynamix",
            "title": "Drynamix&trade; Yarn",
            "text": "Built-in moisture management keeps feet cool and dry for the life of the sock."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "seamless_toe",
            "title": "Seamless Construction",
            "text": "Minimizes excess material inside the socks, reducing friction, irritation, and bunching."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "ventilation_panels",
            "title": "Ventilation Panels",
            "text": "Lets hot air escape, helping feet stay cool and comfortable."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "heel_pocket",
            "title": "Extra Deep Heel Pocket",
            "text": "Helps keep the sock in place so it does not slip inside the shoe."
          }
        }
      ]
    }
  ]
}
{% endschema %}
