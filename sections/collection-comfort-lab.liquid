{%- liquid
  assign s = section.settings
  assign primary_image_alt = s.primary_image_alt | default: s.heading
  assign product_link = s.button_link | default: collection.url | default: routes.all_products_collection_url
  assign secondary_link = s.secondary_button_link | default: product_link
-%}

<section
  class="collection-comfort-lab color-{{ s.color_scheme }} gradient"
  style="
    --ccl-bg: {{ s.background_color }};
    --ccl-surface: {{ s.surface_color }};
    --ccl-surface-strong: {{ s.surface_strong_color }};
    --ccl-ink: {{ s.text_color }};
    --ccl-muted: {{ s.muted_color }};
    --ccl-accent: {{ s.accent_color }};
    --ccl-padding-top: {{ s.padding_top }}px;
    --ccl-padding-bottom: {{ s.padding_bottom }}px;
  "
  data-collection-comfort-lab="{{ section.id }}"
>
  <div class="page-width collection-comfort-lab__inner">
    <div class="collection-comfort-lab__copy" data-ccl-reveal>
      {%- if s.kicker != blank -%}
        <p class="collection-comfort-lab__kicker">{{ s.kicker | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="collection-comfort-lab__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.body != blank -%}
        <div class="collection-comfort-lab__body rte">{{ s.body }}</div>
      {%- endif -%}

      <div class="collection-comfort-lab__actions">
        {%- if s.button_label != blank -%}
          <a class="collection-comfort-lab__button" href="{{ product_link }}">
            <span>{{ s.button_label | escape }}</span>
            <span class="collection-comfort-lab__button-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false" role="presentation">
                <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

        {%- if s.secondary_button_label != blank -%}
          <a class="collection-comfort-lab__text-link" href="{{ secondary_link }}">
            {{ s.secondary_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="collection-comfort-lab__stage-wrap" data-ccl-reveal>
      <div class="collection-comfort-lab__stage" aria-label="{{ primary_image_alt | escape }}">
        <span class="collection-comfort-lab__soft-plate" aria-hidden="true"></span>
        <span class="collection-comfort-lab__orbit collection-comfort-lab__orbit--one" aria-hidden="true"></span>
        <span class="collection-comfort-lab__orbit collection-comfort-lab__orbit--two" aria-hidden="true"></span>

        <div class="collection-comfort-lab__image-shell">
          <div class="collection-comfort-lab__image-core">
            {%- if s.primary_image != blank -%}
              {{
                s.primary_image
                | image_url: width: 1300
                | image_tag:
                  loading: 'eager',
                  widths: '420, 620, 820, 1000, 1300',
                  sizes: '(min-width: 990px) 44vw, 86vw',
                  alt: primary_image_alt,
                  class: 'collection-comfort-lab__product-image'
              }}
            {%- else -%}
              <img
                class="collection-comfort-lab__product-image"
                src="{{ 'support-zones-sock.png' | asset_url }}"
                alt="{{ primary_image_alt | escape }}"
                width="1254"
                height="1254"
                loading="eager"
              >
            {%- endif -%}
          </div>
        </div>

        <div class="collection-comfort-lab__proof collection-comfort-lab__proof--support">
          <span>{{ s.proof_1_number | escape }}</span>
          <small>{{ s.proof_1_label | escape }}</small>
        </div>

        <div class="collection-comfort-lab__proof collection-comfort-lab__proof--feel">
          <span>{{ s.proof_2_number | escape }}</span>
          <small>{{ s.proof_2_label | escape }}</small>
        </div>
      </div>
    </div>

    <div class="collection-comfort-lab__bento" data-ccl-reveal>
      <article class="collection-comfort-lab__card collection-comfort-lab__card--wide">
        <div class="collection-comfort-lab__card-core">
          <span class="collection-comfort-lab__card-mark" aria-hidden="true"></span>
          <h3>{{ s.card_1_heading | escape }}</h3>
          <p>{{ s.card_1_text | escape }}</p>
        </div>
      </article>

      <article class="collection-comfort-lab__card">
        <div class="collection-comfort-lab__card-core">
          <h3>{{ s.card_2_heading | escape }}</h3>
          <p>{{ s.card_2_text | escape }}</p>
          <div class="collection-comfort-lab__mini-row" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>
      </article>

      <article class="collection-comfort-lab__card collection-comfort-lab__card--image">
        <div class="collection-comfort-lab__card-core">
          <div class="collection-comfort-lab__swatch-stack" aria-hidden="true">
            {%- if s.swatch_image_1 != blank -%}
              {{ s.swatch_image_1 | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', sizes: '140px', alt: '', class: 'collection-comfort-lab__swatch-image' }}
            {%- else -%}
              <img class="collection-comfort-lab__swatch-image" src="{{ 'arrival-sock-white.png' | asset_url }}" alt="" loading="lazy" width="900" height="900">
            {%- endif -%}
            {%- if s.swatch_image_2 != blank -%}
              {{ s.swatch_image_2 | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', sizes: '140px', alt: '', class: 'collection-comfort-lab__swatch-image' }}
            {%- else -%}
              <img class="collection-comfort-lab__swatch-image" src="{{ 'arrival-sock-black.png' | asset_url }}" alt="" loading="lazy" width="900" height="900">
            {%- endif -%}
            {%- if s.swatch_image_3 != blank -%}
              {{ s.swatch_image_3 | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', sizes: '140px', alt: '', class: 'collection-comfort-lab__swatch-image' }}
            {%- else -%}
              <img class="collection-comfort-lab__swatch-image" src="{{ 'arrival-sock-blue.png' | asset_url }}" alt="" loading="lazy" width="900" height="900">
            {%- endif -%}
          </div>
          <h3>{{ s.card_3_heading | escape }}</h3>
          <p>{{ s.card_3_text | escape }}</p>
        </div>
      </article>

      <article class="collection-comfort-lab__card collection-comfort-lab__card--accent">
        <div class="collection-comfort-lab__card-core">
          <h3>{{ s.card_4_heading | escape }}</h3>
          <p>{{ s.card_4_text | escape }}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-collection-comfort-lab="{{ section.id }}"]');
    if (!root || root.dataset.cclReady === 'true') return;
    root.dataset.cclReady = 'true';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-visible');
      return;
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          root.classList.add('is-visible');
          observer.unobserve(root);
        });
      }, { threshold: 0.18 });

      observer.observe(root);
    } else {
      root.classList.add('is-visible');
    }
  })();
</script>

{% stylesheet %}
  .collection-comfort-lab {
    overflow: hidden;
    padding-block: var(--ccl-padding-top, 96px) var(--ccl-padding-bottom, 96px);
    background:
      radial-gradient(circle at 18% 16%, color-mix(in srgb, var(--ccl-accent, #157A5B) 16%, transparent) 0 18rem, transparent 36rem),
      linear-gradient(145deg, color-mix(in srgb, var(--ccl-surface, #FFFFFF) 72%, var(--ccl-bg, #FFFFFF)) 0%, var(--ccl-bg, #FFFFFF) 58%);
    color: var(--ccl-ink, rgb(var(--color-foreground)));
    scroll-margin-top: 96px;
  }

  .collection-comfort-lab__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(34rem, 1fr);
    grid-template-areas:
      "copy stage"
      "bento stage";
    gap: clamp(2.8rem, 2vw + 2rem, 5.6rem);
    align-items: center;
  }

  .collection-comfort-lab__copy {
    grid-area: copy;
    max-width: 62rem;
  }

  .collection-comfort-lab__kicker {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    margin: 0 0 1.8rem;
    padding: 0.2rem 1.3rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ccl-accent, #157A5B) 13%, var(--ccl-surface, #FFFFFF));
    color: var(--ccl-ink, #1F1D24);
    font-family: var(--font-heading-family);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .collection-comfort-lab__heading {
    max-width: 10.8em;
    margin: 0;
    color: var(--ccl-ink, #1F1D24);
    font-family: var(--font-heading-family);
    font-size: clamp(3.9rem, 5.1vw, 7rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 0.96;
    text-wrap: balance;
  }

  .collection-comfort-lab__body {
    max-width: 62ch;
    margin-top: 2rem;
    color: color-mix(in srgb, var(--ccl-ink, #1F1D24) 74%, transparent);
    font-size: clamp(1.7rem, 1.45rem + 0.45vw, 2rem);
    line-height: 1.58;
  }

  .collection-comfort-lab__body > :first-child { margin-top: 0; }
  .collection-comfort-lab__body > :last-child { margin-bottom: 0; }

  .collection-comfort-lab__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 1.8rem;
    align-items: center;
    margin-top: 3.2rem;
  }

  .collection-comfort-lab__button {
    display: inline-flex;
    min-height: 5.4rem;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 0.7rem 0.8rem 0.7rem 2.4rem;
    border: 1px solid color-mix(in srgb, var(--ccl-ink, #1F1D24) 92%, transparent);
    border-radius: 999px;
    background: var(--ccl-ink, #1F1D24);
    color: var(--ccl-bg, #FFFFFF);
    font-family: var(--font-heading-family);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform 520ms cubic-bezier(0.32, 0.72, 0, 1), box-shadow 520ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .collection-comfort-lab__button:hover {
    transform: translateY(-0.2rem);
    box-shadow: 0 2.4rem 4rem -3.2rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 58%, transparent);
  }

  .collection-comfort-lab__button:active {
    transform: translateY(0) scale(0.985);
  }

  .collection-comfort-lab__button-icon {
    display: inline-flex;
    width: 4rem;
    height: 4rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ccl-bg, #FFFFFF) 14%, transparent);
    transition: transform 520ms cubic-bezier(0.32, 0.72, 0, 1), background 520ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .collection-comfort-lab__button:hover .collection-comfort-lab__button-icon {
    transform: translate(0.2rem, -0.1rem) scale(1.04);
    background: color-mix(in srgb, var(--ccl-bg, #FFFFFF) 22%, transparent);
  }

  .collection-comfort-lab__button-icon svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .collection-comfort-lab__text-link {
    display: inline-flex;
    min-height: 4.8rem;
    align-items: center;
    color: var(--ccl-ink, #1F1D24);
    font-family: var(--font-heading-family);
    font-size: 1.42rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ccl-accent, #157A5B) 70%, transparent);
    text-decoration-thickness: 0.2rem;
    text-underline-offset: 0.45rem;
  }

  .collection-comfort-lab__button:focus-visible,
  .collection-comfort-lab__text-link:focus-visible,
  .collection-comfort-lab__card:focus-within {
    outline: 3px solid color-mix(in srgb, var(--ccl-accent, #157A5B) 72%, white);
    outline-offset: 4px;
  }

  .collection-comfort-lab__stage-wrap {
    grid-area: stage;
    min-width: 0;
  }

  .collection-comfort-lab__stage {
    position: relative;
    min-height: clamp(46rem, 56vw, 74rem);
    isolation: isolate;
  }

  .collection-comfort-lab__soft-plate {
    position: absolute;
    inset: 9% 4% 6% 12%;
    z-index: 0;
    border-radius: 3.2rem;
    background:
      radial-gradient(circle at 50% 24%, color-mix(in srgb, var(--ccl-accent, #157A5B) 18%, transparent), transparent 48%),
      color-mix(in srgb, var(--ccl-surface, #FFFFFF) 76%, var(--ccl-bg, #FFFFFF));
    box-shadow:
      inset 0 0.1rem 0 rgba(255, 255, 255, 0.72),
      0 4.2rem 9rem -7rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 58%, transparent);
    transform: rotate(-3deg);
  }

  .collection-comfort-lab__orbit {
    position: absolute;
    z-index: 1;
    border: 1px solid color-mix(in srgb, var(--ccl-accent, #157A5B) 28%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .collection-comfort-lab__orbit--one {
    top: 8%;
    left: 9%;
    width: 19rem;
    height: 19rem;
  }

  .collection-comfort-lab__orbit--two {
    right: 4%;
    bottom: 13%;
    width: 13rem;
    height: 13rem;
  }

  .collection-comfort-lab__image-shell {
    position: absolute;
    inset: 7% 11% 12% 8%;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--ccl-ink, #1F1D24) 8%, transparent);
    border-radius: 3.2rem;
    background: color-mix(in srgb, var(--ccl-surface, #FFFFFF) 54%, transparent);
    box-shadow: 0 3.8rem 8rem -6.4rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 64%, transparent);
  }

  .collection-comfort-lab__image-core {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow: hidden;
    border-radius: 2.4rem;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.24)),
      color-mix(in srgb, var(--ccl-accent, #157A5B) 8%, var(--ccl-surface, #FFFFFF));
    box-shadow: inset 0 0.1rem 0 rgba(255, 255, 255, 0.9);
  }

  .collection-comfort-lab__image-core::after {
    content: "";
    position: absolute;
    inset: auto 16% 10%;
    height: 10%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ccl-ink, #1F1D24) 18%, transparent);
    filter: blur(18px);
    transform: scaleX(0.82);
  }

  .collection-comfort-lab__product-image {
    position: relative;
    z-index: 1;
    width: min(78%, 52rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 3.2rem 2.8rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 20%, transparent));
    transform: rotate(-9deg);
    animation: collection-comfort-lab-float 7s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .collection-comfort-lab__proof {
    position: absolute;
    z-index: 3;
    display: grid;
    gap: 0.2rem;
    min-width: 12.8rem;
    padding: 1.4rem 1.6rem;
    border: 1px solid color-mix(in srgb, var(--ccl-ink, #1F1D24) 8%, transparent);
    border-radius: 1.4rem;
    background: color-mix(in srgb, var(--ccl-surface, #FFFFFF) 92%, transparent);
    color: var(--ccl-ink, #1F1D24);
    box-shadow: 0 2.4rem 5rem -4rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 54%, transparent);
  }

  .collection-comfort-lab__proof--support {
    top: 13%;
    right: 0;
  }

  .collection-comfort-lab__proof--feel {
    left: 3%;
    bottom: 12%;
  }

  .collection-comfort-lab__proof span {
    color: var(--ccl-accent, #157A5B);
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 2vw, 3.7rem);
    font-weight: 800;
    line-height: 0.95;
  }

  .collection-comfort-lab__proof small {
    max-width: 13ch;
    color: color-mix(in srgb, var(--ccl-ink, #1F1D24) 72%, transparent);
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.22;
    text-transform: uppercase;
  }

  .collection-comfort-lab__bento {
    grid-area: bento;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1.4rem;
  }

  .collection-comfort-lab__card {
    min-width: 0;
    padding: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--ccl-ink, #1F1D24) 8%, transparent);
    border-radius: 2rem;
    background: color-mix(in srgb, var(--ccl-surface, #FFFFFF) 62%, transparent);
    box-shadow: 0 2.2rem 5rem -4.8rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 50%, transparent);
    transition: transform 520ms cubic-bezier(0.32, 0.72, 0, 1), box-shadow 520ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .collection-comfort-lab__card:hover {
    transform: translateY(-0.45rem);
    box-shadow: 0 3.2rem 6rem -5rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 62%, transparent);
  }

  .collection-comfort-lab__card--wide {
    grid-column: span 2;
  }

  .collection-comfort-lab__card-core {
    display: grid;
    min-height: 100%;
    gap: 1rem;
    padding: clamp(1.8rem, 1.4rem + 1vw, 2.6rem);
    border-radius: 1.45rem;
    background: var(--ccl-surface, #FFFFFF);
    box-shadow: inset 0 0.1rem 0 rgba(255, 255, 255, 0.86);
  }

  .collection-comfort-lab__card h3 {
    max-width: 12em;
    margin: 0;
    color: var(--ccl-ink, #1F1D24);
    font-family: var(--font-heading-family);
    font-size: clamp(1.9rem, 1.55rem + 0.7vw, 2.7rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .collection-comfort-lab__card p {
    max-width: 48ch;
    margin: 0;
    color: var(--ccl-muted, color-mix(in srgb, var(--ccl-ink, #1F1D24) 68%, transparent));
    font-size: 1.5rem;
    line-height: 1.48;
  }

  .collection-comfort-lab__card-mark {
    width: 6rem;
    height: 0.7rem;
    border-radius: 999px;
    background:
      linear-gradient(90deg, var(--ccl-accent, #157A5B) 0 44%, color-mix(in srgb, var(--ccl-accent, #157A5B) 18%, transparent) 44% 100%);
  }

  .collection-comfort-lab__mini-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
  }

  .collection-comfort-lab__mini-row span {
    display: block;
    width: 3.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ccl-accent, #157A5B) 24%, var(--ccl-bg, #FFFFFF));
  }

  .collection-comfort-lab__mini-row span:nth-child(2) { width: 5.6rem; }
  .collection-comfort-lab__mini-row span:nth-child(3) { width: 2.8rem; }

  .collection-comfort-lab__card--image .collection-comfort-lab__card-core {
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 14%, color-mix(in srgb, var(--ccl-accent, #157A5B) 13%, transparent), transparent 42%),
      var(--ccl-surface, #FFFFFF);
  }

  .collection-comfort-lab__swatch-stack {
    position: relative;
    min-height: 12rem;
    margin-bottom: 0.4rem;
  }

  .collection-comfort-lab__swatch-image {
    position: absolute;
    top: 0.2rem;
    width: 10rem;
    height: 10rem;
    object-fit: contain;
    filter: drop-shadow(0 1.6rem 1.4rem color-mix(in srgb, var(--ccl-ink, #1F1D24) 14%, transparent));
  }

  .collection-comfort-lab__swatch-image:nth-child(1) {
    left: 0;
    transform: rotate(-9deg);
  }

  .collection-comfort-lab__swatch-image:nth-child(2) {
    left: 5.2rem;
    transform: rotate(5deg);
  }

  .collection-comfort-lab__swatch-image:nth-child(3) {
    left: 10.4rem;
    transform: rotate(13deg);
  }

  .collection-comfort-lab__card--accent .collection-comfort-lab__card-core {
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--ccl-accent, #157A5B) 78%, white), var(--ccl-accent, #157A5B));
  }

  .collection-comfort-lab__card--accent h3,
  .collection-comfort-lab__card--accent p {
    color: var(--ccl-ink, #1F1D24);
  }

  [data-ccl-reveal] {
    opacity: 1;
    transform: translateY(0);
  }

  .collection-comfort-lab:not(.is-visible) [data-ccl-reveal] {
    opacity: 0;
    transform: translateY(2.2rem);
  }

  .collection-comfort-lab.is-visible [data-ccl-reveal] {
    transition:
      opacity 820ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 820ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-comfort-lab.is-visible [data-ccl-reveal]:nth-child(2) { transition-delay: 90ms; }
  .collection-comfort-lab.is-visible [data-ccl-reveal]:nth-child(3) { transition-delay: 170ms; }

  @keyframes collection-comfort-lab-float {
    0%, 100% { transform: translateY(0) rotate(-9deg); }
    50% { transform: translateY(-1.2rem) rotate(-6deg); }
  }

  @media screen and (max-width: 989px) {
    .collection-comfort-lab {
      padding-block: calc(var(--ccl-padding-top, 96px) * 0.78) calc(var(--ccl-padding-bottom, 96px) * 0.82);
    }

    .collection-comfort-lab__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "stage"
        "bento";
    }

    .collection-comfort-lab__copy {
      max-width: 76rem;
    }

    .collection-comfort-lab__heading {
      max-width: 11em;
      font-size: clamp(3.5rem, 8vw, 5.6rem);
    }

    .collection-comfort-lab__stage {
      min-height: clamp(42rem, 76vw, 62rem);
    }
  }

  @media screen and (max-width: 749px) {
    .collection-comfort-lab {
      padding-block: calc(var(--ccl-padding-top, 96px) * 0.62) calc(var(--ccl-padding-bottom, 96px) * 0.68);
    }

    .collection-comfort-lab__inner {
      gap: 2.8rem;
    }

    .collection-comfort-lab__heading {
      font-size: clamp(3.2rem, 10vw, 4.3rem);
      line-height: 1.02;
    }

    .collection-comfort-lab__body {
      font-size: 1.62rem;
    }

    .collection-comfort-lab__actions {
      align-items: stretch;
    }

    .collection-comfort-lab__button,
    .collection-comfort-lab__text-link {
      width: 100%;
      justify-content: center;
    }

    .collection-comfort-lab__stage {
      min-height: 42rem;
    }

    .collection-comfort-lab__soft-plate {
      inset: 8% 0 7% 0;
      border-radius: 2.4rem;
      transform: rotate(-2deg);
    }

    .collection-comfort-lab__image-shell {
      inset: 8% 3% 13%;
      border-radius: 2.4rem;
    }

    .collection-comfort-lab__image-core {
      border-radius: 1.8rem;
    }

    .collection-comfort-lab__product-image {
      width: min(82%, 34rem);
    }

    .collection-comfort-lab__proof {
      min-width: 10.8rem;
      padding: 1.1rem 1.2rem;
    }

    .collection-comfort-lab__proof--support {
      top: 3%;
      right: 4%;
    }

    .collection-comfort-lab__proof--feel {
      left: 4%;
      bottom: 3%;
    }

    .collection-comfort-lab__proof small {
      font-size: 1.05rem;
    }

    .collection-comfort-lab__bento {
      grid-template-columns: 1fr;
    }

    .collection-comfort-lab__card--wide {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-comfort-lab *,
    .collection-comfort-lab *::before,
    .collection-comfort-lab *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }

    .collection-comfort-lab:not(.is-visible) [data-ccl-reveal] {
      opacity: 1;
      transform: none;
    }

    .collection-comfort-lab__product-image {
      animation: none;
    }
  }
{% endstylesheet %}

