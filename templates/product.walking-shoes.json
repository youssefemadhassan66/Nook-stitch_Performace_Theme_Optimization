    "custom_liquid_7RqYxa": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"eu-reviews-section\">\n  <style>\n    .eu-reviews-section { background:#f7fafc; padding:48px 0; font-family:-apple-system, BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial; }\n    .eu-reviews-container{ max-width:1100px; margin:0 auto; padding:0 20px; }\n    .eu-reviews-header{ text-align:center; margin-bottom:28px; }\n    .eu-reviews-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; }\n    .eu-review-card{ background:#fff; border-radius:18px; padding:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); display:flex; flex-direction:column; min-height:160px; }\n    .eu-review-top{ display:flex; align-items:center; margin-bottom:10px; }\n    .eu-avatar{ width:44px; height:44px; border-radius:50%; background:#e6e6e6; display:flex; align-items:center; justify-content:center; font-weight:700; color:#374151; margin-right:12px; }\n    .eu-review-name{ font-weight:600; margin:0; }\n    .eu-verified{ font-size:13px; color:#6b7280; margin:0; }\n    .eu-stars{ display:flex; gap:4px; margin-bottom:8px; }\n    .eu-review-text{ color:#374151; margin-top:auto; }\n    .eu-star-filled{ fill:#000000; }\n    .eu-star-empty{ fill:#E5E7EB; }\n    .eu-loadmore-wrap{ text-align:center; margin-top:30px; }\n    .eu-loadmore-btn{ background:#111827; color:#fff; padding:12px 22px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-loadmore-btn:hover{ background:#374151; }\n    .eu-write-review{ margin-top:50px; padding:28px; background:#fff; border-radius:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); }\n    .eu-write-review h3{ margin:0 0 14px; font-size:22px; }\n    .eu-write-review input, .eu-write-review textarea, .eu-write-review select { width:100%; padding:10px; margin-bottom:12px; border:1px solid #d1d5db; border-radius:8px; }\n    .eu-write-review button{ background:#111827; color:#fff; padding:12px 20px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-write-review button:hover{ background:#374151; }\n  </style>\n\n  <div class=\"eu-reviews-container\">\n    <div class=\"eu-reviews-header\">\n      <h2 style=\"font-size:28px; margin:0 0 6px;\">Customer Reviews</h2>\n      <p style=\"color:#6b7280; margin:0;\">Rated <strong>4.8/5</strong> by 1,356 customers</p>\n    </div>\n\n    {% assign reviews = \"\nJohn Peterson|5|These shoes changed my daily walks. No more pain in my knees or back.;\nMark Thompson|5|Perfect fit. Very light and easy to slip on.;\nRichard Evans|4|Great comfort, though delivery took a few days longer than expected.;\nDavid Moore|5|I have wide feet and these shoes fit perfectly. Great design.;\nAlan Foster|5|Fantastic quality and support. I wear them all day for work.;\nPaul Harrison|5|Good quality and comfortable overall;\nTom Rogers|4|Very comfortable. Wish they had more color options.;\nGeorge Collins|5|Non-slip sole works perfectly. Great for outdoor walks.;\nKevin Brooks|5|Excellent cushioning and arch support. I already bought another pair.;\nBrian Davis|5|They look great and feel even better. Lightweight and supportive.;\nSteven Adams|5|Doctor recommended orthopedic shoes and these are the best.;\nRobert Wilson|5|The best shoes I have owned in years. Super easy to wear.;\nMichael Cooper|4|Comfortable and soft inside. Could use more ankle padding.;\nJames Miller|5|Exactly as described. I can walk all day now without discomfort.;\nCharles Turner|5|Fantastic grip and lightweight feel. My daily go-to shoes.;\nHarry Roberts|5|Perfect shoes for travel. No sore feet at the end of the day.;\nPatrick Lewis|4|Good quality shoes. Took a day to adjust but very comfortable now.;\nWilliam Brown|5|I suffer from plantar fasciitis and these shoes really help.;\nAndrew Clark|5|Soft insole and strong sole. Walking feels effortless.;\nThomas Hill|5|I wear them every day at work. Still feel brand new.;\nJason Reed|5|Slip-on feature is very handy. Easy to put on and off.;\nMatthew Walker|5|Light, comfortable, and breathable. Excellent shoes.;\nSimon King|4|Good support overall. Would like a darker color option.;\nEthan Hughes|5|Bought for my dad. He says they are the most comfortable ever.;\nLiam Morgan|5|Stylish and supportive. Great for everyday wear.;\nAdam Scott|5|Amazing fit. No pressure on toes or heels.;\nOwen Ward|5|Perfect balance of comfort and support. Highly recommend.;\nNathan Bell|4|Comfortable and durable. Delivery was a bit slow.;\nJacob Howard|5|My back pain is gone since I started wearing these.;\nRyan Foster|5|Very comfortable shoes. Perfect for long walks.;\nBen Carter|5|Excellent for walking and hiking. Great grip.;\nLeo Campbell|5|Breathable and lightweight. Great for daily use.;\nNoah Stewart|5|Perfect fit and very supportive.;\nDaniel Perry|5|I stand all day at work. These keep my feet pain-free.;\nChris Allen|5|Stylish and functional. Go well with jeans or joggers.;\nTyler Jenkins|4|Good comfort level. Would like a thicker sole.;\nBradley Gray|5|Great cushioning. My feet feel relaxed all day.;\nDylan Cooper|5|Comfortable even after hours of walking.;\nAaron Hughes|5|Good quality shoes. No more sore feet.;\nJamie Edwards|5|Excellent grip. Safe on wet floors too.;\nScott Bennett|4|Comfortable and supportive. Fast delivery.;\nLouis Murphy|5|I wear them every day. Very soft inside.;\nConnor Davis|5|Best walking shoes I have ever owned.;\nBrandon Phillips|5|My knee pain disappeared. Very pleased.;\nAustin Parker|5|Good for wide feet. Easy to clean.;\nShane Mitchell|5|Perfect fit and great cushioning.;\nEric Sanders|5|Bought for my dad. He loves them.;\nCameron Price|5|Very comfortable shoes. Highly recommend.;\nDominic Russell|4|Good quality but wish there were more colors.;\nCaleb Knight|5|Supportive and stylish. Excellent purchase.;\nAnthony Brooks|5|Very light and easy to wear.;\nJustin Ford|4|Good shoes. Comfortable and well made.;\nMason Lee|5|Perfect comfort. Worth it.;\n\" | split: \";\" %}\n\n    <div id=\"eu-reviews-grid\" class=\"eu-reviews-grid\">\n      {% for r in reviews %}\n        {% assign parts = r | split: \"|\" %}\n        {% assign name = parts[0] | strip %}\n        {% assign rating = parts[1] | strip | plus: 0 %}\n        {% assign text = parts[2] | strip %}\n        {% if name != \"\" %}\n        <article class=\"eu-review-card\" style=\"display:none;\">\n          <div class=\"eu-review-top\">\n            <div class=\"eu-avatar\">{{ name | slice: 0, 1 }}</div>\n            <div>\n              <p class=\"eu-review-name\">{{ name }}</p>\n              <p class=\"eu-verified\">Verified Buyer</p>\n            </div>\n          </div>\n          <div class=\"eu-stars\">\n            {% for i in (1..5) %}\n              {% if i <= rating %}\n                <svg class=\"eu-star-filled\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% else %}\n                <svg class=\"eu-star-empty\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% endif %}\n            {% endfor %}\n          </div>\n          <p class=\"eu-review-text\">“{{ text }}”</p>\n        </article>\n        {% endif %}\n      {% endfor %}\n    </div>\n\n    <div class=\"eu-loadmore-wrap\">\n      <button id=\"eu-loadmore-btn\" class=\"eu-loadmore-btn\">Load More Reviews</button>\n    </div>\n\n    <div class=\"eu-write-review\">\n      <h3>Write a Review</h3>\n      <form id=\"review-form\">\n        <input type=\"text\" name=\"name\" placeholder=\"Your Name\" required>\n        <select name=\"rating\" required>\n          <option value=\"\">Rating</option>\n          <option value=\"5\">★★★★★ - Excellent</option>\n          <option value=\"4\">★★★★☆ - Good</option>\n          <option value=\"3\">★★★☆☆ - Average</option>\n          <option value=\"2\">★★☆☆☆ - Poor</option>\n          <option value=\"1\">★☆☆☆☆ - Terrible</option>\n        </select>\n        <textarea name=\"review\" rows=\"4\" placeholder=\"Share your experience...\" required></textarea>\n        <button type=\"submit\">Submit Review</button>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function(){\n      var reviews = document.querySelectorAll(\"#eu-reviews-grid .eu-review-card\");\n      var btn = document.getElementById(\"eu-loadmore-btn\");\n      var perPage = 6; \n      var shown = 0;\n\n      function showMore(){\n        for(var i=shown; i<shown+perPage && i<reviews.length; i++){\n          reviews[i].style.display = \"flex\";\n        }\n        shown += perPage;\n        if(shown >= reviews.length){\n          btn.style.display = \"none\";\n        }\n      }\n      showMore(); \n      btn.addEventListener(\"click\", showMore);\n\n      document.getElementById(\"review-form\").addEventListener(\"submit\", function(e){\n        e.preventDefault();\n        alert(\"Thank you for your review! It will appear once approved.\");\n        this.reset();\n      });\n    });\n  </script>\n</section>",
