    "custom_liquid_7RqYxa": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"eu-reviews-section\">\n  <style>\n    .eu-reviews-section { background:#f7fafc; padding:48px 0; font-family:-apple-system, BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial; }\n    .eu-reviews-container{ max-width:1100px; margin:0 auto; padding:0 20px; }\n    .eu-reviews-header{ text-align:center; margin-bottom:28px; }\n    .eu-reviews-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; }\n    .eu-review-card{ background:#fff; border-radius:18px; padding:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); display:flex; flex-direction:column; min-height:160px; }\n    .eu-review-top{ display:flex; align-items:center; margin-bottom:10px; }\n    .eu-avatar{ width:44px; height:44px; border-radius:50%; background:#e6e6e6; display:flex; align-items:center; justify-content:center; font-weight:700; color:#374151; margin-right:12px; }\n    .eu-review-name{ font-weight:600; margin:0; }\n    .eu-verified{ font-size:13px; color:#6b7280; margin:0; }\n    .eu-stars{ display:flex; gap:4px; margin-bottom:8px; }\n    .eu-review-text{ color:#374151; margin-top:auto; }\n    .eu-star-filled{ fill:#FBBF24; }\n    .eu-star-empty{ fill:#E5E7EB; }\n    .eu-loadmore-wrap{ text-align:center; margin-top:30px; }\n    .eu-loadmore-btn{ background:#111827; color:#fff; padding:12px 22px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-loadmore-btn:hover{ background:#374151; }\n    .eu-write-review{ margin-top:50px; padding:28px; background:#fff; border-radius:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); }\n    .eu-write-review h3{ margin:0 0 14px; font-size:22px; }\n    .eu-write-review input, .eu-write-review textarea, .eu-write-review select { width:100%; padding:10px; margin-bottom:12px; border:1px solid #d1d5db; border-radius:8px; }\n    .eu-write-review button{ background:#111827; color:#fff; padding:12px 20px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-write-review button:hover{ background:#374151; }\n  </style>\n\n  <div class=\"eu-reviews-container\">\n    <div class=\"eu-reviews-header\">\n      <h2 style=\"font-size:28px; margin:0 0 6px;\">Kundenrezensionen</h2>\n      <p style=\"color:#6b7280; margin:0;\">Von 1.356 Kunden mit <strong>4,8/5</strong> bewertet</p>\n    </div>\n\n    {% assign reviews = \"\nAnna Müller|5|Diese Socken sind unglaublich bequem, die Polsterung hilft wirklich bei meinen Fersenschmerzen. Toller Kauf!;\nLukas Schneider|5|Ausgezeichnete Qualität und sehr stützend. Ich trage sie täglich bei der Arbeit und meine Füße fühlen sich viel besser an.;\nSophie Bauer|4|Atmungsaktiv und weich. Ich wünschte, es gäbe sie in mehr Farben, aber sie erfüllen ihren Zweck.;\nDaniel Fischer|5|Perfekte Passform und die Polsterung am Knöchel verhindert, dass meine Schuhe reiben. Könnte nicht zufriedener sein.;\nOlivia Wagner|5|Ich habe Plantarfasziitis und diese Socken machen das Gehen viel einfacher.;\nMichael Weber|4|Der Halt an der Unterseite ist auf Holzböden sehr praktisch. Anfangs etwas eng, aber sie dehnen sich aus.;\nEmma Schulz|5|So viel besser als normale Socken. Meine Füße fühlen sich den ganzen Tag gepolstert an.;\nRobert Hoffmann|5|Ideal für meine morgendlichen Läufe. Sie bleiben an Ort und Stelle und halten meine Füße kühl.;\nClara Becker|5|Liebe das weiche Gefühl und wie gut sie Stöße abfedern, wenn ich den ganzen Tag auf den Beinen bin.;\nBenjamin Krause|4|Sehr praktisch. Ich habe weniger Schmerzen in meinen Fußgewölben bemerkt, seit ich diese benutze.;\nIsabella Lehmann|5|Fantastische Socken! Die Polsterung am Knöchel macht einen riesigen Unterschied.;\nDavid Schuster|5|Genau das, was ich für meine Arbeitsschuhe gebraucht habe. Keine Blasen mehr an der Ferse.;\nSophia Köhler|5|Habe ein Paar für meinen Vater gekauft und jetzt will er mehr. Er sagt, sie helfen sehr bei seinen Fußschmerzen.;\nJonas Vogel|4|Gute Socken insgesamt, brauchen aber etwas länger zum Trocknen nach dem Waschen.;\nAmelia Braun|5|Die Polsterung fühlt sich an, als würde man auf Wolken laufen. Jeden Cent wert!;\nMatthias Richter|5|Die Anti-Rutsch-Streifen sind genial — ich rutsche nicht mehr auf meinen Küchenfliesen aus.;\nCharlotte Neumann|5|Ich habe viele orthopädische Socken ausprobiert, aber diese sind bisher die bequemsten.;\nJakob Hartmann|5|Stark, langlebig und sehr stützend. Ich benutze sie täglich im Fitnessstudio.;\nMia Schäfer|4|Passen gut und sind atmungsaktiv. Würde mir jedoch mehr Stilvarianten wünschen.;\nHenrik Wolf|5|Brillante Socken. Meine Fersenschmerzen sind nach einer Woche fast verschwunden.;\nAva Lange|5|Super weich und schützend. Ich bekomme keine Blasen mehr von meinen Turnschuhen.;\nThomas Brandt|5|Diese absorbieren wirklich Stöße. Ideal für lange Spaziergänge und Wanderungen.;\nGreta Frank|4|Die Polsterung ist fantastisch, aber ich würde einen etwas lockereren Bund bevorzugen.;\nLukas Peters|5|Genau wie beschrieben. Bequem, stützend und dazu auch noch stylisch.;\nElla Busch|5|Ich stehe 10 Stunden bei der Arbeit — diese Socken haben meine Füße gerettet!;\nGeorg Maier|5|Perfekt für meine schwachen Knöchel. Die Polsterung macht einen riesigen Unterschied.;\nSophie Lehner|5|Ich liebe, wie atmungsaktiv sie sind. Meine Füße schwitzen nicht mehr.;\nSamuel Bergmann|4|Solides Produkt. Würde es jedem mit schmerzenden Fersen empfehlen.;\nHannah Seidel|5|Mein Mann liebt diese Socken. Er sagt, es sind die besten, die er je getragen hat.;\nLeo Kraus|5|Ich trage sie beim Laufen und sie sind fantastisch — keine Blasen mehr!;\nLena Vogel|5|Weich, bequem und sehr langlebig. Ich werde auf jeden Fall mehr kaufen.;\nWilliam Albrecht|4|Der Anti-Rutsch-Effekt funktioniert gut auf meinen Fliesen. Gute Alltagssocken.;\nLilly Sommer|5|Ich hätte nicht so viel Komfort von Socken erwartet! Sie sind jetzt mein Lieblingspaar.;\nJosef Beck|5|Brillante Polsterung. Sie haben geholfen, die Schmerzen in meinen Fußgewölben zu reduzieren.;\nZoe Martens|5|Perfekte Socken für meine langen Schichten im Krankenhaus. Super stützend.;\nAdrian Lorenz|4|Die Qualität ist ausgezeichnet. Sie brauchen nur etwas länger zum Trocknen.;\nJessica Engel|5|Liebe diese Socken. Ich laufe viel und sie schützen meine Füße wirklich.;\nNoah Günther|5|Super bequem und atmungsaktiv. Ich empfehle sie jedem mit Fußschmerzen.;\nHanna Busch|5|Die Polsterung an der Ferse ist ein echter Game-Changer. Meine Schuhe reiben überhaupt nicht mehr.;\nOskar Seifert|4|Funktionieren gut und sind sehr bequem. Würde sie wieder kaufen.;\nLiam König|5|Starke Socken mit toller Unterstützung. Ideal für Sport und Alltag.;\nElla Meier|5|So atmungsaktiv und leicht. Meine Füße bleiben den ganzen Tag frisch.;\nMilan Pohl|5|Diese sind großartig für meinen Job — ich stehe ständig und fühle mich viel weniger müde.;\nPia Stein|4|Die Polsterung ist hervorragend. Wären perfekt, wenn es sie in mehr Farben gäbe.;\nJakob Horn|5|Fantastische Socken. Sie bieten echten Halt und Komfort den ganzen Tag über.;\nFriedrich Böhm|5|Meine Frau hat mir diese gekauft und ich bin sehr beeindruckt. Fersenschmerzen weg!;\nRuby Heller|5|Super stützende Socken. Ich benutze sie täglich und sie sehen immer noch aus wie neu.;\nLeon Moritz|5|Brillant für Sport — kein Rutschen mehr in meinen Turnschuhen und toller Komfort.;\nIsla König|5|Ich hätte nie gedacht, dass Socken so einen Unterschied machen könnten, aber diese tun es wirklich!;\n\" | split: \";\" %}\n\n\n    <div id=\"eu-reviews-grid\" class=\"eu-reviews-grid\">\n      {% for r in reviews %}\n        {% assign parts = r | split: \"|\" %}\n        {% assign name = parts[0] | strip %}\n        {% assign rating = parts[1] | strip | plus: 0 %}\n        {% assign text = parts[2] | strip %}\n        {% if name != \"\" %}\n        <article class=\"eu-review-card\" style=\"display:none;\">\n          <div class=\"eu-review-top\">\n            <div class=\"eu-avatar\">{{ name | slice: 0, 1 }}</div>\n            <div>\n              <p class=\"eu-review-name\">{{ name }}</p>\n              <p class=\"eu-verified\">Verified Buyer</p>\n            </div>\n          </div>\n          <div class=\"eu-stars\">\n            {% for i in (1..5) %}\n              {% if i <= rating %}\n                <svg class=\"eu-star-filled\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% else %}\n                <svg class=\"eu-star-empty\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% endif %}\n            {% endfor %}\n          </div>\n          <p class=\"eu-review-text\">“{{ text }}”</p>\n        </article>\n        {% endif %}\n      {% endfor %}\n    </div>\n\n    <div class=\"eu-loadmore-wrap\">\n      <button id=\"eu-loadmore-btn\" class=\"eu-loadmore-btn\">\nWeitere Bewertungen laden</button>\n    </div>\n\n    <div class=\"eu-write-review\">\n      <h3>Schreiben Sie eine Bewertung</h3>\n      <form id=\"review-form\">\n        <input type=\"text\" name=\"name\" placeholder=\"Ihr Name\" required>\n        <select name=\"rating\" required>\n          <option value=\"\">Bewertung\n</option>\n          <option value=\"5\">★★★★★ - Exzellent\n</option>\n          <option value=\"4\">★★★★☆ - Gut</option>\n          <option value=\"3\">★★★☆☆ - Durchschnitt\n</option>\n          <option value=\"2\">★★☆☆☆ - schlecht\n</option>\n          <option value=\"1\">★☆☆☆☆ - Schrecklich</option>\n        </select>\n        <textarea name=\"review\" rows=\"4\" placeholder=\"Teilen Sie Ihre Erfahrungen...\" required></textarea>\n        <button type=\"submit\">Bewertung abgeben\n</button>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function(){\n      var reviews = document.querySelectorAll(\"#eu-reviews-grid .eu-review-card\");\n      var btn = document.getElementById(\"eu-loadmore-btn\");\n      var perPage = 6; \n      var shown = 0;\n\n      function showMore(){\n        for(var i=shown; i<shown+perPage && i<reviews.length; i++){\n          reviews[i].style.display = \"flex\";\n        }\n        shown += perPage;\n        if(shown >= reviews.length){\n          btn.style.display = \"none\";\n        }\n      }\n      showMore(); \n      btn.addEventListener(\"click\", showMore);\n\n      document.getElementById(\"review-form\").addEventListener(\"submit\", function(e){\n        e.preventDefault();\n        alert(\"Thank you for your review! It will appear once approved.\");\n        this.reset();\n      });\n    });\n  </script>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
