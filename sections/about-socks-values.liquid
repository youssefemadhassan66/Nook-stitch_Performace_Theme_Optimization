        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About socks values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Comfort first",
            "text": "Every detail should make the sock easier to wear: softer seams, steady support, breathable knit, and less pressure."
          }
        },
        {
          "type": "value",
