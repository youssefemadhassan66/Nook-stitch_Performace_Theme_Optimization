    "custom_liquid_7RqYxa": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"eu-reviews-section\">\n  <style>\n    .eu-reviews-section { background:#f7fafc; padding:48px 0; font-family:-apple-system, BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial; }\n    .eu-reviews-container{ max-width:1100px; margin:0 auto; padding:0 20px; }\n    .eu-reviews-header{ text-align:center; margin-bottom:28px; }\n    .eu-reviews-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; }\n    .eu-review-card{ background:#fff; border-radius:18px; padding:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); display:flex; flex-direction:column; min-height:160px; }\n    .eu-review-top{ display:flex; align-items:center; margin-bottom:10px; }\n    .eu-avatar{ width:44px; height:44px; border-radius:50%; background:#e6e6e6; display:flex; align-items:center; justify-content:center; font-weight:700; color:#374151; margin-right:12px; }\n    .eu-review-name{ font-weight:600; margin:0; }\n    .eu-verified{ font-size:13px; color:#6b7280; margin:0; }\n    .eu-stars{ display:flex; gap:4px; margin-bottom:8px; }\n    .eu-review-text{ color:#374151; margin-top:auto; }\n    .eu-star-filled{ fill:#FBBF24; }\n    .eu-star-empty{ fill:#E5E7EB; }\n    .eu-loadmore-wrap{ text-align:center; margin-top:30px; }\n    .eu-loadmore-btn{ background:#111827; color:#fff; padding:12px 22px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-loadmore-btn:hover{ background:#374151; }\n    .eu-write-review{ margin-top:50px; padding:28px; background:#fff; border-radius:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); }\n    .eu-write-review h3{ margin:0 0 14px; font-size:22px; }\n    .eu-write-review input, .eu-write-review textarea, .eu-write-review select { width:100%; padding:10px; margin-bottom:12px; border:1px solid #d1d5db; border-radius:8px; }\n    .eu-write-review button{ background:#111827; color:#fff; padding:12px 20px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-write-review button:hover{ background:#374151; }\n  </style>\n\n  <div class=\"eu-reviews-container\">\n    <div class=\"eu-reviews-header\">\n      <h2 style=\"font-size:28px; margin:0 0 6px;\">Customer Reviews</h2>\n      <p style=\"color:#6b7280; margin:0;\">Rated <strong>4.8/5</strong> by 1,356 customers</p>\n    </div>\n\n    {% assign reviews = \"\nSarah Johnson|5|These socks are incredibly comfortable, the cushioning really helps with my heel pain. Great buy!;\nJames Smith|5|Excellent quality and very supportive. I wear them daily for work and my feet feel much better.;\nEmily Brown|4|Breathable and soft. I wish they came in more colours, but they do the job well.;\nDaniel Wilson|5|Perfect fit and the ankle padding stops my shoes from rubbing. Couldn’t be happier.;\nOlivia Davis|5|I have plantar fasciitis and these socks make walking so much easier.;\nMichael Taylor|4|The grip on the bottom is very handy on wooden floors. Slightly tight at first but they stretch out.;\nEmma Clark|5|So much better than regular socks. My feet feel cushioned all day long.;\nRobert Lee|5|Great for my morning runs. They stay in place and keep my feet cool.;\nChloe White|5|Love the soft feel and how well they absorb impact when I’m on my feet all day.;\nBenjamin Harris|4|Very practical. I’ve noticed less soreness in my arches since using these.;\nIsabella Young|5|Fantastic socks! The padding at the back of the ankle makes a huge difference.;\nDavid Hall|5|Exactly what I needed for work boots. No more blisters at the heel.;\nSophia Lewis|5|Bought a pair for my dad and now he wants more. He says they really help his foot pain.;\nEthan King|4|Good socks overall, though they take a bit longer to dry after washing.;\nAmelia Wright|5|The cushioning feels like walking on clouds. Worth every penny!;\nMatthew Scott|5|The anti-slip stripes are brilliant. I don’t slip on my kitchen tiles anymore.;\nCharlotte Green|5|I’ve tried many orthopedic socks, but these are the most comfortable so far.;\nJack Turner|5|Strong, durable, and very supportive. I use them at the gym daily.;\nMia Baker|4|Fit well and are breathable. Would love more style options though.;\nHenry Adams|5|Brilliant socks. My heel pain is almost gone after a week of wearing them.;\nAva Campbell|5|Super soft and protective. I no longer get blisters from my trainers.;\nThomas Mitchell|5|These really absorb impact. Great for long walks and hiking.;\nGrace Roberts|4|The cushioning is amazing, but I’d prefer a slightly looser fit at the cuff.;\nLucas Evans|5|Exactly as described. Comfortable, supportive, and stylish too.;\nElla Carter|5|I stand for 10 hours at work, these socks have saved my feet!;\nGeorge Walker|5|Perfect for my bad ankles. The padding makes a world of difference.;\nSophie Allen|5|I love how breathable they are. My feet don’t get sweaty anymore.;\nSamuel Wright|4|Solid product. Would recommend for anyone with sore heels.;\nHannah Hill|5|My husband loves these socks. He says they’re the best he’s ever worn.;\nLeo Bennett|5|I’ve been wearing them for running and they’re fantastic, no blisters at all.;\nLucy Wood|5|Soft, comfortable, and very durable. I’ll definitely be buying more.;\nWilliam Phillips|4|The anti-slip works well on my tiles. Good everyday socks.;\nLily Foster|5|I didn’t expect such comfort from socks! These are now my go-to pair.;\nJoseph Gray|5|Brilliant cushioning. They’ve helped reduce the pain in my arches.;\nZoe Cooper|5|Perfect socks for my long hospital shifts. Super supportive.;\nAdam Hughes|4|The quality is excellent. They just take a little while to dry.;\nJessica Morris|5|Love these socks. I walk a lot and they really protect my feet.;\nNoah Ward|5|Super comfy and breathable. I recommend them for anyone with foot pain.;\nHarper Brooks|5|The heel padding is a game changer. My shoes no longer rub at all.;\nOscar Edwards|4|Work well and are very comfortable. I’d buy them again.;\nLiam Russell|5|Strong socks with great support. Ideal for sports and daily use.;\nElla Howard|5|So breathable and lightweight. My feet stay fresh all day.;\nMason Palmer|5|These are amazing for my job, I’m on my feet constantly and feel much less tired.;\nPoppy Price|4|The cushioning is excellent. Would be perfect if they came in more colours.;\nJacob Foster|5|Fantastic socks. They provide real support and comfort throughout the day.;\nFreddie Barnes|5|My wife bought these for me and I’m very impressed. Heel pain gone!;\nRuby Coleman|5|Super supportive socks. I use them daily and they still look like new.;\nLogan Murphy|5|Brilliant for sports, no slipping inside my trainers and great comfort.;\nIsla Richardson|5|I never thought socks could make such a difference, but these really do!;\n\" | split: \";\" %}\n\n\n    <div id=\"eu-reviews-grid\" class=\"eu-reviews-grid\">\n      {% for r in reviews %}\n        {% assign parts = r | split: \"|\" %}\n        {% assign name = parts[0] | strip %}\n        {% assign rating = parts[1] | strip | plus: 0 %}\n        {% assign text = parts[2] | strip %}\n        {% if name != \"\" %}\n        <article class=\"eu-review-card\" style=\"display:none;\">\n          <div class=\"eu-review-top\">\n            <div class=\"eu-avatar\">{{ name | slice: 0, 1 }}</div>\n            <div>\n              <p class=\"eu-review-name\">{{ name }}</p>\n              <p class=\"eu-verified\">Verified Buyer</p>\n            </div>\n          </div>\n          <div class=\"eu-stars\">\n            {% for i in (1..5) %}\n              {% if i <= rating %}\n                <svg class=\"eu-star-filled\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% else %}\n                <svg class=\"eu-star-empty\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% endif %}\n            {% endfor %}\n          </div>\n          <p class=\"eu-review-text\">“{{ text }}”</p>\n        </article>\n        {% endif %}\n      {% endfor %}\n    </div>\n\n    <div class=\"eu-loadmore-wrap\">\n      <button id=\"eu-loadmore-btn\" class=\"eu-loadmore-btn\">Load More Reviews</button>\n    </div>\n\n    <div class=\"eu-write-review\">\n      <h3>Write a Review</h3>\n      <form id=\"review-form\">\n        <input type=\"text\" name=\"name\" placeholder=\"Your Name\" required>\n        <select name=\"rating\" required>\n          <option value=\"\">Rating</option>\n          <option value=\"5\">★★★★★ - Excellent</option>\n          <option value=\"4\">★★★★☆ - Good</option>\n          <option value=\"3\">★★★☆☆ - Average</option>\n          <option value=\"2\">★★☆☆☆ - Poor</option>\n          <option value=\"1\">★☆☆☆☆ - Terrible</option>\n        </select>\n        <textarea name=\"review\" rows=\"4\" placeholder=\"Share your experience...\" required></textarea>\n        <button type=\"submit\">Submit Review</button>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function(){\n      var reviews = document.querySelectorAll(\"#eu-reviews-grid .eu-review-card\");\n      var btn = document.getElementById(\"eu-loadmore-btn\");\n      var perPage = 6; \n      var shown = 0;\n\n      function showMore(){\n        for(var i=shown; i<shown+perPage && i<reviews.length; i++){\n          reviews[i].style.display = \"flex\";\n        }\n        shown += perPage;\n        if(shown >= reviews.length){\n          btn.style.display = \"none\";\n        }\n      }\n      showMore(); \n      btn.addEventListener(\"click\", showMore);\n\n      document.getElementById(\"review-form\").addEventListener(\"submit\", function(e){\n        e.preventDefault();\n        alert(\"Thank you for your review! It will appear once approved.\");\n        this.reset();\n      });\n    });\n  </script>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
