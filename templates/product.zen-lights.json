    "custom_liquid_WfJMnX": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .faq-section {\n    max-width: 800px;\n    margin: 40px auto;\n    font-family: Arial, sans-serif;\n    padding: 0 20px; /* adds breathing space on small screens */\n  }\n\n  .faq-section h2 {\n    text-align: center;\n    font-size: 28px;\n    margin-bottom: 25px;\n  }\n\n  .faq-item {\n    border-bottom: 1px solid #ddd;\n    padding: 18px 0;\n  }\n\n  .faq-question {\n    cursor: pointer;\n    font-weight: bold;\n    position: relative;\n    padding-right: 25px;\n    font-size: 16px;\n    line-height: 1.4;\n  }\n\n  .faq-question::after {\n    content: '+';\n    position: absolute;\n    right: 0;\n    font-size: 20px;\n    transition: transform 0.3s ease;\n  }\n\n  .faq-question.active::after {\n    content: '-';\n    transform: rotate(180deg);\n  }\n\n  .faq-answer {\n    display: none;\n    margin-top: 10px;\n    color: #555;\n    line-height: 1.6;\n    font-size: 15px;\n  }\n\n  /* Mobile adjustments */\n  @media (max-width: 600px) {\n    .faq-section h2 {\n      font-size: 22px;\n      margin-bottom: 20px;\n    }\n\n    .faq-question {\n      font-size: 15px;\n      padding-right: 20px;\n    }\n\n    .faq-answer {\n      font-size: 14px;\n      line-height: 1.5;\n    }\n\n    .faq-item {\n      padding: 14px 0;\n    }\n  }\n</style>\n\n<div class=\"faq-section\">\n  <h2>Frequently Asked Questions</h2>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">Does the GlowCage Lamp need to be plugged in?</div>\n    <div class=\"faq-answer\">No, it’s completely wireless and runs on AAA batteries. You can place it anywhere without worrying about cables.</div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">How long does the battery last?</div>\n    <div class=\"faq-answer\">With normal use, the batteries can last up to several weeks. Battery life depends on brightness setting and frequency of use.</div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">Is it safe to leave the lamp on for long periods?</div>\n    <div class=\"faq-answer\">Yes, the LED technology is energy-efficient and produces minimal heat, making it safe for extended use.</div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">What material is it made from?</div>\n    <div class=\"faq-answer\">The GlowCage™ Lamp is crafted from high-quality steel with a modern, minimalist design that fits any interior.</div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">Where can I use it?</div>\n    <div class=\"faq-answer\">Anywhere! It’s perfect for the living room, dining table, bedside, office desk, or even outdoor spaces during cosy evenings.</div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">What if I’m not satisfied with my purchase?</div>\n    <div class=\"faq-answer\">No worries – we offer a 30-Day Money-Back Guarantee and hassle-free returns. Your satisfaction comes first.</div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">Does the lamp come with batteries included?</div>\n    <div class=\"faq-answer\">To keep shipping costs low and comply with international shipping rules, batteries are not included. You’ll need standard AAA batteries.</div>\n  </div>\n</div>\n\n<script>\n  document.querySelectorAll(\".faq-question\").forEach(item => {\n    item.addEventListener(\"click\", () => {\n      item.classList.toggle(\"active\");\n      const answer = item.nextElementSibling;\n      if (answer.style.display === \"block\") {\n        answer.style.display = \"none\";\n      } else {\n        answer.style.display = \"block\";\n      }\n    });\n  });\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
