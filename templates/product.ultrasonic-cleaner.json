          "settings": {
            "heading": "How often should I use it?",
            "icon": "check_mark",
            "row_content": "<p>For the best results, we recommend using nook & stitch™ every few days or whenever your glasses start to get dirty.<br/><br/></p>",
            "page": ""
          }
        },
        "collapsible_row_yBEGdT": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I need to use a cleaning solution?",
            "icon": "check_mark",
            "row_content": "<p>No, just plain water works! But for extra deep cleaning, you can add a drop of mild dish soap or lens cleaning solution.</p>",
