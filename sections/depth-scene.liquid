{% comment %} depth-scene v1 — 3D layered parallax home section {% endcomment %}
{% comment %} GitHub sync marker: 2026-06-25 depth scene visible on codex branch {% endcomment %}
{%- liquid
  assign s = section.settings
-%}

<section
  class="depth-scene gradient color-{{ s.color_scheme }}"
  style="
    --ds-text: {{ s.text_color }};
    --ds-btn-bg: {{ s.button_color }};
    --ds-btn-text: {{ s.button_text_color }};
    --ds-accent: {{ s.accent_color }};
    --ds-base: {{ s.base_color }};
    --ds-min: {{ s.min_height }}px;
    --ds-overlay: {{ s.overlay_opacity | times: 0.01 }};
    --ds-strength: {{ s.parallax_strength | divided_by: 100.0 }};
    --px: 0;
    --py: 0;
    --scroll: 0;
  "
  data-depth-scene="{{ section.id }}"
>
  <div class="depth-scene__stage" aria-hidden="true">
    <span class="depth-scene__base"></span>

    {%- if s.back_image != blank -%}
      <span class="depth-scene__layer depth-scene__layer--back js-depth" style="--depth-x: 8; --depth-y: 8; --depth-scroll: 26;">
        {{- s.back_image | image_url: width: 2000 | image_tag:
            loading: 'eager',
            class: 'depth-scene__img depth-scene__img--cover',
            widths: '800, 1200, 1600, 2000',
            sizes: '100vw'
        -}}
      </span>
    {%- endif -%}

    <span class="depth-scene__glow js-depth" style="--depth-x: 14; --depth-y: 14; --depth-scroll: 40;"></span>

    {%- if s.show_orbs -%}
      <span class="depth-scene__orb depth-scene__orb--a js-depth" style="--depth-x: 18; --depth-y: 18; --depth-scroll: 48;"></span>
      <span class="depth-scene__orb depth-scene__orb--b js-depth" style="--depth-x: 30; --depth-y: 26; --depth-scroll: 64;"></span>
      <span class="depth-scene__orb depth-scene__orb--c js-depth" style="--depth-x: 22; --depth-y: 20; --depth-scroll: 56;"></span>
    {%- endif -%}

    {%- if s.mid_image != blank -%}
      <span class="depth-scene__layer depth-scene__layer--mid js-depth" style="--depth-x: 24; --depth-y: 22; --depth-scroll: 54;">
        {{- s.mid_image | image_url: width: 1000 | image_tag:
            loading: 'lazy',
            class: 'depth-scene__img depth-scene__img--panel',
            widths: '400, 600, 1000',
            sizes: '(max-width: 989px) 60vw, 34vw'
        -}}
      </span>
    {%- endif -%}

    {%- if s.front_image != blank -%}
      <span class="depth-scene__layer depth-scene__layer--front js-depth" style="--depth-x: 42; --depth-y: 36; --depth-scroll: 78;">
        {{- s.front_image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            class: 'depth-scene__img depth-scene__img--float',
            widths: '500, 800, 1200',
            sizes: '(max-width: 989px) 70vw, 40vw'
        -}}
      </span>
    {%- endif -%}

    <span class="depth-scene__scrim"></span>
  </div>

  <div class="depth-scene__inner">
    <div class="depth-scene__copy">
      {%- if s.eyebrow != blank -%}
        <p class="depth-scene__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="depth-scene__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="depth-scene__body rte">{{ s.body }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="depth-scene__button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-depth-scene="{{ section.id }}"]');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let px = 0;
    let py = 0;
    let scroll = 0;
    let raf = null;

    const apply = () => {
      raf = null;
      root.style.setProperty('--px', px.toFixed(3));
      root.style.setProperty('--py', py.toFixed(3));
      root.style.setProperty('--scroll', scroll.toFixed(3));
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(apply); };

    const onMove = (event) => {
      const rect = root.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      px = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      py = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
      schedule();
    };
    const onLeave = () => { px = 0; py = 0; schedule(); };
    const onScroll = () => {
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      let value = (((rect.top + rect.height / 2) - vh / 2) / vh) * -1;
      scroll = Math.max(-1.2, Math.min(1.2, value));
      schedule();
    };

    root.addEventListener('pointermove', onMove, { passive: true });
    root.addEventListener('pointerleave', onLeave, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% stylesheet %}
  .depth-scene {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: var(--ds-min, 720px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ds-text, #ffffff);
    background: var(--ds-base, #1f1d24);
    perspective: 1400px;
  }

  .depth-scene__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  /* Shared parallax transform — magnitude scaled by --ds-strength (0..1) */
  .js-depth {
    position: absolute;
    will-change: transform;
    transform: translate3d(
      calc(var(--px) * var(--depth-x, 0) * var(--ds-strength) * 1px),
      calc((var(--py) * var(--depth-y, 0) + var(--scroll) * var(--depth-scroll, 0)) * var(--ds-strength) * 1px),
      0
    );
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Solid backdrop when no photo is set */
  .depth-scene__base {
    position: absolute;
    inset: -8%;
    background:
      radial-gradient(120% 90% at 50% 8%, color-mix(in srgb, var(--ds-base, #1f1d24) 70%, #000) 0%, var(--ds-base, #1f1d24) 60%),
      var(--ds-base, #1f1d24);
  }

  .depth-scene__layer--back { inset: -10%; }
  .depth-scene__layer--back .depth-scene__img--cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Accent glow — decorative brand color, sits low in the stack */
  .depth-scene__glow {
    top: -18%;
    left: 50%;
    width: min(78rem, 120%);
    height: min(78rem, 120%);
    margin-left: calc(min(78rem, 120%) / -2);
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--ds-accent, #20AD82) 42%, transparent) 0%, transparent 62%);
    opacity: 0.55;
    filter: blur(8px);
  }

  /* Floating soft orbs give depth even with no photos */
  .depth-scene__orb {
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.5;
  }
  .depth-scene__orb--a {
    top: 16%;
    left: 12%;
    width: 16rem;
    height: 16rem;
    background: radial-gradient(circle at 32% 30%, color-mix(in srgb, var(--ds-accent, #20AD82) 60%, #fff) 0%, color-mix(in srgb, var(--ds-accent, #20AD82) 30%, transparent) 70%, transparent 72%);
  }
  .depth-scene__orb--b {
    bottom: 12%;
    right: 14%;
    width: 22rem;
    height: 22rem;
    background: radial-gradient(circle at 60% 36%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.06) 60%, transparent 72%);
    opacity: 0.4;
  }
  .depth-scene__orb--c {
    top: 54%;
    left: 70%;
    width: 9rem;
    height: 9rem;
    background: radial-gradient(circle at 40% 40%, color-mix(in srgb, var(--ds-accent, #20AD82) 70%, #fff) 0%, transparent 70%);
    opacity: 0.6;
  }

  /* Midground translucent panel image */
  .depth-scene__layer--mid {
    top: 50%;
    left: 8%;
    width: min(34vw, 40rem);
    transform-origin: center;
  }
  .depth-scene__layer--mid .depth-scene__img--panel {
    width: 100%;
    height: auto;
    border-radius: 18px;
    opacity: 0.92;
    box-shadow: 0 30px 60px rgba(15, 14, 18, 0.45);
  }

  /* Foreground floating element (transparent PNG / cutout works best) */
  .depth-scene__layer--front {
    bottom: 0;
    right: 6%;
    width: min(40vw, 46rem);
  }
  .depth-scene__layer--front .depth-scene__img--float {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 36px 48px rgba(15, 14, 18, 0.5));
  }

  /* Darkening scrim keeps copy legible over photos */
  .depth-scene__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 14, 18, calc(var(--ds-overlay, 0.45) * 0.6)) 0%, rgba(15, 14, 18, calc(var(--ds-overlay, 0.45) * 1.1)) 100%);
  }

  .depth-scene__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: clamp(96px, 11vw, 168px) clamp(24px, 5vw, 72px);
    display: flex;
    justify-content: center;
  }

  .depth-scene__copy {
    display: grid;
    justify-items: center;
    gap: 0;
    width: min(100%, 56rem);
    text-align: center;
  }

  .depth-scene__eyebrow {
    margin: 0 0 20px;
    color: var(--ds-text, #ffffff);
    font-family: Poppins, var(--font-heading-family), Arial, sans-serif;
    font-size: clamp(1.05rem, 0.9vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.46em;
    line-height: 1.2;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .depth-scene__heading {
    margin: 0;
    color: var(--ds-text, #ffffff);
    font-family: Poppins, var(--font-heading-family), Arial, sans-serif;
    font-size: clamp(3.6rem, 5vw, 6.6rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .depth-scene__body {
    max-width: 42rem;
    margin-top: 22px;
    color: var(--ds-text, #ffffff);
    font-size: clamp(1.6rem, 1.2vw, 2rem);
    line-height: 1.5;
    opacity: 0.94;
  }
  .depth-scene__body p { margin: 0; }

  .depth-scene__button {
    display: inline-flex;
    min-width: 152px;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    padding: 0 34px;
    border: 1px solid transparent;
    background: var(--ds-btn-bg, #FBFAF4);
    color: var(--ds-btn-text, #1F1D24);
    font-family: Poppins, var(--font-heading-family), Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .depth-scene__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 32px rgba(15, 14, 18, 0.3);
  }
  .depth-scene__button:focus-visible {
    outline: 3px solid var(--ds-btn-bg, #FBFAF4);
    outline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    .depth-scene__heading { font-size: clamp(3.2rem, 9vw, 5rem); }
    .depth-scene__layer--mid { left: 2%; width: 52vw; opacity: 0.85; }
    .depth-scene__layer--front { right: 2%; width: 58vw; }
    .depth-scene__orb--a { width: 12rem; height: 12rem; }
    .depth-scene__orb--b { width: 15rem; height: 15rem; }
  }

  @media screen and (max-width: 599px) {
    .depth-scene { min-height: max(48rem, calc(var(--ds-min, 720px) * 0.78)); }
    .depth-scene__inner { padding: 96px 20px; }
    .depth-scene__eyebrow { letter-spacing: 0.32em; }
    .depth-scene__heading { font-size: clamp(2.9rem, 11vw, 4rem); }
    .depth-scene__body { font-size: 1.55rem; }
    .depth-scene__layer--front { width: 72vw; opacity: 0.9; }
  }

  /* Motion off — flatten every parallax layer, no transforms */
  @media (prefers-reduced-motion: reduce) {
    .depth-scene .js-depth {
      transform: none !important;
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D depth scene",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.popup"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Feel the difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comfort with depth."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Orthopedic support, layered cushioning, and a fit that moves with you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the socks"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layers (3D parallax)",
      "info": "All photos are optional. With none set the section shows a premium gradient + floating orbs. Layers shift subtly with cursor and scroll."
    },
    {
      "type": "image_picker",
      "id": "back_image",
      "label": "Background photo (far layer)",
      "info": "Full-bleed scene. Moves the least."
    },
    {
      "type": "image_picker",
      "id": "mid_image",
      "label": "Midground panel (optional)",
      "info": "Small framed image, sits left behind the copy."
    },
    {
      "type": "image_picker",
      "id": "front_image",
      "label": "Foreground element (closest layer)",
      "info": "Floats nearest and moves the most. A transparent PNG cutout looks best."
    },
    {
      "type": "checkbox",
      "id": "show_orbs",
      "label": "Show floating accent orbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "parallax_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Parallax strength",
      "default": 35,
      "info": "How far layers shift. Lower = subtle / premium. 0 turns motion off. Always off for reduced-motion visitors."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "base_color",
      "label": "Backdrop color (no-photo fallback)",
      "default": "#1F1D24"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent glow",
      "default": "#157A5B"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#FBFAF4"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#1F1D24"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Photo overlay darkness",
      "default": 45,
      "info": "Darkens photos so the copy stays legible. Ignored when no photo is set."
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 480,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 720
    }
  ],
  "presets": [
    {
      "name": "3D depth scene"
    }
  ]
}
{% endschema %}
