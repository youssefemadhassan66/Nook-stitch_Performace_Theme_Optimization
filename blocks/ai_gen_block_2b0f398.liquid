{% doc %}
  @prompt
    Generate a quiet guarantee strip for footer trust proof.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign guarantee_logo_class = 'ai-guarantee-logo-' | append: ai_gen_id %}

{% style %}
  .ai-guarantees-section-{{ ai_gen_id }} {
    --ai-guarantees-bg: {{ block.settings.background_color }};
    --ai-guarantees-ink: {{ block.settings.title_color }};
    --ai-guarantees-muted: {{ block.settings.description_color }};
    --ai-guarantees-accent: {{ block.settings.icon_color }};
    --ai-guarantees-rule: {{ block.settings.title_color | color_modify: 'alpha', 0.12 }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: var(--ai-guarantees-bg);
    color: var(--ai-guarantees-ink);
  }

  .ai-guarantees-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-guarantees-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
    align-items: start;
  }

  .ai-guarantee-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {% if block.settings.alignment == 'left' %}flex-start{% elsif block.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};
    justify-content: flex-start;
    gap: {{ block.settings.icon_spacing }}px;
    min-height: 120px;
    padding: {{ block.settings.item_padding }}px clamp(12px, 1.6vw, 24px);
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    color: var(--ai-guarantees-ink);
    text-align: {{ block.settings.alignment }};
    transition: transform 220ms ease;
  }

  .ai-guarantee-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--ai-guarantees-accent);
    background: transparent;
    border: 0;
    border-radius: 0;
    transition: transform 220ms ease;
  }

  .ai-guarantee-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    color: currentColor;
    stroke-width: 1.65;
  }

  .ai-guarantee-logo-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-guarantee-title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: var(--ai-guarantees-ink);
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    line-height: 1.15;
    text-transform: uppercase;
  }

  .ai-guarantee-description-{{ ai_gen_id }} {
    margin: 0;
    color: var(--ai-guarantees-muted);
    font-family: var(--font-body-family);
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.45;
  }

  {% if block.settings.enable_hover %}
    .ai-guarantee-item-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.hover_lift }}px);
    }

    .ai-guarantee-item-{{ ai_gen_id }}:hover .ai-guarantee-icon-wrapper-{{ ai_gen_id }} {
      transform: translateY(-1px);
    }
  {% endif %}

  @media (prefers-reduced-motion: reduce) {
    .ai-guarantee-item-{{ ai_gen_id }},
    .ai-guarantee-icon-wrapper-{{ ai_gen_id }} {
      transition: none;
    }

    .ai-guarantee-item-{{ ai_gen_id }}:hover {
      transform: none;
    }
  }

  @media screen and (max-width: 989px) {
    .ai-guarantees-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-guarantees-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-guarantees-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.gap | times: 0.8 }}px;
    }

    .ai-guarantee-item-{{ ai_gen_id }} {
      min-height: auto;
      padding: {{ block.settings.item_padding | times: 0.8 }}px;
    }

    .ai-guarantee-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-guarantee-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size }}px;
    }

    .ai-guarantee-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size }}px;
    }
  }
{% endstyle %}

<div class="ai-guarantees-section-{{ ai_gen_id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-guarantees-container-{{ ai_gen_id }}">
    <div class="ai-guarantees-grid-{{ ai_gen_id }}">
      <div class="ai-guarantee-item-{{ ai_gen_id }}">
        <div class="ai-guarantee-icon-wrapper-{{ ai_gen_id }}" aria-hidden="true">
          {%- if block.settings.guarantee_1_logo != blank -%}
            {{ block.settings.guarantee_1_logo | image_url: width: 200 | image_tag: class: guarantee_logo_class, widths: '50, 75, 100, 150, 200', sizes: '100px', loading: 'lazy' }}
          {%- else -%}
            <svg class="ai-guarantee-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3.4 7.2 8.6-4.4 8.6 4.4-8.6 4.4-8.6-4.4Z"></path>
              <path d="M3.4 7.2v9.6l8.6 4.4 8.6-4.4V7.2"></path>
              <path d="M12 11.6v9.6"></path>
              <path d="m7.8 5 8.6 4.4"></path>
            </svg>
          {%- endif -%}
        </div>
        <div class="ai-guarantee-content-{{ ai_gen_id }}">
          <h3 class="ai-guarantee-title-{{ ai_gen_id }}">{{ block.settings.guarantee_1_title }}</h3>
          <p class="ai-guarantee-description-{{ ai_gen_id }}">{{ block.settings.guarantee_1_description }}</p>
        </div>
      </div>

      <div class="ai-guarantee-item-{{ ai_gen_id }}">
        <div class="ai-guarantee-icon-wrapper-{{ ai_gen_id }}" aria-hidden="true">
          {%- if block.settings.guarantee_2_logo != blank -%}
            {{ block.settings.guarantee_2_logo | image_url: width: 200 | image_tag: class: guarantee_logo_class, widths: '50, 75, 100, 150, 200', sizes: '100px', loading: 'lazy' }}
          {%- else -%}
            <svg class="ai-guarantee-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 21h8"></path>
              <path d="M12 17v4"></path>
              <path d="M7 4h10v5a5 5 0 0 1-10 0V4Z"></path>
              <path d="M7 6H4.5a2.5 2.5 0 0 0 0 5H7"></path>
              <path d="M17 6h2.5a2.5 2.5 0 0 1 0 5H17"></path>
              <path d="m12 7.2.8 1.7 1.9.3-1.4 1.3.3 1.9-1.6-.9-1.6.9.3-1.9-1.4-1.3 1.9-.3.8-1.7Z"></path>
            </svg>
          {%- endif -%}
        </div>
        <div class="ai-guarantee-content-{{ ai_gen_id }}">
          <h3 class="ai-guarantee-title-{{ ai_gen_id }}">{{ block.settings.guarantee_2_title }}</h3>
          <p class="ai-guarantee-description-{{ ai_gen_id }}">{{ block.settings.guarantee_2_description }}</p>
        </div>
      </div>

      <div class="ai-guarantee-item-{{ ai_gen_id }}">
        <div class="ai-guarantee-icon-wrapper-{{ ai_gen_id }}" aria-hidden="true">
          {%- if block.settings.guarantee_3_logo != blank -%}
            {{ block.settings.guarantee_3_logo | image_url: width: 200 | image_tag: class: guarantee_logo_class, widths: '50, 75, 100, 150, 200', sizes: '100px', loading: 'lazy' }}
          {%- else -%}
            <svg class="ai-guarantee-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="5"></circle>
              <path d="m9.4 8.1 1.7 1.7 3.4-3.5"></path>
              <path d="m8.6 12.3-1.4 8.2 4.8-2.7 4.8 2.7-1.4-8.2"></path>
            </svg>
          {%- endif -%}
        </div>
        <div class="ai-guarantee-content-{{ ai_gen_id }}">
          <h3 class="ai-guarantee-title-{{ ai_gen_id }}">{{ block.settings.guarantee_3_title }}</h3>
          <p class="ai-guarantee-description-{{ ai_gen_id }}">{{ block.settings.guarantee_3_description }}</p>
        </div>
      </div>

      <div class="ai-guarantee-item-{{ ai_gen_id }}">
        <div class="ai-guarantee-icon-wrapper-{{ ai_gen_id }}" aria-hidden="true">
          {%- if block.settings.guarantee_4_logo != blank -%}
            {{ block.settings.guarantee_4_logo | image_url: width: 200 | image_tag: class: guarantee_logo_class, widths: '50, 75, 100, 150, 200', sizes: '100px', loading: 'lazy' }}
          {%- else -%}
            <svg class="ai-guarantee-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.5a7 7 0 1 1 13.4 2.8"></path>
              <path d="M4.5 13H7v4H4.5a1.5 1.5 0 0 1-1.5-1.5v-1A1.5 1.5 0 0 1 4.5 13Z"></path>
              <path d="M17 13h2.5a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5H17v-4Z"></path>
              <path d="M14.5 19.5h1.2a3.3 3.3 0 0 0 3.3-3.3"></path>
            </svg>
          {%- endif -%}
        </div>
        <div class="ai-guarantee-content-{{ ai_gen_id }}">
          <h3 class="ai-guarantee-title-{{ ai_gen_id }}">{{ block.settings.guarantee_4_title }}</h3>
          <p class="ai-guarantee-description-{{ ai_gen_id }}">{{ block.settings.guarantee_4_description }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

