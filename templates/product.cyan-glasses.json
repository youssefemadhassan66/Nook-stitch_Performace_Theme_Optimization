      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_HVppW6": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "How Long Does The Shipping take?",
            "icon": "none",
            "row_content": "<p>Orders get shipped next day.</p><p>Standard delivery takes 3-5 business days, depending on your location.<br/><br/>You'll receive a tracking number as soon as your order is on the way.</p>",
            "page": ""
          }
        },
        "collapsible_row_KQn6x6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What Can The Cyan AI Do?",
            "icon": "none",
            "row_content": "<p>Cyan AI gives you instant access to ChatGPT. Ask questions, get ideas, write texts, solve problems and plan your day. All by voice. It's like having your own personal assistant built into your glasses.</p>",
            "page": ""
          }
        },
        "collapsible_row_LhhV7X": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are They Easy To Use?",
            "icon": "none",
            "row_content": "<p>Cyan AI Glasses are built for simplicity. Just connect them to your phone through the HeyCyan app and control everything with touch gestures or voice commands, no complicated setup required. Every order includes a user manual, and the app will guide you step by step<br/><br/></p>",
            "page": ""
          }
        },
        "collapsible_row_NxibBb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Will They Work With My Phone?",
            "icon": "none",
            "row_content": "<p>Absolutely, Cyan AI Glasses work seamlessly with both iOS and Android devices. Just download the HeyCyan app and you're ready to connect, control and customize.</p>",
            "page": ""
          }
        },
        "collapsible_row_3DrMCA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can People Around Me Hear The Audio?",
            "icon": "none",
            "row_content": "<p>We designed Cyan AI with open-air directional speakers that play audio clearly to you, not the room. People nearby won't hear your music or calls unless you raise the volume very high.</p>",
            "page": ""
          }
        },
        "collapsible_row_Nf6eKH": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where Will My Videos And Photos Go?",
            "icon": "none",
            "row_content": "<p>After taking a video or a photo, your media will be saved in HeyCyan app!</p>",
            "page": ""
          }
        }
      },
