    "custom_liquid_7RqYxa": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"eu-reviews-section\">\n  <style>\n    .eu-reviews-section { background:#f7fafc; padding:48px 0; font-family:-apple-system, BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial; }\n    .eu-reviews-container{ max-width:1100px; margin:0 auto; padding:0 20px; }\n    .eu-reviews-header{ text-align:center; margin-bottom:28px; }\n    .eu-reviews-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; }\n    .eu-review-card{ background:#fff; border-radius:18px; padding:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); display:flex; flex-direction:column; min-height:160px; }\n    .eu-review-top{ display:flex; align-items:center; margin-bottom:10px; }\n    .eu-avatar{ width:44px; height:44px; border-radius:50%; background:#e6e6e6; display:flex; align-items:center; justify-content:center; font-weight:700; color:#374151; margin-right:12px; }\n    .eu-review-name{ font-weight:600; margin:0; }\n    .eu-verified{ font-size:13px; color:#6b7280; margin:0; }\n    .eu-stars{ display:flex; gap:4px; margin-bottom:8px; }\n    .eu-review-text{ color:#374151; margin-top:auto; }\n    .eu-star-filled{ fill:#FBBF24; }\n    .eu-star-empty{ fill:#E5E7EB; }\n    .eu-loadmore-wrap{ text-align:center; margin-top:30px; }\n    .eu-loadmore-btn{ background:#111827; color:#fff; padding:12px 22px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-loadmore-btn:hover{ background:#374151; }\n    .eu-write-review{ margin-top:50px; padding:28px; background:#fff; border-radius:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); }\n    .eu-write-review h3{ margin:0 0 14px; font-size:22px; }\n    .eu-write-review input, .eu-write-review textarea, .eu-write-review select { width:100%; padding:10px; margin-bottom:12px; border:1px solid #d1d5db; border-radius:8px; }\n    .eu-write-review button{ background:#111827; color:#fff; padding:12px 20px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-write-review button:hover{ background:#374151; }\n  </style>\n\n  <div class=\"eu-reviews-container\">\n    <div class=\"eu-reviews-header\">\n      <h2 style=\"font-size:28px; margin:0 0 6px;\">Customer Reviews</h2>\n      <p style=\"color:#6b7280; margin:0;\">Rated <strong>4.8/5</strong> by 1,356 customers</p>\n    </div>\n\n    {% assign reviews = \"\nAmelia Stone|5|So soft and warm, I wear them every evening after work. Perfect for cozy nights in.;\nRavi Patel|5|These wool socks are amazing. My feet stay warm all day without feeling sweaty.;\nChloe Barker|5|Bought a few pairs for my family and everyone loves them. Super comfy!;\nHassan Ali|4|Really nice and warm, but I wish they dried a bit faster after washing.;\nEmma White|5|Perfect for cold mornings. My toes are finally warm again!;\nGeorge Miller|5|Love these socks. They feel thick but breathable at the same time.;\nAisha Khan|5|They remind me of home in winter. So soft and cozy.;\nLiam Foster|5|Absolutely brilliant. My wife keeps stealing mine!;\nOlivia Brown|5|Lovely quality, the wool feels premium. Perfect with my boots.;\nJack Turner|4|Very warm, but I’d love a few more colour options.;\nPriya Sharma|5|Wore them during our family movie night. Everyone wanted a pair!;\nMason Green|5|These socks make my cold floors feel like heaven.;\nElla Knight|5|I never realised socks could be this comfortable.;\nBen Cooper|5|Bought them for my mum, now I’m getting a few for myself too.;\nSophia James|5|Keep my feet warm even in freezing weather. Highly recommend.;\nMohamed Noor|5|Soft, thick, and perfect for winter mornings.;\nGrace Howard|4|Comfy and warm, but a little snug at first. They stretch nicely though.;\nLeo Adams|5|Best socks I’ve bought this year. Feel like a hug for your feet.;\nLara Ahmed|5|They stay soft even after washing, great quality!;\nHarry Brooks|5|Perfect for boots and lounging at home. Super cozy.;\nCharlotte Wood|5|Warm, comfy, and stylish. I’ve been wearing them nonstop.;\nArjun Mehta|5|They keep my feet warm all night. Great for cold flats.;\nLucy Hill|5|Such a comforting feeling wearing these around the house.;\nEthan Johnson|5|Bought two pairs for me and my girlfriend. We both love them!;\nMia Lopez|5|Very cozy, they make winter mornings bearable.;\nIsabelle Reid|5|Soft wool and lovely knit. Great for wearing at home.;\nTom Parker|5|Exactly what I needed for cold nights. Feels luxurious.;\nZara Karim|5|Perfect thickness. Warm but not heavy, ideal balance.;\nOliver Grant|5|Honestly the comfiest socks I’ve ever owned.;\nHolly Barnes|5|Got them as a gift and now I can’t stop wearing them!;\nLucas Shaw|4|Good quality socks, warm but took a while to arrive.;\nSana Hussain|5|Wore them during our family gathering, everyone asked where I got them!;\nNoah King|5|They’re thick and warm without being too tight. Love them!;\nLily Davies|5|Lovely socks for wearing around the house. Great for winter!;\nMarcus Evans|5|My feet used to get cold even indoors, but not anymore!;\nHannah O’Brien|5|These socks make the house feel warmer somehow!;\nImran Youssef|5|Excellent wool quality. Keeps my feet warm for hours.;\nRuby Collins|5|Comfy and cute. I wear them with boots and they look great.;\nDaniel Carter|5|They make winter mornings so much easier to handle.;\nElena Novak|5|Bought them for my husband and now I need my own pair!;\nTheo Wells|5|Super soft, thick, and just the right height for boots.;\nSophie Green|5|They make cold days feel much more comfortable.;\nKhalid Rahman|4|Nice and cozy but wish they came in more colours.;\nElla Price|5|My kids keep stealing mine. That says it all!;\nJason Clarke|5|Warmest socks I’ve ever tried. Perfect for British winters.;\nAnanya Joshi|5|So soft and comfortable. Makes tea time even cozier!;\nAbigail Moore|5|Bought them for Christmas but ended up keeping them for myself.;\nCallum Harris|5|I wear them every day at home now. Couldn’t be happier.;\nNadia Petrov|5|Beautiful texture and warmth. Feels like a hug for your feet.;\nJacob Lewis|5|Perfect gift idea. Everyone I gave them to loved them!;\nAmina Farouk|5|Really nice quality and they stay warm even in cold houses.;\n\" | split: \";\" %}\n\n\n    <div id=\"eu-reviews-grid\" class=\"eu-reviews-grid\">\n      {% for r in reviews %}\n        {% assign parts = r | split: \"|\" %}\n        {% assign name = parts[0] | strip %}\n        {% assign rating = parts[1] | strip | plus: 0 %}\n        {% assign text = parts[2] | strip %}\n        {% if name != \"\" %}\n        <article class=\"eu-review-card\" style=\"display:none;\">\n          <div class=\"eu-review-top\">\n            <div class=\"eu-avatar\">{{ name | slice: 0, 1 }}</div>\n            <div>\n              <p class=\"eu-review-name\">{{ name }}</p>\n              <p class=\"eu-verified\">Verified Buyer</p>\n            </div>\n          </div>\n          <div class=\"eu-stars\">\n            {% for i in (1..5) %}\n              {% if i <= rating %}\n                <svg class=\"eu-star-filled\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% else %}\n                <svg class=\"eu-star-empty\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% endif %}\n            {% endfor %}\n          </div>\n          <p class=\"eu-review-text\">“{{ text }}”</p>\n        </article>\n        {% endif %}\n      {% endfor %}\n    </div>\n\n    <div class=\"eu-loadmore-wrap\">\n      <button id=\"eu-loadmore-btn\" class=\"eu-loadmore-btn\">Load More Reviews</button>\n    </div>\n\n    <div class=\"eu-write-review\">\n      <h3>Write a Review</h3>\n      <form id=\"review-form\">\n        <input type=\"text\" name=\"name\" placeholder=\"Your Name\" required>\n        <select name=\"rating\" required>\n          <option value=\"\">Rating</option>\n          <option value=\"5\">★★★★★ - Excellent</option>\n          <option value=\"4\">★★★★☆ - Good</option>\n          <option value=\"3\">★★★☆☆ - Average</option>\n          <option value=\"2\">★★☆☆☆ - Poor</option>\n          <option value=\"1\">★☆☆☆☆ - Terrible</option>\n        </select>\n        <textarea name=\"review\" rows=\"4\" placeholder=\"Share your experience...\" required></textarea>\n        <button type=\"submit\">Submit Review</button>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function(){\n      var reviews = document.querySelectorAll(\"#eu-reviews-grid .eu-review-card\");\n      var btn = document.getElementById(\"eu-loadmore-btn\");\n      var perPage = 6; \n      var shown = 0;\n\n      function showMore(){\n        for(var i=shown; i<shown+perPage && i<reviews.length; i++){\n          reviews[i].style.display = \"flex\";\n        }\n        shown += perPage;\n        if(shown >= reviews.length){\n          btn.style.display = \"none\";\n        }\n      }\n      showMore(); \n      btn.addEventListener(\"click\", showMore);\n\n      document.getElementById(\"review-form\").addEventListener(\"submit\", function(e){\n        e.preventDefault();\n        alert(\"Thank you for your review! It will appear once approved.\");\n        this.reset();\n      });\n    });\n  </script>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "featured_collection_FmTq4x": {
      "type": "featured-collection",
      "disabled": true,
      "name": "t:sections.featured-collection.presets.name",
      "settings": {
