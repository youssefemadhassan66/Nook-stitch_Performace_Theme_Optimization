      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "comfort",
      "name": "Anatomy point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Toe comfort"
        },
        {
          "type": "textarea",
