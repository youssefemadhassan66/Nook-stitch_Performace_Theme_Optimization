      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1F1D24"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active accent",
      "default": "#157A5B"
