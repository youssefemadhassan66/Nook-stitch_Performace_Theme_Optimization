{%- liquid
  assign s = section.settings
-%}

<section
  class="home-reviews color-{{ s.color_scheme }} gradient"
  style="
    --hr-bg: {{ s.background_color }};
    --hr-surface: {{ s.surface_color }};
    --hr-ink: {{ s.text_color }};
    --hr-accent: {{ s.accent_color }};
    --hr-muted: {{ s.muted_color }};
    --hr-cols: {{ s.columns_desktop }};
    --hr-padding-top: {{ s.padding_top }}px;
    --hr-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="page-width">
    <header class="home-reviews__head">
      {%- if s.kicker != blank -%}
        <p class="home-reviews__kicker">{{ s.kicker | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="home-reviews__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.show_trust_bar -%}
        <div class="home-reviews__trust">
          <span class="home-reviews__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg class="home-reviews__star{% if i > s.trust_stars %} is-empty{% endif %}" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="m3.488 13.184 6.272 6.112-1.472 8.608 7.712-4.064 7.712 4.064-1.472-8.608 6.272-6.112-8.64-1.248-3.872-7.808-3.872 7.808z"/></svg>
            {%- endfor -%}
          </span>
          {%- if s.trust_rating != blank -%}
            <span class="home-reviews__trust-score">{{ s.trust_rating | escape }}</span>
          {%- endif -%}
          {%- if s.trust_text != blank -%}
            <span class="home-reviews__trust-text">{{ s.trust_text | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="home-reviews__marquee" tabindex="0" aria-label="Customer reviews">
        <div class="home-reviews__row home-reviews__row--left">
          <div class="home-reviews__rail">
            <ul class="home-reviews__strip" role="list">
              {%- for block in section.blocks -%}
                {%- assign initial = block.settings.author | strip | slice: 0 -%}
                <li class="home-reviews__slide" {{ block.shopify_attributes }}>
                  <article class="home-reviews__card">
                    <span class="home-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        <svg class="home-reviews__star{% if i > block.settings.rating %} is-empty{% endif %}" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="m3.488 13.184 6.272 6.112-1.472 8.608 7.712-4.064 7.712 4.064-1.472-8.608 6.272-6.112-8.64-1.248-3.872-7.808-3.872 7.808z"/></svg>
                      {%- endfor -%}
                    </span>

                    {%- if block.settings.quote != blank -%}
                      <blockquote class="home-reviews__quote">{{ block.settings.quote | escape | newline_to_br }}</blockquote>
                    {%- endif -%}

                    <div class="home-reviews__author">
                      {%- if initial != blank -%}
                        <span class="home-reviews__avatar" aria-hidden="true">{{ initial }}</span>
                      {%- endif -%}
                      <div class="home-reviews__author-meta">
                        {%- if block.settings.author != blank -%}
                          <p class="home-reviews__name">{{ block.settings.author | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.meta != blank or block.settings.verified -%}
                          <p class="home-reviews__meta">
                            {{- block.settings.meta | escape -}}
                            {%- if block.settings.meta != blank and block.settings.verified %} &middot; {% endif -%}
                            {%- if block.settings.verified -%}<span class="home-reviews__verified">Verified</span>{%- endif -%}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                  </article>
                </li>
              {%- endfor -%}
            </ul>

            <ul class="home-reviews__strip" role="list" aria-hidden="true">
              {%- for block in section.blocks -%}
                {%- assign initial = block.settings.author | strip | slice: 0 -%}
                <li class="home-reviews__slide">
                  <article class="home-reviews__card">
                    <span class="home-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        <svg class="home-reviews__star{% if i > block.settings.rating %} is-empty{% endif %}" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="m3.488 13.184 6.272 6.112-1.472 8.608 7.712-4.064 7.712 4.064-1.472-8.608 6.272-6.112-8.64-1.248-3.872-7.808-3.872 7.808z"/></svg>
                      {%- endfor -%}
                    </span>

                    {%- if block.settings.quote != blank -%}
                      <blockquote class="home-reviews__quote">{{ block.settings.quote | escape | newline_to_br }}</blockquote>
                    {%- endif -%}

                    <div class="home-reviews__author">
                      {%- if initial != blank -%}
                        <span class="home-reviews__avatar" aria-hidden="true">{{ initial }}</span>
                      {%- endif -%}
                      <div class="home-reviews__author-meta">
                        {%- if block.settings.author != blank -%}
                          <p class="home-reviews__name">{{ block.settings.author | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.meta != blank or block.settings.verified -%}
                          <p class="home-reviews__meta">
                            {{- block.settings.meta | escape -}}
                            {%- if block.settings.meta != blank and block.settings.verified %} &middot; {% endif -%}
                            {%- if block.settings.verified -%}<span class="home-reviews__verified">Verified</span>{%- endif -%}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                  </article>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>

        <div class="home-reviews__row home-reviews__row--right" aria-hidden="true">
          <div class="home-reviews__rail">
            <ul class="home-reviews__strip" role="list">
              {%- for block in section.blocks reversed -%}
                {%- assign initial = block.settings.author | strip | slice: 0 -%}
                <li class="home-reviews__slide">
                  <article class="home-reviews__card">
                    <span class="home-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        <svg class="home-reviews__star{% if i > block.settings.rating %} is-empty{% endif %}" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="m3.488 13.184 6.272 6.112-1.472 8.608 7.712-4.064 7.712 4.064-1.472-8.608 6.272-6.112-8.64-1.248-3.872-7.808-3.872 7.808z"/></svg>
                      {%- endfor -%}
                    </span>

                    {%- if block.settings.quote != blank -%}
                      <blockquote class="home-reviews__quote">{{ block.settings.quote | escape | newline_to_br }}</blockquote>
                    {%- endif -%}

                    <div class="home-reviews__author">
                      {%- if initial != blank -%}
                        <span class="home-reviews__avatar" aria-hidden="true">{{ initial }}</span>
                      {%- endif -%}
                      <div class="home-reviews__author-meta">
                        {%- if block.settings.author != blank -%}
                          <p class="home-reviews__name">{{ block.settings.author | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.meta != blank or block.settings.verified -%}
                          <p class="home-reviews__meta">
                            {{- block.settings.meta | escape -}}
                            {%- if block.settings.meta != blank and block.settings.verified %} &middot; {% endif -%}
                            {%- if block.settings.verified -%}<span class="home-reviews__verified">Verified</span>{%- endif -%}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                  </article>
                </li>
              {%- endfor -%}
            </ul>

            <ul class="home-reviews__strip" role="list">
              {%- for block in section.blocks reversed -%}
                {%- assign initial = block.settings.author | strip | slice: 0 -%}
                <li class="home-reviews__slide">
                  <article class="home-reviews__card">
                    <span class="home-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        <svg class="home-reviews__star{% if i > block.settings.rating %} is-empty{% endif %}" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="m3.488 13.184 6.272 6.112-1.472 8.608 7.712-4.064 7.712 4.064-1.472-8.608 6.272-6.112-8.64-1.248-3.872-7.808-3.872 7.808z"/></svg>
                      {%- endfor -%}
                    </span>

                    {%- if block.settings.quote != blank -%}
                      <blockquote class="home-reviews__quote">{{ block.settings.quote | escape | newline_to_br }}</blockquote>
                    {%- endif -%}

                    <div class="home-reviews__author">
                      {%- if initial != blank -%}
                        <span class="home-reviews__avatar" aria-hidden="true">{{ initial }}</span>
                      {%- endif -%}
                      <div class="home-reviews__author-meta">
                        {%- if block.settings.author != blank -%}
                          <p class="home-reviews__name">{{ block.settings.author | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.meta != blank or block.settings.verified -%}
                          <p class="home-reviews__meta">
                            {{- block.settings.meta | escape -}}
                            {%- if block.settings.meta != blank and block.settings.verified %} &middot; {% endif -%}
                            {%- if block.settings.verified -%}<span class="home-reviews__verified">Verified</span>{%- endif -%}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                  </article>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .home-reviews {
    padding-block: var(--hr-padding-top, 84px) var(--hr-padding-bottom, 84px);
    background: var(--hr-bg, #FFFFFF);
    color: var(--hr-ink, #1F1D24);
  }

  .home-reviews__head {
    max-width: 64rem;
    margin: 0 auto clamp(3rem, 2rem + 2vw, 4.8rem);
    text-align: center;
  }

  .home-reviews__kicker {
    margin: 0 0 1.2rem;
    color: var(--hr-muted, #8A8A8A);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-reviews__heading {
    margin: 0;
    color: var(--hr-ink, #1F1D24);
    font-size: clamp(3rem, 2.2rem + 2.4vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .home-reviews__trust {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1.8rem;
  }

  .home-reviews__trust-score {
    color: var(--hr-ink, #1F1D24);
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1;
  }

  .home-reviews__trust-text {
    color: var(--hr-muted, #8A8A8A);
    font-size: 1.5rem;
  }

  /* Stars */
  .home-reviews__stars {
    display: inline-flex;
    gap: 0.3rem;
    line-height: 0;
  }

  .home-reviews__star {
    width: 1.8rem;
    height: 1.8rem;
    fill: var(--hr-accent, #157A5B);
    flex-shrink: 0;
  }

  .home-reviews__star.is-empty {
    fill: color-mix(in srgb, var(--hr-ink, #1F1D24) 16%, transparent);
  }

  .home-reviews__marquee {
    --hr-card-gap: clamp(1.6rem, 1.1rem + 1vw, 2.4rem);
    --hr-card-width: clamp(36rem, 30vw, 43rem);
    overflow: hidden;
    max-width: 100%;
    padding: 0.6rem 0 1rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .home-reviews__marquee:focus-visible {
    outline: 2px solid var(--hr-accent, #157A5B);
    outline-offset: 0.6rem;
  }

  .home-reviews__row {
    max-width: 100%;
  }

  .home-reviews__row + .home-reviews__row {
    margin-top: clamp(1.4rem, 1rem + 1vw, 2.2rem);
  }

  .home-reviews__rail {
    display: flex;
    width: max-content;
    gap: var(--hr-card-gap);
    will-change: transform;
  }

  .home-reviews__row--left .home-reviews__rail {
    animation: home-reviews-marquee-left 58s linear infinite;
  }

  .home-reviews__row--right .home-reviews__rail {
    animation: home-reviews-marquee-right 64s linear infinite;
  }

  .home-reviews__marquee:hover .home-reviews__rail,
  .home-reviews__marquee:focus-within .home-reviews__rail {
    animation-play-state: paused;
  }

  .home-reviews__strip {
    display: flex;
    flex: 0 0 auto;
    gap: var(--hr-card-gap);
    min-width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-reviews__slide {
    width: var(--hr-card-width);
    min-width: 0;
    flex: 0 0 var(--hr-card-width);
  }

  @keyframes home-reviews-marquee-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - (var(--hr-card-gap) / 2)), 0, 0);
    }
  }

  @keyframes home-reviews-marquee-right {
    from {
      transform: translate3d(calc(-50% - (var(--hr-card-gap) / 2)), 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Card */
  .home-reviews__card {
    display: flex;
    height: 100%;
    min-height: 23rem;
    flex-direction: column;
    gap: 1.6rem;
    padding: clamp(2rem, 1.4rem + 1vw, 2.8rem);
    border: 1px solid color-mix(in srgb, var(--hr-ink, #1F1D24) 12%, transparent);
    border-radius: var(--buttons-radius, 6px);
    background: var(--hr-surface, #FFFFFF);
    transition:
      border-color 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-reviews__card:hover {
    border-color: var(--hr-accent, #157A5B);
    box-shadow: 0 1.6rem 4rem color-mix(in srgb, var(--hr-ink, #1F1D24) 7%, transparent);
    transform: translateY(-2px);
  }

  .home-reviews__quote {
    margin: 0;
    color: var(--hr-ink, #1F1D24);
    font-size: clamp(1.6rem, 1.5rem + 0.3vw, 1.8rem);
    line-height: 1.55;
  }

  .home-reviews__author {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .home-reviews__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.2rem;
    height: 4.2rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--hr-accent, #157A5B) 14%, transparent);
    color: var(--hr-accent, #157A5B);
    font-family: var(--font-heading-family);
    font-size: 1.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .home-reviews__name {
    margin: 0;
    color: var(--hr-ink, #1F1D24);
    font-size: 1.55rem;
    font-weight: 600;
  }

  .home-reviews__meta {
    margin: 0.2rem 0 0;
    color: var(--hr-muted, #8A8A8A);
    font-size: 1.3rem;
  }

  .home-reviews__verified {
    color: var(--hr-accent, #157A5B);
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .home-reviews {
      padding-block: calc(var(--hr-padding-top, 84px) * 0.72) calc(var(--hr-padding-bottom, 84px) * 0.72);
    }

    .home-reviews__marquee {
      --hr-card-width: clamp(28rem, 84vw, 34rem);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 2.4rem, #000 calc(100% - 2.4rem), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 2.4rem, #000 calc(100% - 2.4rem), transparent);
    }

    .home-reviews__card {
      min-height: 24rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-reviews__marquee {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .home-reviews__row--right,
    .home-reviews__strip[aria-hidden="true"] {
      display: none;
    }

    .home-reviews__rail {
      display: block;
      width: auto;
      animation: none;
      transform: none;
      will-change: auto;
    }

    .home-reviews__strip {
      display: grid;
      width: min(100%, 92rem);
      min-width: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0 auto;
    }

    .home-reviews__slide {
      width: auto;
      flex: initial;
    }

    .home-reviews__card {
      transition: none;
    }

    .home-reviews__card:hover {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) and (prefers-reduced-motion: reduce) {
    .home-reviews__strip {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
