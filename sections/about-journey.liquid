{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="about-journey color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="about-journey__inner page-width">
    <header class="about-journey__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="about-journey__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="about-journey__intro rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ol class="about-journey__timeline" role="list">
        {%- for block in section.blocks -%}
          <li class="about-journey__milestone{% if forloop.even %} about-journey__milestone--reverse{% endif %}" {{ block.shopify_attributes }}>
            <div class="about-journey__copy">
              {%- if block.settings.label != blank -%}
                <p class="about-journey__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="about-journey__milestone-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="about-journey__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

            <div class="about-journey__axis" aria-hidden="true">
              <span class="about-journey__node">{{ forloop.index | prepend: '0' }}</span>
            </div>

            {%- if block.settings.note != blank -%}
              <div class="about-journey__note">
                <span class="about-journey__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'focus' -%}
                      <svg viewBox="0 0 32 32" fill="none">
                        <circle cx="14" cy="14" r="8.5"></circle>
                        <path d="m20.5 20.5 6 6M14 9.5v9M9.5 14h9"></path>
                      </svg>
                    {%- when 'feedback' -%}
                      <svg viewBox="0 0 32 32" fill="none">
                        <path d="M6.5 7.5h19v14h-9l-5.5 4v-4H6.5v-14Z"></path>
                        <path d="M11 13h10M11 17h7"></path>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 32 32" fill="none">
                        <path d="M11 5.5v7l-5 9a3.5 3.5 0 0 0 3.1 5h13.8a3.5 3.5 0 0 0 3.1-5l-5-9v-7"></path>
                        <path d="M9 5.5h14M10 19h12"></path>
                      </svg>
                  {%- endcase -%}
                </span>
                <span>{{ block.settings.note | escape }}</span>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .about-journey {
    --journey-accent: rgb(var(--color-button));
    --journey-ink: rgb(var(--color-foreground));
    overflow: hidden;
  }

  .about-journey__inner {
    max-width: 124rem;
  }

  .about-journey__header {
    max-width: 72rem;
    margin: 0 auto 7.2rem;
    text-align: center;
  }

  .about-journey__heading {
    margin: 0;
    color: var(--journey-ink);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: clamp(3.4rem, 4vw, 5.2rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0;
    line-height: 1.1;
  }

  .about-journey__intro {
    max-width: 62rem;
    margin: 1.6rem auto 0;
    color: rgba(var(--color-foreground), 0.72);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 1.8rem;
    line-height: 1.6;
  }

  .about-journey__intro p {
    margin: 0;
  }

  .about-journey__timeline {
    position: relative;
    display: grid;
    max-width: 112rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .about-journey__timeline::before {
    content: "";
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 50%;
    width: 0.2rem;
    background: repeating-linear-gradient(
      to bottom,
      rgba(var(--color-foreground), 0.18) 0,
      rgba(var(--color-foreground), 0.18) 0.2rem,
      transparent 0.2rem,
      transparent 0.7rem
    );
    transform: translateX(-50%);
  }

  .about-journey__milestone {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8rem minmax(0, 1fr);
    min-height: 23rem;
    align-items: center;
  }

  .about-journey__copy {
    grid-column: 1;
    max-width: 46rem;
    justify-self: end;
    padding-right: 1.8rem;
    text-align: right;
  }

  .about-journey__axis {
    position: relative;
    z-index: 2;
    display: grid;
    grid-column: 2;
    place-items: center;
    align-self: stretch;
  }

  .about-journey__node {
    display: grid;
    width: 5.2rem;
    height: 5.2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.14);
    border-radius: 50%;
    background: rgb(var(--color-background));
    box-shadow: 0 1rem 2.8rem rgba(var(--color-foreground), 0.08);
    color: var(--journey-ink);
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1;
    place-items: center;
  }

  .about-journey__note {
    position: relative;
    display: grid;
    grid-column: 3;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 1.4rem;
    align-items: center;
    width: min(100%, 40rem);
    min-height: 8.2rem;
    padding: 1.6rem 2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.13);
    border-radius: 0.6rem;
    background: rgba(var(--color-background), 0.86);
    color: var(--journey-ink);
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.45;
  }

  .about-journey__note::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 100%;
    width: 4rem;
    height: 0.2rem;
    background: repeating-linear-gradient(
      to right,
      rgba(var(--color-foreground), 0.18) 0,
      rgba(var(--color-foreground), 0.18) 0.2rem,
      transparent 0.2rem,
      transparent 0.7rem
    );
  }

  .about-journey__icon {
    display: grid;
    color: var(--journey-accent);
    place-items: center;
  }

  .about-journey__icon svg {
    width: 3.2rem;
    height: 3.2rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .about-journey__label {
    margin: 0 0 0.6rem;
    color: var(--journey-accent);
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .about-journey__milestone-heading {
    margin: 0;
    color: var(--journey-ink);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: clamp(2.2rem, 2vw, 3rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0;
    line-height: 1.2;
  }

  .about-journey__text {
    margin-top: 1.2rem;
    color: rgba(var(--color-foreground), 0.74);
    font-family: var(--font-body-family);
    font-size: 1.7rem;
    line-height: 1.6;
  }

  .about-journey__text p {
    margin: 0;
  }

  .about-journey__milestone--reverse .about-journey__copy {
    grid-column: 3;
    justify-self: start;
    padding-right: 0;
    padding-left: 1.8rem;
    text-align: left;
  }

  .about-journey__milestone--reverse .about-journey__note {
    grid-column: 1;
    justify-self: end;
  }

  .about-journey__milestone--reverse .about-journey__note::before {
    right: auto;
    left: 100%;
  }

  @media screen and (max-width: 749px) {
    .about-journey__header {
      margin-bottom: 5rem;
      text-align: left;
    }

    .about-journey__heading {
      font-size: 3.2rem;
    }

    .about-journey__intro {
      margin-top: 1.2rem;
      font-size: 1.7rem;
    }

    .about-journey__timeline {
      gap: 4.8rem;
    }

    .about-journey__timeline::before {
      top: 0.8rem;
      bottom: 0.8rem;
      left: 2.5rem;
      transform: none;
    }

    .about-journey__milestone,
    .about-journey__milestone--reverse {
      grid-template-columns: 5rem minmax(0, 1fr);
      min-height: 0;
      align-items: start;
    }

    .about-journey__axis {
      grid-column: 1;
      grid-row: 1 / span 2;
      min-height: 100%;
      align-self: stretch;
    }

    .about-journey__node {
      width: 4.8rem;
      height: 4.8rem;
      margin-top: 0;
      align-self: start;
    }

    .about-journey__copy,
    .about-journey__milestone--reverse .about-journey__copy {
      grid-column: 2;
      grid-row: 1;
      max-width: none;
      justify-self: stretch;
      padding: 0 0 0 1.5rem;
      text-align: left;
    }

    .about-journey__note,
    .about-journey__milestone--reverse .about-journey__note {
      grid-column: 2;
      grid-row: 2;
      width: auto;
      min-height: 7.2rem;
      margin: 2.2rem 0 0 1.5rem;
      justify-self: stretch;
      padding: 1.4rem 1.6rem;
    }

    .about-journey__note::before,
    .about-journey__milestone--reverse .about-journey__note::before {
      top: 50%;
      right: 100%;
      left: auto;
      width: 1.5rem;
    }

    .about-journey__milestone-heading {
      font-size: 2.3rem;
    }

    .about-journey__text {
      font-size: 1.65rem;
      line-height: 1.55;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About journey",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A journey shaped by comfort"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>One product, refined through listening, testing, and the details feet notice every day.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Milestone label",
          "default": "The beginning"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "We started by listening"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Real comfort starts with understanding what feet need through long days.</p>"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Proof note",
          "default": "Comfort became the starting point"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Proof icon",
          "default": "prototype",
          "options": [
            {
              "value": "prototype",
              "label": "Prototype"
            },
            {
              "value": "focus",
              "label": "Product focus"
            },
            {
              "value": "feedback",
              "label": "Feedback"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About journey",
      "blocks": [
        {
          "type": "milestone"
        },
        {
          "type": "milestone"
        },
        {
          "type": "milestone"
        }
      ]
    }
  ]
}
{% endschema %}
