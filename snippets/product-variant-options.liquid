{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - is_size_option: {Boolean} renders size values as card labels. Default: false.


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
  %}
{% endcomment %}
{%- liquid
  assign variants_available_arr = product.variants | map: 'available'
  assign variants_option1_arr = product.variants | map: 'option1'
  assign variants_option2_arr = product.variants | map: 'option2'
  assign variants_option3_arr = product.variants | map: 'option3'

  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- liquid
    assign option_disabled = true
    assign size_label = value
    assign size_hint = blank

    if is_size_option
      assign size_label = value | split: '(' | first | strip
      assign size_key = size_label | downcase | strip
      assign size_parts = value | split: '('

      if size_parts.size > 1
        assign raw_size_range = size_parts[1] | remove: ')' | strip
        assign size_hint = 'US ' | append: raw_size_range
      endif

      case size_key
        when 's'
          assign size_hint = 'US 6-10'
        when 'm'
          assign size_hint = 'US 10-14'
        when 'l'
          assign size_hint = 'US 14-17'
      endcase
    endif

    for option1_name in variants_option1_arr
      case option.position
        when 1
          if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
          endif
        when 2
          if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
          endif
        when 3
          if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
          endif
      endcase
    endfor
  -%}

  {%- if block.settings.picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
      name="{{ option.name }}"
      value="{{ value | escape }}"
      form="{{ product_form_id }}"
      {% if option.selected_value == value %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled"
      {% endif %}
    >
    <label
      for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
      {% if is_size_option %}
        class="product-form__size-card"
        data-size-selector="{{ section.id }}-{{ option.position }}"
        data-size-display="{{ size_label | escape }}"
      {% endif %}
    >
      {%- if is_size_option -%}
        <span class="product-form__size-card-label">{{ size_label | escape }}</span>
        {%- if size_hint != blank -%}
          <span class="product-form__size-card-range">{{ size_hint }}</span>
        {%- endif -%}
      {%- else -%}
        {{ value -}}
      {%- endif -%}
      <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
    </label>
  {%- elsif block.settings.picker_type == 'dropdown' -%}
    <option
      value="{{ value | escape }}"
      {% if option.selected_value == value %}
        selected="selected"
      {% endif %}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}

{%- if block.settings.picker_type == 'button' and is_size_option -%}
  <script>
    (() => {
      const selectedSize = document.getElementById('selected-{{ option.name | downcase | replace: ' ', '-' }}');
      if (!selectedSize) return;

      document.querySelectorAll('[data-size-selector="{{ section.id }}-{{ option.position }}"]').forEach((label) => {
        label.addEventListener('click', () => {
          selectedSize.textContent = ` ${label.getAttribute('data-size-display') || ''}`;
        });
      });
    })();
  </script>
{%- endif -%}
