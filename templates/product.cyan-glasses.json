        "text_wGgTQB": {
          "type": "text",
          "settings": {
            "text": "<p>1. <strong>Download the HeyCyan App</strong></p><ul><li>Available on iOS & Android</li><li>Look for the blue glasses icon</li></ul><p>2. <strong>Connect via Bluetooth</strong></p><ul><li>Turn on your glasses</li><li>Open the app and pair your device</li></ul><p></p><p>3. <strong>Choose Your Mode</strong></p><ul><li><strong>Photo</strong> 📷</li><li><strong>Video</strong> 🎥</li><li><strong>Audio</strong> 🎧</li><li><strong>Music</strong> 🎵</li></ul><p>Use voice command or touch controls to switch between modes easily.</p>",
