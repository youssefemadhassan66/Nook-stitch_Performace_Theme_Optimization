        "review_GmmgYq": {
          "type": "review",
          "settings": {
            "star_rating": 5,
            "name_text": "Biff2u",
            "date_text": "June 2024",
            "review_head": "Nice Product",
            "review_text": "I saw this recommended on YouTube, and so I ordered and was not let down. This is very well constructed. Feels like a firearm. Has a USB c quick charger and came with a bunch of brushes for brushing something. Has a powerful flashlight with strobe on the handle and one in the tip of the blower so you can see the look on peoples faces when they are hit with gailforce wind. I don't recommend pointing it at faces like I did. This is jet style air force that is equal or better than the blower on my compressor. This is a must-have for anyone who must have cool things. This is full of potential",
            "like_size": 0,
            "dislike_size": 0,
            "feature_font_size": 16
          }
        },
        "review_FJKnGJ": {
          "type": "review",
          "settings": {
            "star_rating": 5,
            "name_text": "Hardik",
            "date_text": "June 2024",
            "review_head": "",
            "review_text": "Nice pressure. Pretty useful to clean hard to reach surfaces. My girlfriend has been using it for the corners and I clean car for my cats hair and seems like to work like a charm. Not much noise and definitely a worth product.",
            "like_size": 0,
            "dislike_size": 0,
            "feature_font_size": 16
          }
        }
