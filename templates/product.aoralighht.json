    "custom_liquid_MweP6P": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"eu-reviews-section\">\n  <style>\n    .eu-reviews-section { background:#f7fafc; padding:48px 0; font-family:-apple-system, BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial; }\n    .eu-reviews-container{ max-width:1100px; margin:0 auto; padding:0 20px; }\n    .eu-reviews-header{ text-align:center; margin-bottom:28px; }\n    .eu-reviews-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; }\n    .eu-review-card{ background:#fff; border-radius:18px; padding:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); display:flex; flex-direction:column; min-height:160px; }\n    .eu-review-top{ display:flex; align-items:center; margin-bottom:10px; }\n    .eu-avatar{ width:44px; height:44px; border-radius:50%; background:#e6e6e6; display:flex; align-items:center; justify-content:center; font-weight:700; color:#374151; margin-right:12px; }\n    .eu-review-name{ font-weight:600; margin:0; }\n    .eu-verified{ font-size:13px; color:#6b7280; margin:0; }\n    .eu-stars{ display:flex; gap:4px; margin-bottom:8px; }\n    .eu-review-text{ color:#374151; margin-top:auto; }\n    .eu-star-filled{ fill:#FBBF24; }\n    .eu-star-empty{ fill:#E5E7EB; }\n    .eu-loadmore-wrap{ text-align:center; margin-top:30px; }\n    .eu-loadmore-btn{ background:#111827; color:#fff; padding:12px 22px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-loadmore-btn:hover{ background:#374151; }\n    .eu-write-review{ margin-top:50px; padding:28px; background:#fff; border-radius:18px; box-shadow:0 4px 14px rgba(16,24,40,0.06); }\n    .eu-write-review h3{ margin:0 0 14px; font-size:22px; }\n    .eu-write-review input, .eu-write-review textarea, .eu-write-review select { width:100%; padding:10px; margin-bottom:12px; border:1px solid #d1d5db; border-radius:8px; }\n    .eu-write-review button{ background:#111827; color:#fff; padding:12px 20px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .eu-write-review button:hover{ background:#374151; }\n  </style>\n\n  <div class=\"eu-reviews-container\">\n    <div class=\"eu-reviews-header\">\n      <h2 style=\"font-size:28px; margin:0 0 6px;\">Customer Reviews</h2>\n      <p style=\"color:#6b7280; margin:0;\">Rated <strong>4.8/5</strong> by 1,356 customers</p>\n    </div>\n\n    {% assign reviews = \"\nEmily Johnson|5|These AoraLights changed my nights. No more harsh lights when I get up, just a soft glow. Love them!;\nMichael Smith|5|Bought 6 for my house. Now every hallway and room feels cozy and safe.;\nOlivia Brown|5|Stylish and practical. They blend perfectly with my décor.;\nJames Wilson|4|Great light, though I wish it had more color options. Still very useful!;\nSophie Taylor|5|The dusk-to-dawn sensor works like magic. I never touch a switch anymore.;\nDaniel Miller|5|I ordered 4 and now I want more. Perfect for bedrooms and living room!;\nCharlotte Davis|5|The glow is soft but bright enough to see clearly at night. Perfect balance.;\nBenjamin Moore|5|Super energy efficient. My bills are lower since I stopped leaving big lights on.;\nAmelia Thomas|5|I bought 8 to cover the whole house. Now I never stumble at night!;\nMatthew White|4|Good product, but shipping took a bit longer than expected. Worth the wait.;\nGrace Harris|5|Love how modern they look. Guests always ask me where I got them.;\nJoshua Lewis|5|One of the best purchases I made this year. Cozy and safe at night.;\nChloe Hall|5|Great quality, small but powerful. I use them in every room.;\nEthan Walker|5|Perfect for kids’ rooms. My children sleep better with the soft glow.;\nIsla Scott|5|I can’t imagine living without them now. Ordered 6 and they’re amazing.;\nJack Green|5|The auto sensor is very accurate. Lights up exactly when I need it.;\nElla King|5|Makes my home feel like a hotel. The vibe is just so cozy.;\nHenry Adams|5|No more tripping at night! These lights saved me more than once.;\nMia Wright|4|Very good, but I wish they were slightly brighter. Still works well.;\nLucas Turner|5|I bought 3 at first, then immediately ordered 5 more. Totally worth it!;\nJessica Carter|5|Perfect for hallways. They look sleek and don’t stick out like other night lights.;\nWilliam Evans|5|Super easy to use. Just plug and forget. Zero hassle.;\nLily Baker|5|Love the warm glow. It makes the room feel instantly cozy.;\nSamuel Roberts|5|I feel safer moving around at night with these lights on.;\nAva Mitchell|5|They turn on automatically right at dusk. Perfect timing every day.;\nGeorge Parker|5|Got a pack for my parents’ house too. They love it!;\nSophia Edwards|4|Nice light, but one arrived slightly scratched. Customer service replaced it quickly.;\nLeo Collins|5|The design is minimal and beautiful. Fits in any room.;\nHarper Morris|5|Very practical. I don’t worry about my kids running around in the dark anymore.;\nAlexander Ward|5|The glow is calming. It helps me sleep better too.;\nIsabella Hughes|5|Excellent product. I recommend buying at least 4 for the whole house.;\nJacob Foster|5|So much better than ugly old night lamps. These look premium.;\nScarlett Howard|5|Bought 6 and spread them across the house. Every corner looks amazing.;\nOliver Ross|5|The light is soft, elegant, and energy-saving. Couldn’t ask for better.;\nEmily Price|5|Very well made. Feels durable and high-quality.;\nNoah Bennett|4|The brightness is good but I would love adjustable color. Still happy overall.;\nFreya Phillips|5|Exactly what I needed. Hallways feel safe and warm at night.;\nThomas Gray|5|The kids are no longer scared at night. Best gift I bought for my family.;\nHolly Cooper|5|I was skeptical but now I’m obsessed. Already ordered more!;\nJoseph Kelly|5|Beautiful glow, saves energy, and looks amazing. 10/10!;\nAbigail Wood|5|Everyone who visits my home compliments these lights. Love them!;\n\" | split: \";\" %}\n\n\n\n    <div id=\"eu-reviews-grid\" class=\"eu-reviews-grid\">\n      {% for r in reviews %}\n        {% assign parts = r | split: \"|\" %}\n        {% assign name = parts[0] | strip %}\n        {% assign rating = parts[1] | strip | plus: 0 %}\n        {% assign text = parts[2] | strip %}\n        {% if name != \"\" %}\n        <article class=\"eu-review-card\" style=\"display:none;\">\n          <div class=\"eu-review-top\">\n            <div class=\"eu-avatar\">{{ name | slice: 0, 1 }}</div>\n            <div>\n              <p class=\"eu-review-name\">{{ name }}</p>\n              <p class=\"eu-verified\">Verified Buyer</p>\n            </div>\n          </div>\n          <div class=\"eu-stars\">\n            {% for i in (1..5) %}\n              {% if i <= rating %}\n                <svg class=\"eu-star-filled\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% else %}\n                <svg class=\"eu-star-empty\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% endif %}\n            {% endfor %}\n          </div>\n          <p class=\"eu-review-text\">“{{ text }}”</p>\n        </article>\n        {% endif %}\n      {% endfor %}\n    </div>\n\n    <div class=\"eu-loadmore-wrap\">\n      <button id=\"eu-loadmore-btn\" class=\"eu-loadmore-btn\">Load More Reviews</button>\n    </div>\n\n    <div class=\"eu-write-review\">\n      <h3>Write a Review</h3>\n      <form id=\"review-form\">\n        <input type=\"text\" name=\"name\" placeholder=\"Your Name\" required>\n        <select name=\"rating\" required>\n          <option value=\"\">Rating</option>\n          <option value=\"5\">★★★★★ - Excellent</option>\n          <option value=\"4\">★★★★☆ - Good</option>\n          <option value=\"3\">★★★☆☆ - Average</option>\n          <option value=\"2\">★★☆☆☆ - Poor</option>\n          <option value=\"1\">★☆☆☆☆ - Terrible</option>\n        </select>\n        <textarea name=\"review\" rows=\"4\" placeholder=\"Share your experience...\" required></textarea>\n        <button type=\"submit\">Submit Review</button>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function(){\n      var reviews = document.querySelectorAll(\"#eu-reviews-grid .eu-review-card\");\n      var btn = document.getElementById(\"eu-loadmore-btn\");\n      var perPage = 6; \n      var shown = 0;\n\n      function showMore(){\n        for(var i=shown; i<shown+perPage && i<reviews.length; i++){\n          reviews[i].style.display = \"flex\";\n        }\n        shown += perPage;\n        if(shown >= reviews.length){\n          btn.style.display = \"none\";\n        }\n      }\n      showMore(); \n      btn.addEventListener(\"click\", showMore);\n\n      document.getElementById(\"review-form\").addEventListener(\"submit\", function(e){\n        e.preventDefault();\n        alert(\"Thank you for your review! It will appear once approved.\");\n        this.reset();\n      });\n    });\n  </script>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
