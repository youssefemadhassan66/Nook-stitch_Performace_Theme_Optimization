{%- liquid
  assign s = section.settings
-%}

<section
  id="FeelStoryHero-{{ section.id }}"
  class="feel-story-hero gradient color-{{ s.color_scheme }}"
  style="
    --feel-story-accent: {{ s.accent_color }};
    --feel-story-shadow: {{ s.heading_shadow_color }};
    --feel-story-note-bg: {{ s.note_background }};
  "
>
  <div class="feel-story-hero__inner page-width">
    <article class="feel-story-hero__content">
      {%- if s.heading != blank -%}
        <h1 class="feel-story-hero__heading">{{ s.heading | escape }}</h1>
      {%- endif -%}

      {%- if s.lede != blank -%}
        <p class="feel-story-hero__lede">{{ s.lede | escape }}</p>
      {%- endif -%}

      {%- if s.body != blank -%}
        <div class="feel-story-hero__body rte">{{ s.body }}</div>
      {%- endif -%}

      {%- if s.summary != blank -%}
        <div class="feel-story-hero__summary rte">{{ s.summary }}</div>
      {%- endif -%}

      {%- if s.note != blank -%}
        <div class="feel-story-hero__note rte">{{ s.note }}</div>
      {%- endif -%}
    </article>
  </div>
</section>

{%- style -%}
  #FeelStoryHero-{{ section.id }} {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__inner {
    display: flex;
    justify-content: center;
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__content {
    width: min(100%, 78rem);
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__heading {
    max-width: 76rem;
    margin: 0;
    color: rgb(var(--color-foreground));
    font-family: Poppins, var(--font-heading-family), Arial, sans-serif;
    font-size: clamp(3.2rem, 3.1vw, 5rem);
    font-style: var(--font-heading-style);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.16;
    text-shadow: 2px 2px 0 var(--feel-story-shadow);
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__lede {
    margin: 26px 0 0;
    color: rgb(var(--color-foreground));
    font-size: clamp(1.45rem, 0.92vw, 1.6rem);
    font-weight: 600;
    line-height: 1.46;
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__body,
  #FeelStoryHero-{{ section.id }} .feel-story-hero__summary {
    margin-top: 28px;
    color: rgb(var(--color-foreground));
    font-size: clamp(1.45rem, 0.92vw, 1.58rem);
    line-height: 1.52;
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__body p,
  #FeelStoryHero-{{ section.id }} .feel-story-hero__summary p,
  #FeelStoryHero-{{ section.id }} .feel-story-hero__note p {
    margin: 0;
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__body p + p,
  #FeelStoryHero-{{ section.id }} .feel-story-hero__summary p + p {
    margin-top: 18px;
  }

  #FeelStoryHero-{{ section.id }} strong {
    color: rgb(var(--color-foreground));
    font-weight: 800;
  }

  #FeelStoryHero-{{ section.id }} .feel-story-hero__note {
    width: min(100%, 52rem);
    margin-top: 22px;
    padding: 15px 18px;
    border-left: 3px solid var(--feel-story-accent);
    background: var(--feel-story-note-bg);
    color: rgb(var(--color-foreground));
    font-size: 1.26rem;
    font-weight: 600;
    line-height: 1.45;
  }

  @media screen and (min-width: 750px) {
    #FeelStoryHero-{{ section.id }} .feel-story-hero__inner {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #FeelStoryHero-{{ section.id }} .feel-story-hero__inner {
      justify-content: flex-start;
    }

    #FeelStoryHero-{{ section.id }} .feel-story-hero__heading {
      font-size: clamp(3rem, 9.5vw, 4.2rem);
      text-shadow: 1.5px 1.5px 0 var(--feel-story-shadow);
    }

    #FeelStoryHero-{{ section.id }} .feel-story-hero__lede {
      margin-top: 22px;
      font-size: 1.38rem;
      line-height: 1.44;
    }

    #FeelStoryHero-{{ section.id }} .feel-story-hero__body,
    #FeelStoryHero-{{ section.id }} .feel-story-hero__summary {
      margin-top: 24px;
      font-size: 1.38rem;
      line-height: 1.5;
    }

    #FeelStoryHero-{{ section.id }} .feel-story-hero__note {
      width: 100%;
      padding: 14px 16px;
      font-size: 1.22rem;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Feel story hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "I Tried 5 Different 'Comfort' Socks. Only One Actually Worked."
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Intro line",
      "default": "Let me save you the time and money I wasted."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Over the past few years, I tried cheap cotton socks, bulky compression pairs, seamless diabetic socks, cushioned athletic socks, and finally, a pair designed around real orthopedic support.</p>"
    },
    {
      "type": "richtext",
      "id": "summary",
      "label": "Summary",
      "default": "<p><strong>Four misses. One clear winner.</strong> Here's the difference:</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note",
      "default": "<p><strong>Note:</strong> Read this before you struggle with another uncomfortable pair of socks.</p>"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#157A5B"
    },
    {
      "type": "color",
      "id": "heading_shadow_color",
      "label": "Heading shadow color",
      "default": "#CFE0D2"
    },
    {
      "type": "color",
      "id": "note_background",
      "label": "Note background",
      "default": "#ECF3EA"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Feel story hero"
    }
  ]
}
{% endschema %}
