{%- liquid
  assign s = section.settings
  assign image_alt = s.image.alt | default: s.heading | default: shop.name
-%}

{{ 'page-section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'page-section-reveal.js' | asset_url }}" defer="defer"></script>

<section
  id="AboutPhotoHero-{{ section.id }}"
  class="about-photo-hero nook-page-hero-motion color-{{ s.color_scheme }} gradient"
  style="
    --about-photo-hero-min-height: {{ s.min_height }}px;
    --about-photo-hero-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
    --about-photo-hero-ink: {{ s.text_color }};
    --about-photo-hero-accent: {{ s.accent_color }};
  "
  aria-labelledby="AboutPhotoHeroHeading-{{ section.id }}"
>
  <div class="about-photo-hero__media">
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 2400
        | image_tag:
          class: 'about-photo-hero__image',
          widths: '375, 550, 750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: image_alt,
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <img
        class="about-photo-hero__image"
        src="{{ 'featured-sock-pair-editorial.jpg' | asset_url }}"
        alt="{{ image_alt | escape }}"
        width="1600"
        height="1000"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="about-photo-hero__shade" aria-hidden="true"></div>

  <div class="about-photo-hero__content page-width">
    <div class="about-photo-hero__copy">
      {%- if s.kicker != blank -%}
        <p class="about-photo-hero__kicker">{{ s.kicker | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h1 id="AboutPhotoHeroHeading-{{ section.id }}" class="about-photo-hero__heading">
          {%- assign about_heading_words = s.heading | split: ' ' -%}
          {%- for word in about_heading_words -%}
            <span class="about-photo-hero__heading-word" style="--about-word-order: {{ forloop.index0 }};">{{ word | escape }}</span>{% unless forloop.last %} {% endunless %}
          {%- endfor -%}
        </h1>
      {%- endif -%}

      {%- if s.body != blank -%}
        <div class="about-photo-hero__body rte">{{ s.body }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  body.template-page-aboutus #MainContent {
    margin-top: calc(-1 * var(--header-height, 10rem));
  }

  body.template-page-aboutus .section-header {
    z-index: 6;
  }

  body.template-page-aboutus .section-header .header-wrapper {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.58) 0%, rgb(0 0 0 / 0.22) 62%, transparent 100%);
    box-shadow: none;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  body.template-page-aboutus .section-header .site-header-transparent {
    background: transparent;
  }

  body.template-page-aboutus .section-header:not(.scrolled-past-header) .header__menu-item,
  body.template-page-aboutus .section-header:not(.scrolled-past-header) .header__active-menu-item,
  body.template-page-aboutus .section-header:not(.scrolled-past-header) .header__icon,
  body.template-page-aboutus .section-header:not(.scrolled-past-header) .localization-selector {
    color: #ffffff !important;
  }

  body.template-page-aboutus .section-header:not(.scrolled-past-header) .header__menu-item svg,
  body.template-page-aboutus .section-header:not(.scrolled-past-header) .header__icon svg,
  body.template-page-aboutus .section-header:not(.scrolled-past-header) .localization-selector svg {
    color: #ffffff !important;
    fill: currentColor;
  }

  body.template-page-aboutus .section-header.scrolled-past-header .header-wrapper {
    background: rgb(var(--color-background));
    box-shadow: 0 0.8rem 2.4rem rgb(31 29 36 / 0.08);
  }

  .about-photo-hero {
    position: relative;
    min-height: clamp(var(--about-photo-hero-min-height, 520px), 68svh, 760px);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: #1f1d24;
    color: var(--about-photo-hero-ink, #ffffff);
  }

  .about-photo-hero__media,
  .about-photo-hero__shade {
    position: absolute;
    inset: 0;
  }

  .about-photo-hero__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transform: scale(1.01);
  }

  .about-photo-hero__shade {
    background: rgb(31 29 36 / var(--about-photo-hero-overlay, 0.5));
  }

  .about-photo-hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    place-items: center;
    padding-top: clamp(78px, 9vw, 128px);
    padding-bottom: clamp(70px, 8vw, 118px);
  }

  .about-photo-hero__copy {
    width: min(640px, 100%);
    text-align: center;
  }

  .about-photo-hero__kicker {
    margin: 0 0 16px;
    color: color-mix(in srgb, var(--about-photo-hero-ink, #ffffff) 78%, transparent);
    font-family: var(--font-body-family), Arial, sans-serif;
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .about-photo-hero__heading {
    max-width: 10em;
    margin: 0 auto;
    color: var(--about-photo-hero-ink, #ffffff);
    font-family: Poppins, var(--font-heading-family), Arial, sans-serif;
    font-size: clamp(4.8rem, 7.2vw, 9.6rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .about-photo-hero__body {
    max-width: 44ch;
    margin: 22px auto 0;
    color: color-mix(in srgb, var(--about-photo-hero-ink, #ffffff) 86%, transparent);
    font-family: var(--font-body-family), Arial, sans-serif;
    font-size: 1.78rem;
    line-height: 1.55;
  }

  .about-photo-hero__body > :first-child {
    margin-top: 0;
  }

  .about-photo-hero__body > :last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    body.template-page-aboutus #MainContent {
      margin-top: calc(-1 * var(--header-height, 8rem));
    }

    .about-photo-hero {
      min-height: clamp(400px, 62svh, 520px);
    }

    .about-photo-hero__shade {
      background: rgb(31 29 36 / var(--about-photo-hero-overlay, 0.5));
    }

    .about-photo-hero__content {
      padding-top: 76px;
      padding-bottom: 62px;
    }

    .about-photo-hero__kicker {
      font-size: 1.22rem;
      letter-spacing: 0.12em;
    }

    .about-photo-hero__heading {
      font-size: clamp(4rem, 15vw, 6rem);
    }

    .about-photo-hero__body {
      font-size: 1.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About photo hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.popup"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Small label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About us"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 360,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 520
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 10,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#157A5B"
    }
  ],
  "presets": [
    {
      "name": "About photo hero"
    }
  ]
}
{% endschema %}
