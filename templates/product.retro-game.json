    "custom_liquid_RQTGD9": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Stylish Product Specifications (Pure HTML + CSS) -->\n<div class=\"product-specifications\" style=\"max-width:800px; margin:40px auto; font-family:Arial, sans-serif; background:#f9fafb; border-radius:16px; padding:30px; box-shadow:0 10px 25px rgba(0,0,0,0.05);\">\n  <h2 style=\"font-size:26px; font-weight:bold; text-align:center; margin-bottom:30px; color:#111827;\">Specifications</h2>\n  <ul style=\"list-style:none; padding:0; margin:0;\">\n    <li class=\"spec-item\"><strong>Brand:</strong> Pixora</li>\n    <li class=\"spec-item\"><strong>Model:</strong> R36S Open Source Console</li>\n    <li class=\"spec-item\"><strong>Screen:</strong> 3.5\" IPS, 640 × 480 pixels</li>\n    <li class=\"spec-item\"><strong>Memory:</strong> 64 GB MicroSD (expandable)</li>\n    <li class=\"spec-item\"><strong>System:</strong> Linux (open source)</li>\n    <li class=\"spec-item\"><strong>Battery:</strong> Rechargeable lithium battery, up to 8 hours of use</li>\n    <li class=\"spec-item\"><strong>Connections:</strong> USB-C, 3.5mm headphone jack</li>\n    <li class=\"spec-item\"><strong>Dimensions:</strong> Handy pocket size</li>\n    <li class=\"spec-item\"><strong>Scope of delivery:</strong> Console, USB-C cable, MicroSD card, manual</li>\n  </ul>\n</div>\n\n<style>\n  .spec-item {\n    background:#ffffff;\n    margin-bottom:12px;\n    padding:15px 20px;\n    border-radius:12px;\n    font-size:16px;\n    color:#1f2937;\n    box-shadow:0 5px 15px rgba(0,0,0,0.05);\n    transition:all 0.3s ease;\n  }\n\n  /* Hover effect */\n  .spec-item:hover {\n    transform: translateY(-5px) scale(1.02);\n    box-shadow: 0 10px 25px rgba(0,0,0,0.1);\n    background: #e0f2fe;\n  }\n</style>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
