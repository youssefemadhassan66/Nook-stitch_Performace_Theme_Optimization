{{ 'track-order-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="track-order-support color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-track-order-support>
  <div class="track-order-support__inner page-width">
    <header class="track-order-support__header" data-track-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="track-order-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="track-order-support__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </header>

    <ol class="track-order-support__list" role="list">
      {%- for block in section.blocks -%}
        <li class="track-order-support__item" data-track-reveal {{ block.shopify_attributes }}>
          <span class="track-order-support__number" aria-hidden="true">0{{ forloop.index }}</span>
          <div class="track-order-support__content">
            {%- if block.settings.heading != blank -%}
              <h3 class="track-order-support__item-heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="track-order-support__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="track-order-support__link" href="{{ block.settings.link }}">
                {{ block.settings.link_label | escape }}
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Track order support",
  "tag": "section",
  "class": "track-order-support-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.popup"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Helpful details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you search"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Helpful detail",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Find your order number"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "It is in your order confirmation email and starts with a #."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Track order support",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "heading": "Find your order number",
            "text": "It is in your order confirmation email and starts with a #."
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Allow time for updates",
            "text": "Tracking can take up to 48 hours to show after your order ships."
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Still need help?",
            "text": "Our support team can help with delivery questions.",
            "link_label": "Contact support",
            "link": "/pages/contact"
          }
        }
      ]
    }
  ]
}
{% endschema %}
