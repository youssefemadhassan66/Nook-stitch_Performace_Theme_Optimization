{%- liquid
  assign s = section.settings
  assign default_white = 'arrival-sock-white.png' | asset_url
  assign default_black = 'arrival-sock-black.png' | asset_url
  assign default_blue = 'arrival-sock-blue.png' | asset_url
  assign default_grey = 'arrival-sock-grey.png' | asset_url
  assign normal_link = s.normal_link | default: s.product_link | default: routes.all_products_collection_url
  assign crew_link = s.crew_link | default: s.product_link | default: routes.all_products_collection_url
  assign normal_white_link = s.normal_white_link | default: 'https://nookandstitch.com/products/orthopedicsocks?variant=55775989170551'
  assign normal_black_link = s.normal_black_link | default: 'https://nookandstitch.com/products/orthopedicsocks?variant=55775989039479'
  assign normal_grey_link = s.normal_grey_link | default: 'https://nookandstitch.com/products/orthopedicsocks?variant=57174032548215'
  assign normal_blue_link = s.normal_blue_link | default: 'https://nookandstitch.com/products/orthopedicsocks?variant=57174032646519'
  assign crew_black_link = s.crew_black_link | default: 'https://nookandstitch.com/products/orthopedic-crew-socks?variant=56616549843319'
  assign crew_white_link = s.crew_white_link | default: 'https://nookandstitch.com/products/orthopedic-crew-socks?variant=56616554594679'

  assign normal_white_image = default_white
  assign normal_black_image = default_black
  assign normal_grey_image = default_grey
  assign normal_blue_image = default_blue
  assign crew_black_image = default_black
  assign crew_white_image = default_white

  if s.normal_white_image != blank
    assign normal_white_image = s.normal_white_image | image_url: width: 660
  endif
  if s.normal_black_image != blank
    assign normal_black_image = s.normal_black_image | image_url: width: 660
  endif
  if s.normal_grey_image != blank
    assign normal_grey_image = s.normal_grey_image | image_url: width: 660
  endif
  if s.normal_blue_image != blank
    assign normal_blue_image = s.normal_blue_image | image_url: width: 660
  endif
  if s.crew_black_image != blank
    assign crew_black_image = s.crew_black_image | image_url: width: 660
  endif
  if s.crew_white_image != blank
    assign crew_white_image = s.crew_white_image | image_url: width: 660
  endif
-%}

<section
  class="sock-reel-guide gradient color-{{ s.color_scheme }}"
  style="--guide-bg: {{ s.background_color }}; --guide-ink: {{ s.text_color }}; --guide-accent: {{ s.accent_color }}; --guide-active-color: #FFFFFF; --guide-active-triangle: #F2F2F2; --guide-triangle-text: #1F1D24;"
  data-sock-reel-guide
>
  <div class="page-width sock-reel-guide__inner">
    <div class="sock-reel-guide__header">
      {%- if s.eyebrow != blank -%}
        <p class="sock-reel-guide__eyebrow">
          <span class="sock-reel-guide__tick" aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
          <span class="sock-reel-guide__tick" aria-hidden="true"></span>
        </p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="sock-reel-guide__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      <div class="sock-reel-guide__tabs" role="tablist" aria-label="{{ s.heading | escape }}">
        <button class="sock-reel-guide__tab is-active" type="button" role="tab" aria-selected="true" aria-controls="sock-pane-normal-{{ section.id }}" data-guide-tab="normal">
          Normal socks
        </button>
        <button class="sock-reel-guide__tab" type="button" role="tab" aria-selected="false" aria-controls="sock-pane-crew-{{ section.id }}" data-guide-tab="crew">
          Crew socks
        </button>
      </div>
    </div>

    <div class="sock-reel-guide__stage">
      <button class="sock-reel-guide__arrow sock-reel-guide__arrow--prev" type="button" aria-label="Previous sock" data-guide-prev>
        <span aria-hidden="true">&#8249;</span>
      </button>

      <div class="sock-reel-guide__panes">
        <div class="sock-reel-guide__pane is-active" id="sock-pane-normal-{{ section.id }}" role="tabpanel" data-guide-pane="normal">
          <div class="sock-reel-guide__products" data-guide-products>
            <article class="sock-reel-guide__product is-centered" data-guide-product data-guide-href="{{ normal_white_link }}" data-guide-color="#FFFFFF" data-guide-triangle="#F2F2F2" data-guide-triangle-text="#1F1D24">
              <a class="sock-reel-guide__image-wrap" href="{{ normal_white_link }}" draggable="false">
                <img src="{{ normal_white_image | escape }}" alt="White normal orthopedic sock" loading="lazy" width="900" height="900" draggable="false">
              </a>
              <p class="sock-reel-guide__product-moment">Normal sock</p>
              <h3 class="sock-reel-guide__product-name">White</h3>
              <p class="sock-reel-guide__product-notes">Soft everyday support with a clean, easy finish.</p>
              <p class="sock-reel-guide__price">EGP 2,853</p>
              <a class="sock-reel-guide__cta" href="{{ normal_white_link }}">Shop normal</a>
            </article>

            <article class="sock-reel-guide__product" data-guide-product data-guide-href="{{ normal_black_link }}" data-guide-color="#1F1D24" data-guide-triangle="#1F1D24" data-guide-triangle-text="#FBFAF4">
              <a class="sock-reel-guide__image-wrap" href="{{ normal_black_link }}" draggable="false">
                <img src="{{ normal_black_image | escape }}" alt="Black normal orthopedic sock" loading="lazy" width="900" height="900" draggable="false">
              </a>
              <p class="sock-reel-guide__product-moment">Normal sock</p>
              <h3 class="sock-reel-guide__product-name">Black</h3>
              <p class="sock-reel-guide__product-notes">A darker daily pair with the same cushioned build.</p>
              <p class="sock-reel-guide__price">EGP 2,853</p>
              <a class="sock-reel-guide__cta" href="{{ normal_black_link }}">Shop normal</a>
            </article>

            <article class="sock-reel-guide__product" data-guide-product data-guide-href="{{ normal_grey_link }}" data-guide-color="#B7B9B4" data-guide-triangle="#B7B9B4" data-guide-triangle-text="#1F1D24">
              <a class="sock-reel-guide__image-wrap" href="{{ normal_grey_link }}" draggable="false">
                <img src="{{ normal_grey_image | escape }}" alt="Grey normal orthopedic sock" loading="lazy" width="900" height="900" draggable="false">
              </a>
              <p class="sock-reel-guide__product-moment">Normal sock</p>
              <h3 class="sock-reel-guide__product-name">Grey</h3>
              <p class="sock-reel-guide__product-notes">A calm neutral for workdays, walking, and travel.</p>
              <p class="sock-reel-guide__price">EGP 2,853</p>
              <a class="sock-reel-guide__cta" href="{{ normal_grey_link }}">Shop normal</a>
            </article>

            <article class="sock-reel-guide__product" data-guide-product data-guide-href="{{ normal_blue_link }}" data-guide-color="#9FC4E2" data-guide-triangle="#9FC4E2" data-guide-triangle-text="#1F1D24">
              <a class="sock-reel-guide__image-wrap" href="{{ normal_blue_link }}" draggable="false">
                <img src="{{ normal_blue_image | escape }}" alt="Blue normal orthopedic sock" loading="lazy" width="900" height="900" draggable="false">
              </a>
              <p class="sock-reel-guide__product-moment">Normal sock</p>
              <h3 class="sock-reel-guide__product-name">Blue</h3>
              <p class="sock-reel-guide__product-notes">A cooler color with breathable ankle support.</p>
              <p class="sock-reel-guide__price">EGP 2,853</p>
              <a class="sock-reel-guide__cta" href="{{ normal_blue_link }}">Shop normal</a>
            </article>
          </div>
        </div>

        <div class="sock-reel-guide__pane" id="sock-pane-crew-{{ section.id }}" role="tabpanel" hidden data-guide-pane="crew">
          <div class="sock-reel-guide__products sock-reel-guide__products--short" data-guide-products>
            <article class="sock-reel-guide__product is-centered" data-guide-product data-guide-href="{{ crew_black_link }}" data-guide-color="#1F1D24" data-guide-triangle="#1F1D24" data-guide-triangle-text="#FBFAF4">
              <a class="sock-reel-guide__image-wrap" href="{{ crew_black_link }}" draggable="false">
                <img src="{{ crew_black_image | escape }}" alt="Black orthopedic crew sock" loading="lazy" width="900" height="900" draggable="false">
              </a>
              <p class="sock-reel-guide__product-moment">Crew sock</p>
              <h3 class="sock-reel-guide__product-name">Black</h3>
              <p class="sock-reel-guide__product-notes">More coverage with the same steady comfort feel.</p>
              <p class="sock-reel-guide__price">EGP 3,138</p>
              <a class="sock-reel-guide__cta" href="{{ crew_black_link }}">Shop crew</a>
            </article>

            <article class="sock-reel-guide__product" data-guide-product data-guide-href="{{ crew_white_link }}" data-guide-color="#FFFFFF" data-guide-triangle="#F2F2F2" data-guide-triangle-text="#1F1D24">
              <a class="sock-reel-guide__image-wrap" href="{{ crew_white_link }}" draggable="false">
                <img src="{{ crew_white_image | escape }}" alt="White orthopedic crew sock" loading="lazy" width="900" height="900" draggable="false">
              </a>
              <p class="sock-reel-guide__product-moment">Crew sock</p>
              <h3 class="sock-reel-guide__product-name">White</h3>
              <p class="sock-reel-guide__product-notes">A crisp crew length for longer wear and softer coverage.</p>
              <p class="sock-reel-guide__price">EGP 3,138</p>
              <a class="sock-reel-guide__cta" href="{{ crew_white_link }}">Shop crew</a>
            </article>
          </div>
        </div>
      </div>

      <button class="sock-reel-guide__arrow sock-reel-guide__arrow--next" type="button" aria-label="Next sock" data-guide-next>
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>
  </div>
</section>

<script>
  if (!window.sockReelGuideReady) {
    window.sockReelGuideReady = true;

    var guideDragState = null;

    function getActiveProducts(guide) {
      var activePane = guide && guide.querySelector('[data-guide-pane].is-active');
      return activePane && activePane.querySelector('[data-guide-products]');
    }

    function centerProduct(product, behavior) {
      if (!product) return;

      var productList = product.closest('[data-guide-products]');
      if (!productList) return;

      var targetLeft = product.offsetLeft - ((productList.clientWidth - product.offsetWidth) / 2);
      productList.scrollTo({ left: targetLeft, behavior: behavior || 'smooth' });

      window.setTimeout(function() {
        updateCenteredProduct(productList);
      }, behavior === 'auto' ? 0 : 220);
    }

    function updateCenteredProduct(productList) {
      if (!productList) return;

      var guide = productList.closest('[data-sock-reel-guide]');
      var products = Array.prototype.slice.call(productList.querySelectorAll('[data-guide-product]'));
      if (!products.length) return;

      var listCenter = productList.scrollLeft + productList.clientWidth / 2;
      var closest = products.reduce(function(current, product) {
        var productCenter = product.offsetLeft + product.offsetWidth / 2;
        var distance = Math.abs(productCenter - listCenter);
        if (!current || distance < current.distance) return { product: product, distance: distance };
        return current;
      }, null);

      products.forEach(function(product) {
        product.classList.toggle('is-centered', closest && closest.product === product);
      });

      if (guide && closest && closest.product) {
        guide.style.setProperty('--guide-active-color', closest.product.getAttribute('data-guide-color') || '#F7F7F1');
        guide.style.setProperty('--guide-active-triangle', closest.product.getAttribute('data-guide-triangle') || '#F2F2F2');
        guide.style.setProperty('--guide-triangle-text', closest.product.getAttribute('data-guide-triangle-text') || '#1F1D24');
      }
    }

    function setActivePane(guide, tab) {
      var target = tab.getAttribute('data-guide-tab');

      guide.querySelectorAll('[data-guide-tab]').forEach(function(button) {
        var isActive = button === tab;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      guide.querySelectorAll('[data-guide-pane]').forEach(function(pane) {
        var isActive = pane.getAttribute('data-guide-pane') === target;
        pane.classList.toggle('is-active', isActive);
        pane.hidden = !isActive;

        if (isActive) {
          var products = pane.querySelector('[data-guide-products]');
          if (products) {
            centerProduct(products.querySelector('[data-guide-product]'), 'smooth');
          }
        }
      });
    }

    document.addEventListener('click', function(event) {
      var tab = event.target.closest('[data-guide-tab]');
      var guide = event.target.closest('[data-sock-reel-guide]');

      if (tab && guide) {
        setActivePane(guide, tab);
        return;
      }

      var cta = event.target.closest('.sock-reel-guide__cta');
      if (cta) {
        event.preventDefault();
        window.location.href = cta.href;
        return;
      }

      var productListForClick = event.target.closest('[data-guide-products]');
      if (productListForClick && productListForClick.dataset.guideDragged === 'true') {
        event.preventDefault();
        event.stopPropagation();
        return;
      }

      var productCard = event.target.closest('[data-guide-product]');
      if (productCard && !event.target.closest('a, button')) {
        var cardHref = productCard.getAttribute('data-guide-href');
        if (cardHref) {
          window.location.href = cardHref;
        }
        return;
      }

      var arrow = event.target.closest('[data-guide-prev], [data-guide-next]');
      if (!arrow) return;

      guide = arrow.closest('[data-sock-reel-guide]');
      var productList = getActiveProducts(guide);
      if (!productList) return;

      var products = Array.prototype.slice.call(productList.querySelectorAll('[data-guide-product]'));
      var currentIndex = products.findIndex(function(product) {
        return product.classList.contains('is-centered');
      });
      if (currentIndex < 0) currentIndex = 0;

      var direction = arrow.hasAttribute('data-guide-prev') ? -1 : 1;
      var nextIndex = Math.max(0, Math.min(products.length - 1, currentIndex + direction));
      centerProduct(products[nextIndex], 'smooth');
    });

    document.addEventListener('pointerdown', function(event) {
      var productList = event.target.closest('[data-guide-products]');
      if (!productList || event.button !== 0 || event.target.closest('.sock-reel-guide__cta')) return;

      guideDragState = {
        list: productList,
        startX: event.clientX,
        scrollLeft: productList.scrollLeft,
        dragged: false,
        startIndex: Array.prototype.slice.call(productList.querySelectorAll('[data-guide-product]')).findIndex(function(product) {
          return product.classList.contains('is-centered');
        })
      };

      productList.classList.add('is-dragging');
      try {
        productList.setPointerCapture(event.pointerId);
      } catch (error) {}
    });

    document.addEventListener('pointermove', function(event) {
      if (!guideDragState) return;

      var deltaX = event.clientX - guideDragState.startX;
      if (Math.abs(deltaX) > 4) {
        guideDragState.dragged = true;
        guideDragState.list.dataset.guideDragged = 'true';
      }

      guideDragState.list.scrollLeft = guideDragState.scrollLeft - deltaX;
      event.preventDefault();
      updateCenteredProduct(guideDragState.list);
    });

    document.addEventListener('pointerup', function(event) {
      if (!guideDragState) return;

      var productList = guideDragState.list;
      productList.classList.remove('is-dragging');
      updateCenteredProduct(productList);

      if (guideDragState.dragged) {
        var products = Array.prototype.slice.call(productList.querySelectorAll('[data-guide-product]'));
        var startIndex = guideDragState.startIndex >= 0 ? guideDragState.startIndex : 0;
        var dragDirection = event.clientX < guideDragState.startX ? 1 : -1;
        var targetIndex = Math.max(0, Math.min(products.length - 1, startIndex + dragDirection));
        products.forEach(function(product, index) {
          product.classList.toggle('is-centered', index === targetIndex);
        });
        var guide = productList.closest('[data-sock-reel-guide]');
        if (guide && products[targetIndex]) {
          guide.style.setProperty('--guide-active-color', products[targetIndex].getAttribute('data-guide-color') || '#F7F7F1');
          guide.style.setProperty('--guide-active-triangle', products[targetIndex].getAttribute('data-guide-triangle') || '#F2F2F2');
          guide.style.setProperty('--guide-triangle-text', products[targetIndex].getAttribute('data-guide-triangle-text') || '#1F1D24');
        }
        centerProduct(products[targetIndex], 'smooth');

        window.setTimeout(function() {
          delete productList.dataset.guideDragged;
        }, 80);
      }

      try {
        productList.releasePointerCapture(event.pointerId);
      } catch (error) {}

      guideDragState = null;
    });

    document.addEventListener('pointercancel', function() {
      if (!guideDragState) return;
      guideDragState.list.classList.remove('is-dragging');
      guideDragState = null;
    });

    document.addEventListener('scroll', function(event) {
      var productList = event.target && event.target.closest && event.target.closest('[data-guide-products]');
      if (!productList || productList.dataset.guideScrollTick === 'true') return;

      productList.dataset.guideScrollTick = 'true';
      window.requestAnimationFrame(function() {
        updateCenteredProduct(productList);
        delete productList.dataset.guideScrollTick;
      });
    }, true);

    document.querySelectorAll('[data-sock-reel-guide]').forEach(function(guide) {
      var products = getActiveProducts(guide);
      centerProduct(products && products.querySelector('[data-guide-product].is-centered'), 'auto');
    });
  }
</script>

{% stylesheet %}
  .sock-reel-guide {
    position: relative;
    isolation: isolate;
    height: 90vh;
    min-height: 680px;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    scroll-margin-top: 110px;
    padding: clamp(24px, 3.2vh, 36px) 0 clamp(18px, 2.8vh, 30px);
    background: var(--guide-bg, #FFFFFF) !important;
    color: var(--guide-ink, rgb(var(--color-foreground)));
  }

  .sock-reel-guide::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 0;
    width: min(980px, 78vw);
    height: clamp(230px, 31vh, 320px);
    background: var(--guide-active-triangle, #F2F2F2);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform: translateX(-50%);
    transition: background-color 260ms ease, background 260ms ease, opacity 260ms ease, transform 260ms ease;
  }

  .sock-reel-guide__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .sock-reel-guide__header {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .sock-reel-guide__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 8px;
    color: var(--guide-triangle-text, var(--guide-ink, rgb(var(--color-foreground))));
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: color 220ms ease;
  }

  .sock-reel-guide__tick {
    width: 36px;
    height: 1px;
    background: currentColor;
    opacity: 0.44;
  }

  .sock-reel-guide__heading {
    position: relative;
    max-width: 10.8em;
    margin: 0;
    color: var(--guide-triangle-text, var(--guide-ink, rgb(var(--color-foreground))));
    font-family: var(--font-heading-family);
    font-size: clamp(2.7rem, 3.7vw, 4.9rem);
    font-weight: 700;
    line-height: 0.96;
    text-wrap: balance;
    transition: color 220ms ease;
  }

  .sock-reel-guide__heading::after {
    content: "";
    display: block;
    width: min(180px, 42%);
    height: 4px;
    margin: 10px auto 0;
    border-radius: 999px;
    background: var(--guide-accent, #20AD82);
  }

  .sock-reel-guide__intro {
    max-width: 58rem;
    margin: 9px auto 0;
    color: color-mix(in srgb, var(--guide-triangle-text, var(--guide-ink, rgb(var(--color-foreground)))) 84%, transparent);
    font-size: 1.55rem;
    line-height: 1.45;
    transition: color 220ms ease;
  }

  .sock-reel-guide__tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }

  .sock-reel-guide__tab {
    min-height: 44px;
    border: 1px solid color-mix(in srgb, var(--guide-ink, rgb(var(--color-foreground))) 18%, transparent);
    border-radius: 999px;
    padding: 0 22px;
    background: color-mix(in srgb, var(--guide-bg, #FFFFFF) 88%, oklch(99% 0.004 90));
    color: var(--guide-ink, rgb(var(--color-foreground)));
    cursor: pointer;
    font: inherit;
    font-size: 1.3rem;
    font-weight: 700;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .sock-reel-guide__tab:hover,
  .sock-reel-guide__tab.is-active {
    border-color: var(--guide-triangle-text, var(--guide-ink, rgb(var(--color-foreground))));
    background: var(--guide-ink, rgb(var(--color-foreground)));
    color: var(--guide-bg, rgb(var(--color-background)));
    box-shadow: 0 0 0 1px var(--guide-triangle-text, transparent);
  }

  .sock-reel-guide__tab:focus-visible,
  .sock-reel-guide__arrow:focus-visible,
  .sock-reel-guide__cta:focus-visible {
    outline: 3px solid var(--guide-accent, #20AD82);
    outline-offset: 3px;
  }

  .sock-reel-guide__stage {
    position: relative;
    display: grid;
    align-content: end;
    width: 100%;
    min-width: 0;
    margin-top: clamp(12px, 2.4vh, 24px);
    overflow: hidden;
  }

  .sock-reel-guide__panes,
  .sock-reel-guide__pane {
    min-width: 0;
  }

  .sock-reel-guide__pane[hidden] {
    display: none;
  }

  .sock-reel-guide__pane-copy {
    max-width: 54rem;
    margin: 0 auto clamp(12px, 2vh, 18px);
    text-align: center;
  }

  .sock-reel-guide__pane-copy p {
    margin: 0;
  }

  .sock-reel-guide__pane-copy p:first-child {
    color: var(--guide-ink, rgb(var(--color-foreground)));
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .sock-reel-guide__pane-copy p:last-child {
    margin-top: 8px;
    color: color-mix(in srgb, var(--guide-ink, rgb(var(--color-foreground))) 72%, transparent);
    font-size: 1.6rem;
    line-height: 1.5;
  }

  .sock-reel-guide__products {
    box-sizing: border-box;
    display: flex;
    width: 100vw;
    max-width: 100vw;
    gap: clamp(38px, 4.8vw, 76px);
    min-height: clamp(270px, 32vh, 350px);
    margin-left: 50%;
    transform: translateX(-50%);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-padding-inline: calc((100vw - clamp(168px, 14vw, 216px)) / 2);
    scroll-snap-type: x mandatory;
    padding: 6px calc((100vw - clamp(168px, 14vw, 216px)) / 2) 92px;
    cursor: grab;
    scrollbar-width: none;
    touch-action: pan-y;
    user-select: none;
  }

  .sock-reel-guide__products.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .sock-reel-guide__products::-webkit-scrollbar {
    display: none;
  }

  .sock-reel-guide__product {
    display: grid;
    flex: 0 0 clamp(168px, 14vw, 216px);
    gap: 7px;
    align-content: start;
    text-align: center;
    scroll-snap-align: center;
    cursor: pointer;
    opacity: 0.5;
    transform: translateY(10px) scale(0.9);
    transition: opacity 240ms ease, transform 240ms ease;
  }

  .sock-reel-guide__product.is-centered {
    opacity: 1;
    transform: translateY(-10px) scale(1.06);
  }

  .sock-reel-guide__image-wrap {
    display: block;
    overflow: visible;
    aspect-ratio: 0.72 / 1;
    border-radius: 0;
    background: transparent !important;
    box-shadow: none !important;
  }

  .sock-reel-guide__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0;
    background: transparent !important;
    mix-blend-mode: normal;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 94% 90% at 50% 54%, #000 74%, rgba(0, 0, 0, 0.88) 86%, transparent 100%);
    mask-image: radial-gradient(ellipse 94% 90% at 50% 54%, #000 74%, rgba(0, 0, 0, 0.88) 86%, transparent 100%);
    filter: drop-shadow(0 22px 24px color-mix(in srgb, var(--guide-ink, #1F1D24) 12%, transparent));
    transition: filter 220ms ease, transform 220ms ease;
  }

  .sock-reel-guide__product.is-centered .sock-reel-guide__image-wrap img {
    filter: drop-shadow(0 28px 30px color-mix(in srgb, var(--guide-ink, #1F1D24) 18%, transparent));
  }

  .sock-reel-guide__image-wrap:hover img {
    transform: scale(1.035);
  }

  .sock-reel-guide__product-moment {
    margin: 2px 0 0;
    color: color-mix(in srgb, var(--guide-ink, rgb(var(--color-foreground))) 62%, transparent);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sock-reel-guide__product-name {
    margin: 0;
    color: var(--guide-ink, rgb(var(--color-foreground)));
    font-family: var(--font-heading-family);
    font-size: 1.65rem;
    line-height: 1.18;
  }

  .sock-reel-guide__product-notes,
  .sock-reel-guide__price {
    margin: 0;
    color: color-mix(in srgb, var(--guide-ink, rgb(var(--color-foreground))) 72%, transparent);
    font-size: 1.22rem;
    line-height: 1.34;
  }

  .sock-reel-guide__price {
    color: var(--guide-ink, rgb(var(--color-foreground)));
    font-weight: 700;
  }

  .sock-reel-guide__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    min-height: 36px;
    margin-top: 2px;
    border-radius: 999px;
    padding: 0 18px;
    background: var(--guide-ink, rgb(var(--color-foreground)));
    color: var(--guide-bg, rgb(var(--color-background)));
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sock-reel-guide__arrow {
    position: absolute;
    bottom: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border: 1px solid color-mix(in srgb, var(--guide-ink, rgb(var(--color-foreground))) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--guide-bg, #FFFFFF) 82%, oklch(99% 0.004 90));
    color: var(--guide-ink, rgb(var(--color-foreground)));
    cursor: pointer;
    font-size: 3rem;
    line-height: 1;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .sock-reel-guide__arrow:hover {
    border-color: var(--guide-ink, rgb(var(--color-foreground)));
    transform: translateY(-2px);
  }

  .sock-reel-guide__arrow--prev {
    left: calc(50% - 104px);
  }

  .sock-reel-guide__arrow--next {
    right: calc(50% - 104px);
  }

  @media screen and (min-width: 750px) and (max-height: 900px) {
    .sock-reel-guide {
      --guide-arrow-offset: clamp(10.4rem, calc(24.2rem - 15.3vh), 15.5rem);
      --guide-image-size: clamp(108px, calc(31vh - 62px), 216px);
      --guide-image-size: clamp(108px, calc(31dvh - 62px), 216px);
      height: 90vh;
      height: 90dvh;
      min-height: 0;
      padding: clamp(12px, calc(5.1vh - 17px), 29px) 0 clamp(10px, calc(4.5vh - 15.5px), 25px);
    }

    .sock-reel-guide::before {
      height: clamp(180px, 31vh, 320px);
      height: clamp(180px, 31dvh, 320px);
    }

    .sock-reel-guide__eyebrow {
      margin-bottom: clamp(4px, calc(1.2vh - 2.8px), 8px);
      font-size: clamp(9px, calc(0.6vh + 5.6px), 11px);
    }

    .sock-reel-guide__heading {
      font-size: clamp(3rem, calc(5.4vh + 0.3px), 4.9rem);
      line-height: 0.95;
    }

    .sock-reel-guide__heading::after {
      height: clamp(3px, 0.3vh, 4px);
      margin-top: clamp(5px, calc(1.5vh - 3.5px), 10px);
    }

    .sock-reel-guide__tabs {
      margin-top: clamp(4px, calc(3vh - 13px), 14px);
    }

    .sock-reel-guide__stage {
      margin-top: clamp(6px, calc(4.7vh - 20.7px), 22px);
    }

    .sock-reel-guide__products {
      min-height: 0;
      padding-top: 2px;
      padding-bottom: clamp(26px, calc(19.9vh - 87px), 92px);
    }

    .sock-reel-guide__product {
      gap: clamp(4px, calc(0.9vh - 1.1px), 7px);
    }

    .sock-reel-guide__image-wrap {
      width: var(--guide-image-size);
      justify-self: center;
    }

    .sock-reel-guide__product-moment,
    .sock-reel-guide__cta {
      margin-top: 0;
    }

    .sock-reel-guide__arrow {
      bottom: clamp(0px, calc(3vh - 17px), 10px);
      width: clamp(44px, calc(1.8vh + 34px), 50px);
      height: clamp(44px, calc(1.8vh + 34px), 50px);
    }

    .sock-reel-guide__arrow--prev {
      left: calc(50% - var(--guide-arrow-offset));
    }

    .sock-reel-guide__arrow--next {
      right: calc(50% - var(--guide-arrow-offset));
    }
  }

  @media screen and (min-width: 750px) and (max-height: 520px) {
    .sock-reel-guide {
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .sock-reel-guide__inner {
      height: auto;
      overflow: visible;
    }

    .sock-reel-guide__stage {
      overflow: visible;
    }

    .sock-reel-guide__products {
      height: auto;
      min-height: 0;
    }
  }

  @media screen and (max-width: 989px) {
    .sock-reel-guide__product {
      flex-basis: clamp(170px, 22vw, 210px);
    }

    .sock-reel-guide__products {
      scroll-padding-inline: calc((100vw - clamp(170px, 22vw, 210px)) / 2);
      padding-inline: calc((100vw - clamp(170px, 22vw, 210px)) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .sock-reel-guide {
      height: auto;
      min-height: 80vh;
      scroll-margin-top: 78px;
      padding: 34px 0 24px;
    }

    .sock-reel-guide::before {
      width: 124vw;
      height: clamp(250px, 36vh, 320px);
    }

    .sock-reel-guide__eyebrow {
      margin-bottom: 13px;
      font-size: 9px;
      letter-spacing: 0.18em;
    }

    .sock-reel-guide__tick {
      width: 24px;
    }

    .sock-reel-guide__heading {
      max-width: min(8.8em, calc(100vw - 40px));
      font-size: clamp(2.4rem, 7vw, 2.8rem);
      line-height: 1;
    }

    .sock-reel-guide__heading::after {
      height: 3px;
    }

    .sock-reel-guide__intro {
      max-width: min(330px, calc(100vw - 40px));
      margin-top: 13px;
      font-size: 1.45rem;
      line-height: 1.5;
    }

    .sock-reel-guide__tabs {
      justify-content: center;
      flex-wrap: nowrap;
      overflow-x: auto;
      width: min(100%, calc(100vw - 28px));
      margin-top: 18px;
      padding: 0 0 5px;
      scrollbar-width: none;
    }

    .sock-reel-guide__tabs::-webkit-scrollbar {
      display: none;
    }

    .sock-reel-guide__tab {
      flex: 0 0 auto;
      min-width: 126px;
      min-height: 44px;
      padding: 0 14px;
      font-size: 1.15rem;
    }

    .sock-reel-guide__stage {
      margin-top: 18px;
    }

    .sock-reel-guide__pane-copy {
      margin-bottom: 0;
    }

    .sock-reel-guide__pane-copy p:last-child {
      font-size: 1.45rem;
      line-height: 1.48;
    }

    .sock-reel-guide__products {
      gap: 32px;
      min-height: 390px;
      scroll-padding-inline: calc((100vw - min(60vw, 220px)) / 2);
      padding: 14px calc((100vw - min(60vw, 220px)) / 2) 86px;
    }

    .sock-reel-guide__product {
      flex-basis: min(60vw, 220px);
      gap: 7px;
      transform: translateY(14px) scale(0.9);
      opacity: 0.76;
    }

    .sock-reel-guide__product.is-centered {
      transform: translateY(-12px) scale(1.03);
    }

    .sock-reel-guide__image-wrap {
      aspect-ratio: 0.72 / 1;
    }

    .sock-reel-guide__product-moment {
      margin-top: 8px;
      font-size: 1rem;
    }

    .sock-reel-guide__product-name {
      font-size: 1.6rem;
    }

    .sock-reel-guide__product-notes,
    .sock-reel-guide__price {
      font-size: 1.3rem;
    }

    .sock-reel-guide__cta {
      min-height: 40px;
      padding: 0 15px;
      font-size: 1.05rem;
    }

    .sock-reel-guide__arrow {
      bottom: 18px;
      width: 44px;
      height: 44px;
    }

    .sock-reel-guide__arrow--prev {
      left: calc(50% - 58px);
    }

    .sock-reel-guide__arrow--next {
      right: calc(50% - 58px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sock-reel-guide *,
    .sock-reel-guide *::before,
    .sock-reel-guide *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
{% endstylesheet %}

