path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\" />\n      </svg>\n      <p style=\"font-size:15px; font-weight:500; margin:0;\">24/7 Customer Support</p>\n    </div>\n\n    <div class=\"guarantee-card\" style=\"flex:1; min-width:180px; max-width:220px; padding:20px; transition:transform 0.3s;\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"#d4af37\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"40\" height=\"40\" class=\"guarantee-icon\" style=\"margin-bottom:12px; transition:all 0.3s ease;\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 11c.828 0 1.5.672 1.5 1.5v1.5a1.5 1.5 0 01-3 0V12.5c0-.828.672-1.5 1.5-1.5z\" />\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 9V7a6 6 0 1112 0v2M4 9h16v11H4V9z\" />\n      </svg>\n      <p style=\"font-size:15px; font-weight:500; margin:0;\">Secure Checkout</p>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .guarantee-card:hover {\n    transform: translateY(-6px);\n  }\n\n  .guarantee-card:hover .guarantee-icon {\n    stroke: #c69d2f;\n    transform: scale(1.15);\n    filter: drop-shadow(0 0 6px rgba(198,157,47,0.6));\n  }\n</style>",
