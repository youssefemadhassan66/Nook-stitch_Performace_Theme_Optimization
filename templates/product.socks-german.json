    "multirow_VyPRij": {
      "type": "multirow",
      "blocks": {
        "row_ttKrmL": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Untitled_design_-_2025-12-13T152150.624.png",
            "caption": "",
            "heading": "<strong>Gepolsterter Halt bei jedem Schritt</strong>",
            "text": "<p>Die kuschelweiche Polstersohle wirkt wie ein weicher Stoßdämpfer, fängt jeden Schritt ab und reduziert den Aufprall auf harten Böden. Der dicke, gepolsterte Stoff sorgt für extra Komfort und Halt und entlastet gleichzeitig den Druck auf deinen Füßen. Ideal für den Alltag oder beim Sport, sie steigert den Gesamtkomfort und sorgt dafür, dass sich deine Füße den ganzen Tag gestützt anfühlen.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "row_fqLxa6": {
          "type": "row",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/H4a1d396b8a0845e99446c33ec8f4557cP.jpg",
            "caption": "",
            "heading": "<strong>Stay Steady with Anti-Slip Grip</strong>",
            "text": "<p><br/>The anti-slip stripes on the bottom of the socks provide extra stability and grip, preventing unwanted slipping on smooth surfaces. Designed for both home and active use, they help you stay balanced and confident whether walking, exercising, or simply moving around indoors.<br/><br/></p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "row_MQUTFn": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Untitled_design_-_2025-12-13T153106.192.png",
            "caption": "",
            "heading": "<strong>Gepolsterter Knöchelschutz für langanhaltenden Komfort</strong>",
            "text": "<p>Die gepolsterte Knöchelmanschette an der Rückseite der Socke schützt gezielt vor Reibung und Schuhdruck. Direkt über der Ferse positioniert, polstert sie den Knöchel ab, beugt Reizungen und Blasen vor und macht die Socken besonders bequem für langes Tragen und aktive Bewegung.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "row_4ed9wy": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Untitled_design_-_2025-12-13T130057.919.png",
            "caption": "",
            "heading": "<strong>Alles, was du in einer Socke brauchst</strong>",
            "text": "<p>Komfortpolsterung, starke Fußgewölbestütze, Knöchelschutz und eine perfekte Passform, gemacht für lange Stunden auf den Beinen. Entwickelt mit hochwertiger Baumwollpolsterung und stabilem Halt für deinen bisher bequemsten Schritt.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
