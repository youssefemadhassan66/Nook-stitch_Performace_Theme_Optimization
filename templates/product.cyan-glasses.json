    "custom_liquid_4yqTzc": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .featured-logos {\n    background: #000000;\n    padding: 0; /* remove all vertical padding */\n    text-align: center;\n    margin: 0; \n    overflow: hidden;\n    position: relative;\n  }\n\n  /* Scroller wrapper */\n  .logo-track {\n    display: flex;\n    width: max-content;\n    align-items: center; /* vertically center logos */\n    animation: scroll 25s linear infinite;\n  }\n\n  /* Logos */\n  .logo-track img {\n    max-height: 80px;\n    margin: 0 50px;\n    object-fit: contain;\n    opacity: 0.9;\n    transition: transform 0.3s ease, opacity 0.3s ease;\n  }\n  .logo-track img:hover {\n    opacity: 1;\n    transform: scale(1.1);\n  }\n\n  @keyframes scroll {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n</style>\n\n<div class=\"featured-logos\">\n  <div class=\"logo-slider\">\n    <div class=\"logo-track\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Untitled_design_86.png?v=1756266994\" alt=\"USA Today\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Vogue-Emblem.png?v=1756265696\" alt=\"Vogue\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/time-logo-white.png?v=1756265722\" alt=\"Time\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/forbes-2-logo-png-transparent.png?v=1756265787\" alt=\"Forbes\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Untitled_design_84.png?v=1756265800\" alt=\"Custom\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Untitled_design_85.png?v=1756266997\" alt=\"New Logo 2\">\n\n      <!-- Duplicate for seamless loop -->\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Untitled_design_86.png?v=1756266994\" alt=\"USA Today\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Vogue-Emblem.png?v=1756265696\" alt=\"Vogue\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/time-logo-white.png?v=1756265722\" alt=\"Time\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/forbes-2-logo-png-transparent.png?v=1756265787\" alt=\"Forbes\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Untitled_design_84.png?v=1756265800\" alt=\"Custom\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/Untitled_design_85.png?v=1756266997\" alt=\"New Logo 2\">\n    </div>\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_wMjXYr": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .video-section-container {\n    text-align: center;\n    margin: 40px 0;\n  }\n\n  .video-section-container h2 {\n    font-size: 28px;\n    font-weight: bold;\n    margin-bottom: 20px;\n    letter-spacing: 1px;\n  }\n\n  .video-carousel {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    overflow: hidden;\n    position: relative;\n  }\n\n  .video-track {\n    display: flex;\n    gap: 20px;\n    scroll-snap-type: x mandatory;\n    overflow-x: auto;\n    scrollbar-width: none; /* hide scrollbar Firefox */\n    -ms-overflow-style: none; /* hide scrollbar IE */\n  }\n\n  .video-track::-webkit-scrollbar {\n    display: none; /* hide scrollbar Chrome/Safari */\n  }\n\n  .video-track video {\n    flex: 0 0 auto;\n    width: 30%;\n    aspect-ratio: 9 / 16;\n    object-fit: cover;\n    border-radius: 12px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.3);\n    scroll-snap-align: center;\n  }\n\n  @media (max-width: 1024px) {\n    .video-track video {\n      width: 45%;\n    }\n  }\n\n  @media (max-width: 768px) {\n    .video-track video {\n      width: 80%; /* show 1 main video in center */\n    }\n  }\n</style>\n\n<div class=\"video-section-container\">\n  <h2>CAPTURED WITH CYAN AI</h2>\n  <div class=\"video-carousel\">\n    <div class=\"video-track\" id=\"videoTrack\">\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/e667e6111dd140fa916385875f75643e.mp4\" muted playsinline autoplay loop preload=\"auto\"></video>\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/ceeccccba01f45c2b637eb28212abc06.mp4\" muted playsinline autoplay loop preload=\"auto\"></video>\n      <video src=\"https://cdn.shopify.com/videos/c/o/v/20d72c811f374d73a3dc70eb84fb3bc7.mp4\" muted playsinline autoplay loop preload=\"auto\"></video>\n    </div>\n  </div>\n</div>\n\n<script>\n  // Force autoplay on mobile\n  document.querySelectorAll(\"video\").forEach(video => {\n    video.muted = true;\n    video.play().catch(err => {\n      console.log(\"Autoplay blocked:\", err);\n    });\n  });\n\n  // Scroll to middle video on load\n  window.addEventListener(\"load\", () => {\n    const track = document.getElementById(\"videoTrack\");\n    const middleVideo = track.children[1];\n    track.scrollLeft = middleVideo.offsetLeft - (track.clientWidth / 2) + (middleVideo.clientWidth / 2);\n  });\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_yiFpmN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .reviews-section {\n    text-align: center;\n    margin: 50px 0;\n  }\n\n  .reviews-section h2 {\n    font-size: 28px;\n    font-weight: bold;\n    margin-bottom: 25px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .reviews-carousel {\n    display: flex;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    gap: 20px;\n    padding: 10px;\n  }\n\n  .reviews-carousel::-webkit-scrollbar {\n    display: none;\n  }\n\n  .review-card {\n    flex: 0 0 300px;\n    background: #fff;\n    border-radius: 14px;\n    padding: 20px;\n    box-shadow: 0 4px 14px rgba(0,0,0,0.1);\n    text-align: left;\n    scroll-snap-align: start;\n  }\n\n  .review-card .stars {\n    margin-bottom: 12px;\n  }\n\n  .review-card .stars img {\n    width: 150px; /* Bigger Trustpilot logo */\n    height: auto;\n  }\n\n  .review-card p {\n    font-size: 14px;\n    line-height: 1.4;\n    margin-bottom: 12px;\n  }\n\n  .review-card h4 {\n    font-size: 15px;\n    font-weight: bold;\n    margin: 8px 0 5px;\n  }\n\n  .review-card span {\n    font-size: 12px;\n    color: #666;\n  }\n\n  .carousel-controls {\n    display: flex;\n    justify-content: center;\n    margin-top: 15px;\n    gap: 10px;\n  }\n\n  .carousel-arrow {\n    background: #fff;\n    border: none;\n    padding: 14px;\n    border-radius: 50%;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.2);\n    cursor: pointer;\n    transition: background 0.3s;\n  }\n\n  .carousel-arrow:hover {\n    background: #f5f5f5;\n  }\n\n  .carousel-arrow svg {\n    width: 22px;\n    height: 22px;\n    stroke-width: 2.2;\n    color: #333;\n  }\n</style>\n\n<div class=\"reviews-section\">\n  <h2>\n    <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot\" style=\"height:105px;\">\n    +10,000 Verified Reviews \n  </h2>\n\n  <div class=\"reviews-carousel\" id=\"reviewsTrack\">\n    <!-- 12 Reviews Example -->\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Amazing quality, feels premium and the AI features are on point!”</p>\n      <h4>James Miller <span>— Verified Purchaser (USA)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Super easy to set up and the video capture works flawlessly.”</p>\n      <h4>Charlotte Evans <span>— Verified Purchaser (UK)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Battery life is outstanding, lasted me all day with heavy use.”</p>\n      <h4>Michael Johnson <span>— Verified Purchaser (USA)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Stylish and lightweight, I wear them every day.”</p>\n      <h4>Sophie Clarke <span>— Verified Purchaser (UK)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“The voice control works like magic, so convenient when driving.”</p>\n      <h4>Daniel Harris <span>— Verified Purchaser (USA)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Honestly better than I expected, super smooth performance.”</p>\n      <h4>Olivia Green <span>— Verified Purchaser (UK)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Perfect for capturing moments without pulling out my phone.”</p>\n      <h4>Matthew Scott <span>— Verified Purchaser (USA)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“The sound quality is crystal clear, really impressed.”</p>\n      <h4>Emily Turner <span>— Verified Purchaser (UK)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Very intuitive to use, love the touch controls.”</p>\n      <h4>Christopher White <span>— Verified Purchaser (USA)</span></h4>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"stars\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0738/6035/0101/files/trustpilot-stars-logo-png_seeklogo-477110.png?v=1756656806\" alt=\"Trustpilot stars\">\n      </div>\n      <p>“Worth every penny, I recommend it to all my friends.”</p>\n      <h4>Amelia Brooks <span>— Verified Purchaser (UK)</span></h4>\n    </div>\n  </div>\n\n  <div class=\"carousel-controls\">\n    <button class=\"carousel-arrow\" onclick=\"scrollReviews(-1)\">\n      <svg fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 19l-7-7 7-7\" /></svg>\n    </button>\n    <button class=\"carousel-arrow\" onclick=\"scrollReviews(1)\">\n      <svg fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\" /></svg>\n    </button>\n  </div>\n</div>\n\n<script>\n  function scrollReviews(direction) {\n    const track = document.getElementById(\"reviewsTrack\");\n    const cardWidth = track.children[0].offsetWidth + 20;\n    track.scrollBy({ left: direction * cardWidth, behavior: 'smooth' });\n  }\n</script>",
