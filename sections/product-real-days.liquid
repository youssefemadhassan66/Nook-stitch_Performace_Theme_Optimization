<section
  id="nook-real-days-{{ section.id }}"
  class="nook-real-days color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  style="
    --real-accent: {{ section.settings.accent_color }};
    --real-line: rgba(var(--color-foreground), 0.12);
    --real-muted: rgba(var(--color-foreground), 0.72);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <style>
    .nook-real-days {
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      display: block;
      position: relative;
    }

    .nook-real-days__inner {
      width: min({{ settings.page_width }}px, calc(100% - 40px));
      margin: 0 auto;
    }

    .nook-real-days__header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto clamp(32px, 5vw, 48px) auto;
    }

    .nook-real-days__kicker {
      margin: 0 0 14px;
      color: var(--real-accent);
      font-family: var(--font-heading-family);
      font-size: 12px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .nook-real-days__heading {
      margin: 0;
      font-family: var(--font-heading-family);
      font-size: clamp(30px, 4vw, 44px);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .nook-real-days__body {
      margin: 16px 0 0;
      color: var(--real-muted);
      font-family: var(--font-body-family);
      font-size: clamp(15px, 1.1vw, 17px);
      line-height: 1.5;
    }

    .nook-real-days__body p {
      margin: 0;
    }

    .nook-real-days__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(32px, 5vw, 64px);
      align-items: stretch;
      max-width: {{ settings.page_width }}px;
      margin: 0 auto;
    }

    .nook-real-days__media-panel {
      position: sticky;
      top: 120px;
      height: 100%;
      min-height: 380px;
      overflow: hidden;
      border: 1px solid var(--real-line);
      border-radius: 18px;
      background: rgb(var(--color-background));
      box-shadow: 0 20px 40px rgba(var(--color-foreground), 0.04), 0 1px 3px rgba(var(--color-foreground), 0.02);
    }

    .nook-real-days__image-wrapper {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 400ms cubic-bezier(0.16, 1, 0.3, 1), transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
      transform: scale(1.02);
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgb(var(--color-background));
      z-index: 1;
    }

    .nook-real-days__image-wrapper.active {
      opacity: 1;
      z-index: 2;
      transform: scale(1);
    }

    .nook-real-days__image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: var(--real-image-fit, contain);
      object-position: var(--real-image-position, center center);
      display: block;
    }

    .nook-real-days__image-wrapper svg {
      width: 100%;
      height: 100%;
      fill: #8b8d8f;
      background: #ececec;
    }

    .nook-real-days__accordion-container {
      border: 1px solid var(--real-line);
      border-radius: 18px;
      background: color-mix(in srgb, rgb(var(--color-background)) 96%, rgb(var(--color-foreground)));
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(var(--color-foreground), 0.04), 0 1px 3px rgba(var(--color-foreground), 0.02);
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    .nook-real-days__accordion-card {
      border: none;
      border-radius: 0;
      background: transparent;
      overflow: hidden;
      transition: background-color 220ms ease;
    }

    .nook-real-days__accordion-card + .nook-real-days__accordion-card {
      border-top: 1px solid var(--real-line);
    }

    .nook-real-days__accordion-card[open] {
      background: color-mix(in srgb, var(--real-accent) 4%, rgb(var(--color-background)));
    }

    .nook-real-days__accordion-header {
      width: 100%;
      padding: 24px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      background: none;
      border: none;
      cursor: pointer;
      text-align: left;
      color: inherit;
    }

    .nook-real-days__accordion-title-block {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      min-width: 0;
    }

    .nook-real-days__accordion-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 100px;
      background: color-mix(in srgb, var(--real-accent) 12%, transparent);
      color: var(--real-accent);
      font-family: var(--font-heading-family);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1;
    }

    .nook-real-days__accordion-question {
      margin: 0;
      font-family: var(--font-heading-family);
      font-size: clamp(18px, 1.6vw, 22px);
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -0.015em;
    }

    .nook-real-days__accordion-icon {
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--real-line);
      background: rgb(var(--color-background));
      display: grid;
      place-items: center;
      transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 220ms ease;
    }

    .nook-real-days__accordion-card[open] .nook-real-days__accordion-icon {
      transform: rotate(45deg);
      border-color: var(--real-accent);
      color: var(--real-accent);
    }

    .nook-real-days__accordion-icon svg {
      width: 16px;
      height: 16px;
    }

    .nook-real-days__accordion-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nook-real-days__accordion-card[open] .nook-real-days__accordion-panel {
      max-height: 900px;
    }

    .nook-real-days__accordion-content {
      padding: 0 28px 28px;
      color: var(--real-muted);
      font-family: var(--font-body-family);
      font-size: 15px;
      line-height: 1.5;
    }

    .nook-real-days__accordion-content p {
      margin: 0;
    }

    .nook-real-days__accordion-content p + p {
      margin-top: 10px;
    }

    /* Mobile image inside accordion panel */
    .nook-real-days__mobile-image {
      display: none;
    }

    @media screen and (max-width: 749px) {
      .nook-real-days__grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      .nook-real-days__media-panel {
        display: none;
      }

      .nook-real-days__mobile-image {
        display: block;
        aspect-ratio: 16 / 10;
        margin-top: 16px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--real-line);
        background: rgb(var(--color-background));
      }

      .nook-real-days__mobile-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: var(--real-image-fit, contain);
        object-position: var(--real-image-position, center center);
      }

      .nook-real-days__accordion-header {
        padding: 20px;
      }
      .nook-real-days__accordion-content {
        padding: 0 20px 20px;
      }
      .nook-real-days__accordion-icon {
        width: 36px;
        height: 36px;
      }
    }
  </style>

  <div class="nook-real-days__inner">
    <div class="nook-real-days__header">
      {%- if section.settings.kicker != blank -%}
        <p class="nook-real-days__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nook-real-days__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="nook-real-days__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    <div class="nook-real-days__grid">
      <div class="nook-real-days__media-panel" aria-hidden="true">
        {%- for block in section.blocks -%}
          <div
            class="nook-real-days__image-wrapper{% if forloop.first %} active{% endif %}"
            data-image-index="{{ forloop.index0 }}"
            style="--real-image-fit: {{ block.settings.image_fit | default: 'contain' }}; --real-image-position: {{ block.settings.image_position | default: 'center center' }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 750px) 45vw, 100vw'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="nook-real-days__accordion-container" data-relief-accordions>
        {%- for block in section.blocks -%}
          <div
            class="nook-real-days__accordion-card"
            data-accordion-item
            {{ block.shopify_attributes }}
          >
            <button
              class="nook-real-days__accordion-header"
              type="button"
              aria-expanded="false"
              data-accordion-trigger
            >
              <span class="nook-real-days__accordion-title-block">
                {%- if block.settings.badge != blank -%}
                  <span class="nook-real-days__accordion-badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
                {%- if block.settings.question != blank -%}
                  <h3 class="nook-real-days__accordion-question">{{ block.settings.question | escape }}</h3>
                {%- endif -%}
              </span>
              <span class="nook-real-days__accordion-icon" aria-hidden="true">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                  <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
            <div class="nook-real-days__accordion-panel" data-accordion-panel>
              <div class="nook-real-days__accordion-content rte">
                {{ block.settings.solution }}
                
                {%- if block.settings.image != blank -%}
                  <div
                    class="nook-real-days__mobile-image"
                    style="--real-image-fit: {{ block.settings.image_fit | default: 'contain' }}; --real-image-position: {{ block.settings.image_position | default: 'center center' }};"
                  >
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600',
                        sizes: '(max-width: 749px) 90vw, 1px'
                    }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const list = document.querySelector('#nook-real-days-{{ section.id }} [data-relief-accordions]');
    if (!list) return;

    const cards = Array.from(list.querySelectorAll('[data-accordion-item]'));
    const mediaPanel = document.querySelector('#nook-real-days-{{ section.id }} .nook-real-days__media-panel');

    cards.forEach((card, idx) => {
      const trigger = card.querySelector('[data-accordion-trigger]');
      const panel = card.querySelector('[data-accordion-panel]');
      
      if (idx === 0) {
        card.setAttribute('open', '');
        trigger.setAttribute('aria-expanded', 'true');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }

      trigger.addEventListener('click', () => {
        const isOpen = card.hasAttribute('open');

        cards.forEach((c) => {
          if (c !== card) {
            c.removeAttribute('open');
            c.querySelector('[data-accordion-trigger]').setAttribute('aria-expanded', 'false');
            c.querySelector('[data-accordion-panel]').style.maxHeight = null;
          }
        });

        if (isOpen) {
          card.removeAttribute('open');
          trigger.setAttribute('aria-expanded', 'false');
          panel.style.maxHeight = null;
        } else {
          card.setAttribute('open', '');
          trigger.setAttribute('aria-expanded', 'true');
          panel.style.maxHeight = panel.scrollHeight + 'px';

          // Update active image in desktop media panel
          if (mediaPanel) {
            const images = mediaPanel.querySelectorAll('.nook-real-days__image-wrapper');
            images.forEach((img, i) => {
              if (i === idx) {
                img.classList.add('active');
              } else {
                img.classList.remove('active');
              }
            });
          }
        }
      });
    });

    window.addEventListener('resize', () => {
      cards.forEach((card) => {
        if (card.hasAttribute('open')) {
          const panel = card.querySelector('[data-accordion-panel]');
          panel.style.maxHeight = panel.scrollHeight + 'px';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product real days",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#157A5B"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Anatomical Relief"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Relief for sensitive feet."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Engineered with medical-grade zoning to alleviate daily pressure, soothe nerve sensitivity, and support the plantar fascia ligament.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "relief_point",
      "name": "Relief Point Accordion",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Condition Badge",
          "default": "Plantar Fasciitis"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Symptom / Question",
          "default": "Morning heel pain?"
        },
        {
          "type": "richtext",
          "id": "solution",
          "label": "Solution explanation",
          "default": "<p>Our 3D knit arch band provides targeted upward compression, stabilizing the plantar fascia ligament and preventing micro-tears during your first steps.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Condition Image"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image display",
          "options": [
            {
              "value": "contain",
              "label": "Fit entire image (recommended)"
            },
            {
              "value": "cover",
              "label": "Fill frame (may crop)"
            }
          ],
          "default": "contain"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "info": "Most useful when Image display is set to Fill frame.",
          "options": [
            {
              "value": "center center",
              "label": "Center"
            },
            {
              "value": "center top",
              "label": "Top"
            },
            {
              "value": "center bottom",
              "label": "Bottom"
            },
            {
              "value": "left center",
              "label": "Left"
            },
            {
              "value": "right center",
              "label": "Right"
            }
          ],
          "default": "center center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product real days",
      "blocks": [
        {
          "type": "relief_point",
          "settings": {
            "badge": "Plantar Fasciitis",
            "question": "Morning heel pain?",
            "solution": "<p>Our 3D knit arch band provides targeted upward compression, stabilizing the plantar fascia ligament and preventing micro-tears during your first steps.</p>"
          }
        },
        {
          "type": "relief_point",
          "settings": {
            "badge": "Neuropathy & Circulation",
            "question": "Numbness or tingling?",
            "solution": "<p>A relaxed, non-binding ankle cuff allows blood flow to circulate freely, while a completely seamless toe prevents irritation on hyper-sensitive nerves.</p>"
          }
        },
        {
          "type": "relief_point",
          "settings": {
            "badge": "Swelling & Fatigue",
            "question": "Aching arches & swelling?",
            "solution": "<p>Full-wrap compression reduces fluid pooling and swelling, while deep heel padding absorbs impact from standing on hard tile or concrete floors.</p>"
          }
        }
      ]
    }
  ]
}
