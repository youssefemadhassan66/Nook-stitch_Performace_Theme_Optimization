      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"elegant-reviews\">\n  <style>\n    .elegant-reviews { background:#fff; padding:60px 0; font-family:Helvetica,Arial,sans-serif; color:#1f2937; }\n    .elegant-container { max-width:1100px; margin:0 auto; padding:0 20px; }\n    .elegant-header { text-align:center; margin-bottom:40px; }\n    .elegant-header h2 { font-size:32px; margin-bottom:8px; font-weight:700; color:#111827; }\n    .elegant-header p { font-size:16px; color:#6b7280; margin:0; }\n    .elegant-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:24px; }\n    .elegant-card { background:#f9fafb; border-radius:16px; padding:24px; box-shadow:0 4px 20px rgba(0,0,0,0.05); display:none; flex-direction:column; cursor:default; }\n    .elegant-top { display:flex; align-items:center; margin-bottom:12px; }\n    .elegant-avatar { width:48px; height:48px; border-radius:50%; background:#d1d5db; display:flex; align-items:center; justify-content:center; font-weight:700; color:#111827; margin-right:14px; font-size:18px; }\n    .elegant-name { font-weight:600; margin:0; font-size:16px; color:#111827; }\n    .elegant-verified { font-size:13px; color:#6b7280; margin:0; }\n    .elegant-stars { display:flex; gap:4px; margin-bottom:12px; }\n    .elegant-star-filled { fill:#111827; }\n    .elegant-star-empty { fill:#E5E7EB; }\n    .elegant-text { color:#1f2937; font-size:15px; line-height:1.5; margin-top:8px; }\n    .elegant-image { width:100%; border-radius:12px; margin-bottom:12px; object-fit:cover; max-height:200px; cursor:pointer; }\n    .elegant-lightbox { position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); display:none; align-items:center; justify-content:center; z-index:9999; }\n    .elegant-lightbox img { max-width:90%; max-height:90%; border-radius:12px; }\n    .loadmore-wrap { text-align:center; margin-top:30px; }\n    .loadmore-btn { background:#111827; color:#fff; padding:12px 22px; border:none; border-radius:8px; cursor:pointer; font-weight:600; }\n    .loadmore-btn:hover { background:#374151; }\n  </style>\n\n  <div class=\"elegant-container\">\n    <div class=\"elegant-header\">\n      <h2>Customer Reviews</h2>\n      <p>Rated <strong>4.8/5</strong> by 1,356 customers</p>\n    </div>\n\n    {% assign reviews = \"Sarah Johnson|5|These socks are incredibly comfortable.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/504ad598-2078-4056-b172-3142dddedd06.jpg?v=1764942568,James Smith|5|Excellent quality and very supportive.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/5b74d3c6-f570-413b-8001-b998ac071fde.jpg?v=1764942568,Emily Brown|4|Breathable and soft.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/3c16a6e2-732f-4196-9bcb-68b2f5298475.jpg?v=1764942568,Daniel Wilson|5|Perfect fit and the ankle padding stops shoes from rubbing.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/47a416b8-7ae6-426d-8632-15df968e4fbf.jpg?v=1764942568,Olivia Davis|5|I have plantar fasciitis and these socks make walking easier.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/d9af9950-1ff2-49f2-ba20-d4e8d37aa1b7.jpg?v=1764942569,Michael Taylor|4|The grip on the bottom is very handy.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/c1ff88ad-2785-42d0-9f0d-093eec5a52b3.jpg?v=1764942569,Emma Clark|5|Feet feel cushioned all day long.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/c94c77c2-f175-4e31-a32d-0bb8bfd76653.jpg?v=1764942569,Robert Lee|5|Great for morning runs.|https://cdn.shopify.com/s/files/1/0904/2676/9783/files/IMG_9054.png?v=1764942574\" | split: \",\" %}\n\n    <div class=\"elegant-grid\">\n      {% for r in reviews %}\n        {% assign parts = r | split:\"|\" %}\n        {% assign name = parts[0] | default: \"Anonymous\" %}\n        {% assign rating = parts[1] %}\n        {% if rating == blank %}{% assign rating = 0 %}{% endif %}\n        {% assign rating = rating | plus:0 %}\n        {% assign text = parts[2] | default: \"No review text.\" %}\n        {% assign image = parts[3] | default: \"\" %}\n        <article class=\"elegant-card\">\n          {% if image != blank %}\n            <img src=\"{{ image }}\" class=\"elegant-image\">\n          {% endif %}\n          <div class=\"elegant-top\">\n            <div class=\"elegant-avatar\">{{ name | slice:0,1 }}</div>\n            <div>\n              <p class=\"elegant-name\">{{ name }}</p>\n              <p class=\"elegant-verified\">Verified Buyer</p>\n            </div>\n          </div>\n          <div class=\"elegant-stars\">\n            {% for i in (1..5) %}\n              {% if i <= rating %}\n                <svg class=\"elegant-star-filled\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% else %}\n                <svg class=\"elegant-star-empty\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.184c.969 0 1.371 1.24.588 1.81l-3.39 2.463a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.39-2.463a1 1 0 00-1.176 0l-3.39 2.463c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.04 9.401c-.783-.57-.38-1.81.588-1.81h4.184a1 1 0 00.95-.69l1.287-3.974z\"/></svg>\n              {% endif %}\n            {% endfor %}\n          </div>\n          <p class=\"elegant-text\">{{ text }}</p>\n        </article>\n      {% endfor %}\n    </div>\n\n    <div class=\"loadmore-wrap\">\n      <button class=\"loadmore-btn\" id=\"loadmore-btn\">Load More Reviews</button>\n    </div>\n  </div>\n\n  <div class=\"elegant-lightbox\" id=\"elegant-lightbox\">\n    <img src=\"\" id=\"elegant-lightbox-img\">\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function(){\n      var cards = document.querySelectorAll(\".elegant-card\");\n      var btn = document.getElementById(\"loadmore-btn\");\n      var perPage = 4; \n      var shown = 0;\n\n      function showMore(){\n        for(var i=shown;i<shown+perPage && i<cards.length;i++){\n          cards[i].style.display=\"flex\";\n        }\n        shown += perPage;\n        if(shown>=cards.length){ btn.style.display=\"none\"; }\n      }\n      showMore();\n      btn.addEventListener(\"click\", showMore);\n\n      var lightbox = document.getElementById(\"elegant-lightbox\");\n      var lightboxImg = document.getElementById(\"elegant-lightbox-img\");\n      document.querySelectorAll(\".elegant-image\").forEach(function(img){\n        img.addEventListener(\"click\", function(){\n          lightbox.style.display=\"flex\";\n          lightboxImg.src=this.src;\n        });\n      });\n      lightbox.addEventListener(\"click\", function(){ lightbox.style.display=\"none\"; });\n    });\n  </script>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
